---
import CartSidebar from "../components/CartSidebar";
import { i18n } from "@wix/essentials";
import type { seoTags as seoTagsNs } from "@wix/seo";

type Tag = seoTagsNs.Tag;

interface Props {
  title?: string;
  description?: string;
  seoTags?: Tag[];
}

const t = i18n.getTranslationFunction();
const locale = i18n.getLocale();
const lang = i18n.getLanguage();
const dir = ["he", "ar"].includes(lang) ? "rtl" : "ltr";
const {
  title = t("home.title"),
  description = t("home.subtitle"),
  seoTags = [],
} = Astro.props;

// The floating cart affordance only makes sense where there's a cart to
// open — the Store catalog and the Restaurant online-order flow. Everywhere
// else (blog, bookings, cinema, ...) it just clutters the corner.
const path = Astro.url.pathname;
const showCart =
  path === "/store" ||
  path.startsWith("/store/") ||
  path === "/restaurant/order" ||
  path.startsWith("/restaurant/order/");

const activeSeoTags = seoTags.filter((tag) => !tag.disabled && tag.type);
const hasSeoTitle = activeSeoTags.some((tag) => tag.type === "title");
const hasSeoDescription = activeSeoTags.some(
  (tag) => tag.type === "meta" && tag.props?.name === "description",
);

function renderSeoTag(tag: Tag): string {
  const attrs = Object.entries(tag.props || {})
    .map(([k, v]) => `${k}="${String(v).replace(/"/g, "&quot;")}"`)
    .join(" ");
  const attrStr = attrs ? ` ${attrs}` : "";
  if (tag.children)
    return `<${tag.type}${attrStr}>${tag.children}</${tag.type}>`;
  return `<${tag.type}${attrStr} />`;
}
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {!hasSeoDescription && <meta name="description" content={description} />}
    {!hasSeoTitle && <title>{title}</title>}
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Black+Ops+One&family=Bangers&family=Inter:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    {activeSeoTags.map((tag) => <Fragment set:html={renderSeoTag(tag)} />)}
  </head>
  <body>
    <slot />
    {showCart && <CartSidebar client:load />}
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    /* COLOR tokens */
    --bg-primary: #0a0a0a;
    --bg-card: #141414;
    --bg-card-hover: #1a1a1a;
    --bg-elevated: #0f0f0f;
    --accent: #ff6600;
    --accent-yellow: #ffcc00;
    --accent-glow: rgba(255, 102, 0, 0.3);
    --accent-glow-soft: rgba(255, 102, 0, 0.08);
    --accent-glow-strong: rgba(255, 102, 0, 0.5);
    --text-primary: #e0e0e0;
    --text-secondary: #aaa;
    --text-muted: #888;
    --text-dark: #444;
    --text-on-accent: #000;
    --border-card: #222;
    --border-subtle: #1a1a1a;
    --border-strong: #333;
    --danger: #f44336;
    --success: #4caf50;

    /* SHAPE tokens — brand-customisable. The cart sidebar and other shared
     * components read these so a site's "shape language" (sharp vs rounded,
     * glossy vs flat, glow vs hard-shadow) can be set in one place. Defaults
     * preserve the snippet's original look; override per site. */
    --radius-card: 8px; /* cards, large buttons, image thumbs, drawer panels */
    --radius-control: 4px; /* small controls — qty +/-, remove buttons */
    --radius-chip: 6px; /* inline tags, option chips, modifier rows */
    --radius-pill: 20px; /* fully-rounded badges (`.badge` global) */
    --shadow-floating: 0 4px 16px var(--accent-glow); /* cart badge / FAB */

    /* TYPOGRAPHY tokens */
    --font-title: "Black Ops One", cursive;
    --font-heading: "Bangers", cursive;
    --font-body: "Inter", sans-serif;
  }

  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100vh;
    background: var(--bg-primary);
    color: var(--text-primary);
    font-family: var(--font-body);
    line-height: 1.6;
    overflow-x: hidden;
  }

  a {
    color: var(--accent);
    text-decoration: none;
    transition: color 0.2s;
  }

  a:hover {
    color: var(--accent-yellow);
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--accent);
    letter-spacing: 2px;
    margin-bottom: 0.5rem;
    text-shadow:
      2px 2px 0 #000,
      0 0 20px var(--accent-glow);
  }

  .section-subtitle {
    color: var(--text-secondary);
    font-size: 1.1rem;
    margin-bottom: 2.5rem;
  }

  .badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .badge-green {
    background: #ff6600;
    color: #000;
  }

  .badge-blue {
    background: #ffcc00;
    color: #000;
  }

  .badge-purple {
    background: #444;
    color: #e0e0e0;
  }

  .badge-gold {
    background: #ffcc00;
    color: #000;
  }

  .badge-pink {
    background: #cc0000;
    color: #fff;
  }

  img {
    max-width: 100%;
  }

  /* Arrow glyphs (→ ← ▶ ▸ etc.) don't auto-mirror in RTL via CSS `direction`
	 * — browsers only bidi-mirror brackets/parens, not arrows. Wrap any
	 * directional glyph in `<span class="rtl-flip">` (or `<i>` / `<b>` /
	 * whatever) and it will flip horizontally in RTL pages while staying as
	 * authored in LTR pages. Prefer this over baking arrows into translation
	 * strings — the arrow becomes a decorative concern separate from copy. */
  .rtl-flip {
    display: inline-block;
  }
  [dir="rtl"] .rtl-flip {
    transform: scaleX(-1);
  }

  /* CartSidebar styles — theme via the COLOR + SHAPE tokens in :root above.
   * If a site's shape language genuinely doesn't fit the token set (e.g. wants
   * a glassy/blurred panel, hard-edged industrial look, or different layout
   * geometry), this whole block is a legitimate `frontend-design` rewrite
   * target — but the React component in CartSidebar.tsx stays. See SKILL.md
   * cross-cutting rule 13. */
  .cs-badge {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 90;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--text-on-accent);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-floating);
    transition: transform 0.2s;
  }
  .cs-badge:hover {
    transform: scale(1.05);
  }
  .cs-count {
    position: absolute;
    top: -4px;
    right: -4px;
    background: var(--accent-yellow);
    color: var(--text-on-accent);
    font-size: 0.7rem;
    font-weight: 800;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cs-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    z-index: 99;
  }
  .cs-panel {
    position: fixed;
    top: 0;
    right: -420px;
    width: 400px;
    max-width: 90vw;
    height: 100vh;
    background: var(--bg-elevated);
    border-left: 1px solid var(--border-card);
    z-index: 100;
    display: flex;
    flex-direction: column;
    transition: right 0.3s ease;
  }
  .cs-panel-open {
    right: 0;
  }
  .cs-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px;
    border-bottom: 1px solid var(--border-card);
  }
  .cs-title {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    color: var(--accent);
    letter-spacing: 2px;
  }
  .cs-close {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 1.8rem;
    cursor: pointer;
    padding: 0;
    line-height: 1;
  }
  .cs-close:hover {
    color: var(--accent);
  }
  .cs-empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: var(--text-muted);
  }
  .cs-empty a {
    color: var(--accent);
    font-family: var(--font-heading);
    letter-spacing: 1px;
    text-decoration: none;
  }
  .cs-items {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .cs-item {
    display: flex;
    gap: 12px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border-subtle);
  }
  .cs-item-clickable {
    cursor: pointer;
    border-radius: var(--radius-card);
    padding: 8px;
    margin: -8px -8px calc(16px - 8px);
    transition: background 0.15s;
  }
  .cs-item-clickable:hover {
    background: var(--accent-glow-soft);
  }
  .cs-item-img {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--bg-card-hover);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cs-item-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cs-item-placeholder {
    font-size: 2rem;
  }
  .cs-item-details {
    flex: 1;
    min-width: 0;
  }
  .cs-item-name {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    color: var(--text-primary);
    letter-spacing: 0.5px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cs-item-options {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 2px;
  }
  .cs-item-option-tags {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 6px;
  }
  .cs-item-option-tag {
    font-size: 0.7rem;
    color: var(--accent);
    background: var(--accent-glow-soft);
    padding: 3px 8px;
    border-radius: var(--radius-chip);
    border: 1px solid var(--accent-glow);
    align-self: flex-start;
  }
  .cs-item-mods {
    margin-top: 6px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .cs-mod-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .cs-mod-group-name {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-secondary);
  }
  .cs-mod-row {
    font-size: 0.72rem;
    color: var(--text-muted);
    padding-left: 10px;
  }
  .cs-item-price {
    font-size: 0.85rem;
    color: var(--accent-yellow);
    font-weight: 700;
    margin-top: 4px;
  }
  .cs-item-qty {
    display: flex;
    align-items: center;
    gap: 0;
    margin-top: 6px;
  }
  .cs-qty-btn {
    width: 26px;
    height: 26px;
    background: var(--bg-card-hover);
    border: 1px solid var(--border-strong);
    color: var(--text-secondary);
    font-size: 0.9rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cs-qty-btn:first-child {
    border-radius: var(--radius-control) 0 0 var(--radius-control);
  }
  .cs-qty-btn:last-child {
    border-radius: 0 var(--radius-control) var(--radius-control) 0;
  }
  .cs-qty-btn:hover:not(:disabled) {
    background: var(--bg-card);
    color: var(--accent);
  }
  .cs-qty-btn:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .cs-qty-val {
    width: 32px;
    height: 26px;
    line-height: 26px;
    text-align: center;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-primary);
    background: var(--bg-card);
    border-top: 1px solid var(--border-strong);
    border-bottom: 1px solid var(--border-strong);
  }
  .cs-remove {
    margin-left: 8px;
    width: 26px;
    height: 26px;
    background: none;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-control);
    color: var(--text-muted);
    font-size: 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cs-remove:hover:not(:disabled) {
    color: var(--danger);
    border-color: var(--danger);
  }
  .cs-footer {
    padding: 16px 20px;
    border-top: 1px solid var(--border-card);
  }
  .cs-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 6px;
  }
  .cs-discount {
    color: var(--success);
  }
  .cs-total {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 16px;
    padding-top: 8px;
    border-top: 1px solid var(--border-card);
  }
  .cs-view-cart {
    display: block;
    text-align: center;
    padding: 10px;
    margin-bottom: 10px;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    letter-spacing: 1.5px;
    color: var(--text-secondary);
    text-decoration: none;
    border: 1px solid var(--border-card);
    border-radius: var(--radius-card);
    transition: all 0.2s;
  }
  .cs-view-cart:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .cs-checkout-btn {
    width: 100%;
    padding: 14px;
    background: var(--accent-yellow);
    color: var(--text-on-accent);
    border: none;
    border-radius: var(--radius-card);
    font-family: var(--font-heading);
    font-size: 1.1rem;
    letter-spacing: 2px;
    cursor: pointer;
    transition: background 0.2s;
  }
  .cs-checkout-btn:hover:not(:disabled) {
    filter: brightness(1.08);
  }
  .cs-checkout-btn:disabled {
    opacity: 0.5;
    cursor: default;
  }
</style>
