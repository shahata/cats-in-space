---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import RichContentViewer from '../../components/RichContentViewer';
import { posts, tags as tagsApi } from '@wix/blog';
import { members } from '@wix/members';

const { slug } = Astro.params;
const result = await posts.getPostBySlug(slug!, { fieldsets: ['RICH_CONTENT', 'URL', 'METRICS', 'CONTACT_ID'] });
const post = result.post;

if (!post) return Astro.redirect('/blog');

// Fetch writer info
let writer: any = null;
if (post.memberId) {
	try {
		const m = await members.getMember(post.memberId, { fieldsets: ['FULL'] });
		writer = m.member;
	} catch {}
}

// Fetch tags
const tagsResult = await tagsApi.queryTags({});
const tagsMap = new Map((tagsResult.tags || []).map((t: any) => [t._id, t]));
const postTags = (post.tagIds || []).map((id: string) => tagsMap.get(id)).filter(Boolean);

function formatDate(dateStr: string | undefined) {
	if (!dateStr) return '';
	return new Date(dateStr).toLocaleDateString('en-US', {
		year: 'numeric', month: 'long', day: 'numeric'
	});
}

const writerName = writer?.profile?.nickname || writer?.contact?.firstName || 'Anonymous Cat';
const writerTitle = writer?.profile?.title || '';
---

<Layout title={`${post.title} - Ship's Log`}>
	<Nav />
	<article class="blog-post">
		<div class="container">
			<a href="/blog" class="back-link">&larr; Back to Ship's Log</a>

			<header class="post-header">
				<div class="post-meta-row">
					<div class="writer-info">
						<span class="writer-name">{writerName}</span>
						{writerTitle && <span class="writer-title">{writerTitle}</span>}
					</div>
					<span class="post-date">{formatDate(post.firstPublishedDate)}</span>
				</div>
				<h1>{post.title}</h1>
				{postTags.length > 0 && (
					<div class="post-tags">
						{postTags.map((tag: any) => (
							<span class="tag">{tag.label}</span>
						))}
					</div>
				)}
			</header>

			<div class="post-content">
				<RichContentViewer content={post.richContent} client:load />
			</div>

			<div class="post-engagement">
				<div class="engagement-stats">
					<div class="engagement-item">
						<span class="engagement-num">{post.metrics?.views ?? 0}</span>
						<span class="engagement-label">Views</span>
					</div>
					<div class="engagement-item">
						<span class="engagement-num">{post.metrics?.likes ?? 0}</span>
						<span class="engagement-label">Likes</span>
					</div>
					<div class="engagement-item">
						<span class="engagement-num">{post.metrics?.comments ?? 0}</span>
						<span class="engagement-label">Comments</span>
					</div>
				</div>
			</div>

			<div class="writer-card">
				<div class="writer-card-info">
					<span class="writer-card-label">Written by</span>
					<span class="writer-card-name">{writerName}</span>
					{writerTitle && <span class="writer-card-title">{writerTitle}</span>}
				</div>
			</div>

			<footer class="post-footer">
				<a href="/blog" class="btn btn-outline">&larr; More Transmissions</a>
			</footer>
		</div>
	</article>
	<Footer />
</Layout>

<style>
	.blog-post {
		padding: 40px 0 80px;
	}

	.back-link {
		display: inline-block;
		font-family: var(--font-heading);
		color: var(--text-muted);
		font-size: 0.9rem;
		letter-spacing: 1px;
		margin-bottom: 30px;
		transition: color 0.2s;
	}

	.back-link:hover {
		color: var(--accent);
	}

	.post-header {
		margin-bottom: 40px;
		padding-bottom: 30px;
		border-bottom: 1px solid var(--border-card);
	}

	.post-meta-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 16px;
		flex-wrap: wrap;
		gap: 12px;
	}

	.writer-info {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.writer-name {
		font-family: var(--font-heading);
		font-size: 1rem;
		color: var(--accent-yellow);
		letter-spacing: 1px;
	}

	.writer-title {
		font-size: 0.8rem;
		color: var(--text-muted);
		font-style: italic;
	}

	.post-date {
		font-family: var(--font-title);
		font-size: 0.8rem;
		color: var(--accent);
		letter-spacing: 1px;
	}

	h1 {
		font-family: var(--font-heading);
		font-size: clamp(1.8rem, 4vw, 2.8rem);
		color: var(--accent-yellow);
		letter-spacing: 2px;
		line-height: 1.2;
		text-shadow: 2px 2px 0 #000, 0 0 20px var(--accent-glow);
		margin-bottom: 16px;
	}

	.post-tags {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
	}

	.tag {
		display: inline-block;
		padding: 4px 14px;
		background: rgba(255, 102, 0, 0.1);
		border: 1px solid rgba(255, 102, 0, 0.2);
		border-radius: 14px;
		font-size: 0.75rem;
		color: var(--accent);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.post-content {
		max-width: 750px;
		font-size: 1.05rem;
		line-height: 1.8;
		color: var(--text-secondary);
	}

	.post-content :global(*) {
		color: inherit;
	}

	.post-content :global(span),
	.post-content :global(div),
	.post-content :global(p) {
		color: var(--text-secondary) !important;
	}

	.post-content :global(h2),
	.post-content :global(h2 *) {
		font-family: var(--font-heading);
		font-size: 1.6rem;
		color: var(--accent) !important;
		letter-spacing: 1px;
		margin: 40px 0 16px;
		text-shadow: 0 0 10px var(--accent-glow);
	}

	.post-content :global(h3),
	.post-content :global(h3 *) {
		font-family: var(--font-heading);
		font-size: 1.3rem;
		color: var(--accent-yellow) !important;
		letter-spacing: 1px;
		margin: 30px 0 12px;
	}

	.post-content :global(p) {
		margin-bottom: 18px;
	}

	.post-content :global(ul),
	.post-content :global(ol) {
		margin: 16px 0 24px 24px;
	}

	.post-content :global(li) {
		margin-bottom: 10px;
		padding-left: 8px;
		color: var(--text-secondary) !important;
	}

	.post-content :global(li::marker) {
		color: var(--accent);
	}

	.post-content :global(blockquote) {
		border-left: 3px solid var(--accent);
		padding: 16px 24px;
		margin: 24px 0;
		background: rgba(255, 102, 0, 0.05);
		border-radius: 0 12px 12px 0;
		font-style: italic;
		color: var(--text-primary) !important;
	}

	.post-content :global(blockquote *) {
		color: var(--text-primary) !important;
	}

	.post-content :global(img) {
		max-width: 100%;
		border-radius: 12px;
		margin: 24px 0;
	}

	.post-content :global(strong) {
		color: var(--text-primary) !important;
	}

	/* Engagement Stats */
	.post-engagement {
		margin-top: 40px;
		padding: 24px 0;
		border-top: 1px solid var(--border-card);
		border-bottom: 1px solid var(--border-card);
	}

	.engagement-stats {
		display: flex;
		gap: 40px;
	}

	.engagement-item {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.engagement-num {
		font-family: var(--font-title);
		font-size: 1.5rem;
		color: var(--accent);
		text-shadow: 0 0 10px var(--accent-glow);
	}

	.engagement-label {
		font-size: 0.75rem;
		color: var(--text-muted);
		text-transform: uppercase;
		letter-spacing: 1px;
		margin-top: 2px;
	}

	/* Writer Card */
	.writer-card {
		margin-top: 30px;
		padding: 20px 24px;
		background: var(--bg-card);
		border: 1px solid var(--border-card);
		border-radius: 12px;
		display: flex;
		align-items: center;
		gap: 16px;
		max-width: 400px;
	}

	.writer-card-label {
		font-size: 0.7rem;
		color: var(--text-muted);
		text-transform: uppercase;
		letter-spacing: 1px;
		display: block;
		margin-bottom: 4px;
	}

	.writer-card-name {
		font-family: var(--font-heading);
		font-size: 1.2rem;
		color: var(--accent-yellow);
		letter-spacing: 1px;
		display: block;
	}

	.writer-card-title {
		font-size: 0.85rem;
		color: var(--text-secondary);
		font-style: italic;
		display: block;
		margin-top: 2px;
	}

	.post-footer {
		margin-top: 40px;
		padding-top: 30px;
		border-top: 1px solid var(--border-card);
	}

	.btn-outline {
		display: inline-block;
		padding: 12px 32px;
		background: transparent;
		color: var(--accent);
		font-family: var(--font-heading);
		font-size: 1.1rem;
		letter-spacing: 2px;
		border-radius: 8px;
		border: 2px solid var(--accent);
		transition: all 0.3s;
	}

	.btn-outline:hover {
		background: var(--accent);
		color: #000;
		transform: translateY(-2px);
		box-shadow: 0 0 20px var(--accent-glow);
	}

	@media (max-width: 768px) {
		.engagement-stats {
			gap: 24px;
		}
	}
</style>
