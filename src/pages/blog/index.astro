---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { posts } from '@wix/blog';
import { getImageUrl } from '../../utils/image';

const result = await posts.listPosts({ fieldsets: ['URL', 'RICH_CONTENT'] });
const blogPosts = result.posts || [];

function formatDate(dateStr: string | undefined) {
	if (!dateStr) return '';
	return new Date(dateStr).toLocaleDateString('en-US', {
		year: 'numeric', month: 'long', day: 'numeric'
	});
}

function getCoverImage(post: any): string | null {
	if (!post.coverMedia?.image) return null;
	const img = post.coverMedia.image;
	if (img.url) return img.url;
	if (img.id) return `https://static.wixstatic.com/media/${img.id}/v1/fill/w_800,h_500,al_c,q_80/${img.id}`;
	return getImageUrl(img.id);
}

function getExcerpt(post: any): string {
	if (post.excerpt) return post.excerpt.slice(0, 200);
	// Try to extract text from rich content
	const nodes = post.richContent?.nodes || [];
	for (const node of nodes) {
		if (node.type === 'PARAGRAPH' && node.nodes?.[0]?.textData?.text) {
			return node.nodes[0].textData.text.slice(0, 200);
		}
	}
	return '';
}
---

<Layout title="Ship's Log - Cats In Space">
	<Nav />
	<section class="page-header">
		<div class="container">
			<h1 class="section-title">Ship's Log</h1>
			<p class="section-subtitle">Dispatches, reports, and tall tales from the feline frontier</p>
		</div>
	</section>

	<section class="content">
		<div class="container">
			{blogPosts.length === 0 ? (
				<p class="empty-state">No transmissions received yet. Check back soon.</p>
			) : (
				<div class="blog-grid">
					{blogPosts.map((post, i) => (
						<a href={`/blog/${post.slug}`} class:list={['blog-card', { featured: i === 0 }]}>
							{getCoverImage(post) && (
								<img src={getCoverImage(post)!} alt={post.title} class="blog-cover" />
							)}
							<div class="blog-card-body">
								<div class="blog-meta">
									<span class="blog-date">{formatDate(post.firstPublishedDate)}</span>
								</div>
								<h2>{post.title}</h2>
								<p class="blog-excerpt">{getExcerpt(post)}...</p>
								<span class="read-more">Read Transmission &rarr;</span>
							</div>
						</a>
					))}
				</div>
			)}
		</div>
	</section>
	<Footer />
</Layout>

<style>
	.page-header {
		padding: 60px 0 40px;
	}

	.content {
		padding-bottom: 60px;
	}

	.empty-state {
		text-align: center;
		color: var(--text-muted);
		font-size: 1.2rem;
		padding: 80px 0;
	}

	.blog-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
		gap: 24px;
	}

	.blog-card {
		background: var(--bg-card);
		border: 1px solid var(--border-card);
		border-radius: 16px;
		overflow: hidden;
		transition: all 0.3s;
		color: var(--text-primary);
		display: flex;
		flex-direction: column;
	}

	.blog-card:hover {
		transform: translateY(-4px);
		border-color: var(--accent);
		box-shadow: 0 0 40px var(--accent-glow);
		color: var(--text-primary);
	}

	.blog-card.featured {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: 1fr 1fr;
	}

	.blog-cover {
		width: 100%;
		height: 220px;
		object-fit: cover;
	}

	.blog-card.featured .blog-cover {
		height: 100%;
		min-height: 300px;
	}

	.blog-card-body {
		padding: 24px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		flex: 1;
	}

	.blog-meta {
		margin-bottom: 8px;
	}

	.blog-date {
		font-family: var(--font-title);
		font-size: 0.75rem;
		color: var(--accent);
		letter-spacing: 1px;
	}

	h2 {
		font-family: var(--font-heading);
		font-size: 1.4rem;
		color: var(--accent-yellow);
		letter-spacing: 1px;
		margin-bottom: 10px;
		line-height: 1.3;
	}

	.blog-card.featured h2 {
		font-size: 1.8rem;
	}

	.blog-excerpt {
		color: var(--text-secondary);
		font-size: 0.9rem;
		line-height: 1.7;
		margin-bottom: 16px;
		flex: 1;
	}

	.read-more {
		font-family: var(--font-heading);
		color: var(--accent);
		font-size: 0.95rem;
		letter-spacing: 1px;
		transition: color 0.2s;
	}

	.blog-card:hover .read-more {
		color: var(--accent-yellow);
	}

	@media (max-width: 768px) {
		.blog-grid {
			grid-template-columns: 1fr;
		}

		.blog-card.featured {
			grid-template-columns: 1fr;
		}

		.blog-card.featured .blog-cover {
			height: 220px;
			min-height: auto;
		}
	}
</style>
