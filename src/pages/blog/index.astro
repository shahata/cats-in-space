---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { posts, tags as tagsApi } from '@wix/blog';
import { comments as commentsApi } from '@wix/comments';
import { members } from '@wix/members';
import { getImageUrl } from '../../utils/image';

const BLOG_APP_ID = '14bcded7-0066-7c35-14d7-466cb3f09103';

// Use queryPosts instead of listPosts — queryPosts returns real metrics, listPosts returns zeros
const queryResult = await posts.queryPosts({ fieldsets: ['URL', 'RICH_CONTENT', 'METRICS', 'CONTACT_ID', 'REFERENCE_ID'] }).find();
const blogPosts = queryResult.items || [];

// Count comments per post via Comments API (blog metrics.comments doesn't reflect Wix Comments)
const commentCountMap = new Map<string, number>();
await Promise.all(blogPosts.map(async (post: any) => {
	if (post.referenceId) {
		try {
			const c = await commentsApi.listCommentsByResource(BLOG_APP_ID, {
				contextId: post.referenceId,
				resourceId: post.referenceId,
				cursorPaging: { limit: 100, repliesLimit: 50 },
			});
			const replyCount = Object.values(c.commentReplies || {}).reduce(
				(sum: number, r: any) => sum + (r.replies?.length ?? 0), 0
			);
			commentCountMap.set(post._id!, (c.comments?.length ?? 0) + replyCount);
		} catch {}
	}
}));

// Fetch all tags
const tagsResult = await tagsApi.queryTags({});
const tagsMap = new Map((tagsResult.tags || []).map((t: any) => [t._id, t]));

// Fetch all members for writer info
const memberIds = [...new Set(blogPosts.map((p: any) => p.memberId).filter(Boolean))];
const membersMap = new Map<string, any>();
for (const id of memberIds) {
	try {
		const m = await members.getMember(id, { fieldsets: ['FULL'] });
		if (m.member) membersMap.set(id, m.member);
	} catch {}
}

function formatDate(dateStr: string | undefined) {
	if (!dateStr) return '';
	return new Date(dateStr).toLocaleDateString('en-US', {
		year: 'numeric', month: 'long', day: 'numeric'
	});
}

function getCoverImage(post: any): string | null {
	if (!post.coverMedia?.image) return null;
	const img = post.coverMedia.image;
	if (img.url) return img.url;
	if (img.id) return `https://static.wixstatic.com/media/${img.id}/v1/fill/w_800,h_500,al_c,q_80/${img.id}`;
	return getImageUrl(img.id);
}

function getExcerpt(post: any): string {
	if (post.excerpt) return post.excerpt.slice(0, 200);
	const nodes = post.richContent?.nodes || [];
	for (const node of nodes) {
		if (node.type === 'PARAGRAPH' && node.nodes?.[0]?.textData?.text) {
			return node.nodes[0].textData.text.slice(0, 200);
		}
	}
	return '';
}

function getMetric(post: any, field: string): number {
	if (field === 'comments') return commentCountMap.get(post._id) ?? 0;
	return post.metrics?.[field] ?? 0;
}

function getWriter(post: any): string {
	const m = membersMap.get(post.memberId);
	return m?.profile?.nickname || m?.contact?.firstName || 'Anonymous Cat';
}

function getWriterTitle(post: any): string {
	const m = membersMap.get(post.memberId);
	return m?.profile?.title || '';
}

function getPostTags(post: any): any[] {
	return (post.tagIds || []).map((id: string) => tagsMap.get(id)).filter(Boolean);
}
---

<Layout title="Ship's Log - Cats In Space">
	<Nav />
	<section class="page-header">
		<div class="container">
			<h1 class="section-title">Ship's Log</h1>
			<p class="section-subtitle">Dispatches, reports, and tall tales from the feline frontier</p>
		</div>
	</section>

	<section class="content">
		<div class="container">
			{blogPosts.length === 0 ? (
				<p class="empty-state">No transmissions received yet. Check back soon.</p>
			) : (
				<div class="blog-grid">
					{blogPosts.map((post, i) => (
						<a href={`/blog/${post.slug}`} class:list={['blog-card', { featured: i === 0 }]}>
							{getCoverImage(post) && (
								<img src={getCoverImage(post)!} alt={post.title} class="blog-cover" />
							)}
							<div class="blog-card-body">
								<div class="blog-meta">
									<span class="blog-writer">{getWriter(post)}</span>
									<span class="meta-sep">&middot;</span>
									<span class="blog-date">{formatDate(post.firstPublishedDate)}</span>
								</div>
								<h2>{post.title}</h2>
								{getPostTags(post).length > 0 && (
									<div class="blog-tags">
										{getPostTags(post).map((tag: any) => (
											<span class="tag">{tag.label}</span>
										))}
									</div>
								)}
								<p class="blog-excerpt">{getExcerpt(post)}...</p>
								<div class="blog-footer">
									<div class="blog-stats">
										<span class="stat" title="Views">{getMetric(post, 'views')} views</span>
										<span class="stat" title="Likes">{getMetric(post, 'likes')} likes</span>
										<span class="stat" title="Comments">{getMetric(post, 'comments')} comments</span>
									</div>
									<span class="read-more">Read Transmission &rarr;</span>
								</div>
							</div>
						</a>
					))}
				</div>
			)}
		</div>
	</section>
	<Footer />
</Layout>

<style>
	.page-header {
		padding: 60px 0 40px;
	}

	.content {
		padding-bottom: 60px;
	}

	.empty-state {
		text-align: center;
		color: var(--text-muted);
		font-size: 1.2rem;
		padding: 80px 0;
	}

	.blog-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
		gap: 24px;
	}

	.blog-card {
		background: var(--bg-card);
		border: 1px solid var(--border-card);
		border-radius: 16px;
		overflow: hidden;
		transition: all 0.3s;
		color: var(--text-primary);
		display: flex;
		flex-direction: column;
	}

	.blog-card:hover {
		transform: translateY(-4px);
		border-color: var(--accent);
		box-shadow: 0 0 40px var(--accent-glow);
		color: var(--text-primary);
	}

	.blog-card.featured {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: 1fr 1fr;
	}

	.blog-cover {
		width: 100%;
		height: 220px;
		object-fit: cover;
	}

	.blog-card.featured .blog-cover {
		height: 100%;
		min-height: 300px;
	}

	.blog-card-body {
		padding: 24px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		flex: 1;
	}

	.blog-meta {
		margin-bottom: 8px;
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.blog-writer {
		font-family: var(--font-heading);
		font-size: 0.85rem;
		color: var(--accent-yellow);
		letter-spacing: 1px;
	}

	.meta-sep {
		color: var(--text-dark);
	}

	.blog-date {
		font-family: var(--font-title);
		font-size: 0.7rem;
		color: var(--accent);
		letter-spacing: 1px;
	}

	.blog-tags {
		display: flex;
		gap: 6px;
		flex-wrap: wrap;
		margin-bottom: 10px;
	}

	.tag {
		display: inline-block;
		padding: 2px 10px;
		background: rgba(255, 102, 0, 0.1);
		border: 1px solid rgba(255, 102, 0, 0.2);
		border-radius: 12px;
		font-size: 0.7rem;
		color: var(--accent);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	h2 {
		font-family: var(--font-heading);
		font-size: 1.4rem;
		color: var(--accent-yellow);
		letter-spacing: 1px;
		margin-bottom: 10px;
		line-height: 1.3;
	}

	.blog-card.featured h2 {
		font-size: 1.8rem;
	}

	.blog-excerpt {
		color: var(--text-secondary);
		font-size: 0.9rem;
		line-height: 1.7;
		margin-bottom: 16px;
		flex: 1;
	}

	.blog-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 10px;
	}

	.blog-stats {
		display: flex;
		gap: 12px;
	}

	.stat {
		font-size: 0.75rem;
		color: var(--text-muted);
		font-family: var(--font-body);
	}

	.read-more {
		font-family: var(--font-heading);
		color: var(--accent);
		font-size: 0.95rem;
		letter-spacing: 1px;
		transition: color 0.2s;
	}

	.blog-card:hover .read-more {
		color: var(--accent-yellow);
	}

	@media (max-width: 768px) {
		.blog-grid {
			grid-template-columns: 1fr;
		}

		.blog-card.featured {
			grid-template-columns: 1fr;
		}

		.blog-card.featured .blog-cover {
			height: 220px;
			min-height: auto;
		}
	}
</style>
