---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PlanCheckout from '../components/PlanCheckout';
import { plans } from '@wix/pricing-plans';

const result = await plans.queryPublicPlans().find();
const allPlans = result.items || [];
---

<Layout title="Pricing Plans - Cats In Space">
	<Nav />
	<section class="page-header">
		<div class="container">
			<h1 class="section-title">Crew Membership Plans</h1>
			<p class="section-subtitle">Choose your rank aboard the SS Scratching Post</p>
		</div>
	</section>

	{Astro.url.searchParams.get('success') === 'true' && (
		<div class="success-banner">
			<div class="container">Welcome aboard, crew member! Your subscription is active.</div>
		</div>
	)}

	<section class="content">
		<div class="container">
			<div class="plans-grid">
				{allPlans.map((plan, i) => {
					const priceValue = plan.pricing?.price?.value || "0";
					const currency = plan.pricing?.price?.currency || "USD";
					const isFree = parseFloat(priceValue) === 0;
					const cycleDuration = plan.pricing?.subscription?.cycleDuration;
					const trialDays = plan.pricing?.freeTrialDays || 0;
					const isMiddle = i === 1;
					const perksList = plan.perks?.values || [];

					return (
						<div class:list={['plan-card', { featured: isMiddle }]}>
							{isMiddle && <div class="featured-badge">Most Popular</div>}
							<h2>{plan.name}</h2>
							<p class="plan-desc">{plan.description}</p>
							<div class="plan-price">
								{isFree ? (
									<span class="price">Free</span>
								) : (
									<>
										<span class="currency">{currency === 'USD' ? '$' : currency}</span>
										<span class="price">{priceValue}</span>
										{cycleDuration && <span class="period">/{cycleDuration.unit?.toLowerCase()}</span>}
									</>
								)}
							</div>
							{trialDays > 0 && (
								<p class="trial-info">{trialDays}-day free trial</p>
							)}
							<ul class="perks">
								{perksList.map((perk: string) => (
									<li>{perk}</li>
								))}
							</ul>
							<PlanCheckout
								planId={plan._id!}
								client:load
							/>
						</div>
					);
				})}
			</div>
		</div>
	</section>
	<Footer />
</Layout>

<style>
	.page-header {
		padding: 60px 0 40px;
		text-align: center;
	}

	.content {
		padding-bottom: 80px;
	}

	.plans-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 24px;
		align-items: start;
	}

	.plan-card {
		background: var(--bg-card);
		border: 1px solid var(--border-card);
		border-radius: 16px;
		padding: 32px;
		position: relative;
		transition: transform 0.3s;
	}

	.plan-card:hover {
		transform: translateY(-4px);
	}

	.plan-card.featured {
		border-color: var(--accent);
		box-shadow: 0 0 40px var(--accent-glow);
	}

	.featured-badge {
		position: absolute;
		top: -12px;
		left: 50%;
		transform: translateX(-50%);
		background: var(--accent);
		color: #000;
		font-family: var(--font-heading);
		font-size: 0.8rem;
		letter-spacing: 1px;
		padding: 4px 16px;
		border-radius: 12px;
	}

	h2 {
		font-family: var(--font-heading);
		font-size: 1.6rem;
		color: var(--accent-yellow);
		letter-spacing: 1px;
		margin-bottom: 8px;
	}

	.plan-desc {
		color: var(--text-muted);
		font-size: 0.85rem;
		margin-bottom: 20px;
		line-height: 1.5;
	}

	.plan-price {
		margin-bottom: 16px;
		display: flex;
		align-items: baseline;
		gap: 2px;
	}

	.currency {
		font-family: var(--font-title);
		font-size: 1.2rem;
		color: var(--accent);
	}

	.price {
		font-family: var(--font-title);
		font-size: 2.5rem;
		color: var(--accent);
		text-shadow: 0 0 15px var(--accent-glow);
	}

	.period {
		font-size: 0.9rem;
		color: var(--text-muted);
	}

	.trial-info {
		font-size: 0.8rem;
		color: var(--accent-yellow);
		margin-bottom: 16px;
		font-style: italic;
	}

	.perks {
		list-style: none;
		padding: 0;
		margin: 0 0 24px;
	}

	.perks li {
		padding: 8px 0;
		border-bottom: 1px solid #1a1a1a;
		font-size: 0.9rem;
		color: var(--text-secondary);
	}

	.perks li::before {
		content: "✓ ";
		color: var(--accent);
		font-weight: bold;
	}

	.success-banner {
		background: rgba(0, 200, 83, 0.15);
		border: 1px solid rgba(0, 200, 83, 0.3);
		color: #00c853;
		text-align: center;
		padding: 16px;
		font-family: var(--font-heading);
		letter-spacing: 1px;
		font-size: 0.9rem;
		margin-bottom: 24px;
	}

	:global(.plan-checkout-btn) {
		width: 100%;
		padding: 12px 24px;
		background: var(--accent);
		color: #000;
		font-family: var(--font-heading);
		font-size: 0.9rem;
		letter-spacing: 1px;
		border: none;
		border-radius: 8px;
		cursor: pointer;
		transition: all 0.2s;
		font-weight: bold;
	}

	:global(.plan-checkout-btn:hover) {
		background: var(--accent-yellow);
		transform: translateY(-1px);
	}

	:global(.plan-checkout-btn:disabled) {
		opacity: 0.6;
		cursor: not-allowed;
		transform: none;
	}

	.featured :global(.plan-checkout-btn) {
		background: var(--accent-yellow);
	}

	@media (max-width: 768px) {
		.plans-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
