---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { i18n } from '@wix/essentials';
import { getRelativeLocaleUrl } from 'wix:astro:i18n';

const t = i18n.getTranslationFunction();

// Deck numbering is a running theme in the ship's flavour text — if more
// facilities get added later, bump these and update the copy.
interface Facility {
	key: 'store' | 'clinic' | 'restaurant' | 'cinema';
	deck: string;
	icon: string;
	href: string;
}

const facilities: Facility[] = [
	{ key: 'store',      deck: 'Deck 2', icon: '🛒', href: '/store' },
	{ key: 'clinic',     deck: 'Deck 3', icon: '🩺', href: '/bookings' },
	{ key: 'restaurant', deck: 'Deck 5', icon: '🍽️', href: '/restaurant' },
	{ key: 'cinema',     deck: 'Deck 7', icon: '🎬', href: '/cinema' },
];
---

<Layout title={`${t('aboard.pageTitle')} - ${t('home.title')}`}>
	<Nav />

	<section class="aboard-hero">
		<div class="hero-glow"></div>
		<div class="container hero-content">
			<h1 class="section-title">{t('aboard.pageTitle')}</h1>
			<p class="section-subtitle">{t('aboard.pageSubtitle')}</p>
			<p class="aboard-copy">{t('aboard.heroCopy')}</p>
		</div>
	</section>

	<section class="aboard-section">
		<div class="container">
			<h2 class="aboard-h2">{t('aboard.facilitiesTitle')}</h2>
			<p class="aboard-h2-sub">{t('aboard.facilitiesSubtitle')}</p>

			<div class="facilities-grid">
				{facilities.map(f => (
					<a href={getRelativeLocaleUrl(f.href)} class="facility-card">
						<div class="facility-icon">{f.icon}</div>
						<div class="facility-deck">{f.deck}</div>
						<h3 class="facility-title">{t(`aboard.${f.key}Title`)}</h3>
						<p class="facility-desc">{t(`aboard.${f.key}Desc`)}</p>
						<span class="facility-cta">{t(`aboard.${f.key}Cta`)} →</span>
					</a>
				))}
			</div>
		</div>
	</section>

	<section class="aboard-section aboard-alt">
		<div class="container split-grid">
			<div class="split-block">
				<div class="split-icon">🔬</div>
				<h2 class="split-title">{t('aboard.researchTitle')}</h2>
				<p class="split-desc">{t('aboard.researchDesc')}</p>
				<a href={getRelativeLocaleUrl('/research')} class="split-cta">{t('aboard.researchCta')} →</a>
			</div>
			<div class="split-block">
				<div class="split-icon">📡</div>
				<h2 class="split-title">{t('aboard.logTitle')}</h2>
				<p class="split-desc">{t('aboard.logDesc')}</p>
				<a href={getRelativeLocaleUrl('/blog')} class="split-cta">{t('aboard.logCta')} →</a>
			</div>
		</div>
	</section>

	<section class="aboard-section plans-cta-section">
		<div class="container">
			<div class="plans-cta">
				<div class="plans-cta-badge">{t('aboard.plansSubtitle')}</div>
				<h2 class="plans-cta-title">{t('aboard.plansTitle')}</h2>
				<p class="plans-cta-desc">{t('aboard.plansDesc')}</p>
				<a href={getRelativeLocaleUrl('/plans')} class="plans-cta-btn">{t('aboard.plansCta')} →</a>
			</div>
		</div>
	</section>

	<Footer />
</Layout>

<style>
	.aboard-hero {
		position: relative;
		padding: 100px 20px 60px;
		text-align: center;
		background: linear-gradient(180deg, #1a0a00 0%, var(--bg-primary) 100%);
		overflow: hidden;
	}
	.hero-glow {
		position: absolute;
		top: -100px;
		left: 50%;
		transform: translateX(-50%);
		width: 600px;
		height: 400px;
		background: radial-gradient(ellipse, rgba(255, 102, 0, 0.15) 0%, transparent 70%);
		pointer-events: none;
	}
	.hero-content { position: relative; z-index: 1; }
	.aboard-copy {
		color: var(--text-secondary);
		font-size: 1.05rem;
		line-height: 1.7;
		max-width: 680px;
		margin: 20px auto 0;
	}

	.aboard-section {
		padding: 60px 20px;
	}
	.aboard-alt {
		background: linear-gradient(180deg, transparent 0%, rgba(255, 102, 0, 0.03) 50%, transparent 100%);
	}
	.aboard-h2 {
		font-family: var(--font-heading);
		color: var(--accent);
		font-size: clamp(1.5rem, 3vw, 2rem);
		letter-spacing: 2px;
		text-shadow: 0 0 20px var(--accent-glow);
	}
	.aboard-h2-sub {
		color: var(--text-muted);
		margin-bottom: 32px;
	}

	.facilities-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 20px;
	}
	.facility-card {
		background: var(--bg-card);
		border: 1px solid var(--border-card);
		border-radius: 14px;
		padding: 24px;
		color: inherit;
		text-decoration: none;
		transition: all 0.2s;
		display: flex; flex-direction: column; gap: 8px;
	}
	.facility-card:hover {
		border-color: var(--accent);
		transform: translateY(-4px);
		box-shadow: 0 12px 40px rgba(255, 102, 0, 0.15);
	}
	.facility-icon { font-size: 2.2rem; line-height: 1; }
	.facility-deck {
		font-family: var(--font-heading);
		font-size: 0.7rem;
		letter-spacing: 2px;
		color: var(--accent-yellow);
	}
	.facility-title {
		font-family: var(--font-heading);
		font-size: 1.15rem;
		letter-spacing: 1.5px;
		color: var(--text-primary);
	}
	.facility-desc {
		color: var(--text-secondary);
		font-size: 0.9rem;
		line-height: 1.55;
	}
	.facility-cta {
		margin-top: auto;
		font-family: var(--font-heading);
		color: var(--accent);
		font-size: 0.85rem;
		letter-spacing: 1px;
	}

	.split-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 24px;
	}
	.split-block {
		background: var(--bg-card);
		border: 1px solid var(--border-card);
		border-radius: 14px;
		padding: 32px;
		display: flex; flex-direction: column; gap: 10px;
	}
	.split-icon { font-size: 2.4rem; }
	.split-title {
		font-family: var(--font-heading);
		color: var(--accent);
		font-size: 1.4rem;
		letter-spacing: 1.5px;
	}
	.split-desc {
		color: var(--text-secondary);
		line-height: 1.6;
	}
	.split-cta {
		font-family: var(--font-heading);
		color: var(--accent);
		letter-spacing: 1px;
		margin-top: 8px;
	}

	.plans-cta-section {
		padding-bottom: 100px;
	}
	.plans-cta {
		background: linear-gradient(135deg, rgba(255, 102, 0, 0.1) 0%, rgba(255, 204, 0, 0.05) 100%);
		border: 1px solid var(--accent);
		border-radius: 16px;
		padding: 44px;
		text-align: center;
		box-shadow: 0 8px 40px rgba(255, 102, 0, 0.1);
	}
	.plans-cta-badge {
		display: inline-block;
		padding: 6px 14px;
		border-radius: 999px;
		background: var(--accent-yellow);
		color: #000;
		font-family: var(--font-heading);
		font-size: 0.7rem;
		letter-spacing: 2px;
	}
	.plans-cta-title {
		font-family: var(--font-title);
		color: var(--accent);
		font-size: clamp(1.8rem, 4vw, 2.6rem);
		letter-spacing: 2px;
		margin-top: 12px;
		text-shadow: 2px 2px 0 #000, 0 0 30px var(--accent-glow);
	}
	.plans-cta-desc {
		color: var(--text-secondary);
		max-width: 600px;
		margin: 16px auto 24px;
		line-height: 1.7;
	}
	.plans-cta-btn {
		display: inline-block;
		padding: 14px 32px;
		background: var(--accent);
		color: #000;
		font-family: var(--font-heading);
		letter-spacing: 2px;
		border-radius: 10px;
		font-size: 1rem;
		transition: all 0.2s;
	}
	.plans-cta-btn:hover {
		background: var(--accent-yellow);
		transform: translateY(-2px);
		box-shadow: 0 6px 24px var(--accent-glow);
	}
</style>
