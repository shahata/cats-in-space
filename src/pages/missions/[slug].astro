---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { items } from '@wix/data';

const { slug } = Astro.params;
const result = await items.query('Missions').eq('slug', slug).find();

if (result.items.length === 0) {
	return Astro.redirect('/missions');
}

const mission = result.items[0]!;

function getStatusBadge(status: string) {
	const map: Record<string, string> = {
		'In Progress': 'badge-blue', 'Launching Soon': 'badge-gold',
		'Planning': 'badge-purple', 'Planned': 'badge-purple', 'Completed': 'badge-green',
	};
	return map[status] || 'badge-blue';
}
---

<Layout title={`${mission.title} - Cats In Space`}>
	<Nav />
	<div class="detail-page">
		<div class="container">
			<a href="/missions" class="back-link">&larr; All Missions</a>

			<div class="mission-hero">
				<div class="mission-icon">
					{mission.status === 'In Progress' ? '🛸' :
					 mission.status === 'Launching Soon' ? '🚀' :
					 mission.status === 'Planning' ? '📋' : '🗺️'}
				</div>
				<h1>{mission.title}</h1>
				<span class={`badge ${getStatusBadge(mission.status)}`}>{mission.status}</span>
			</div>

			<div class="detail-grid">
				<div class="detail-main">
					<h2>Mission Brief</h2>
					<p class="description">{mission.description}</p>

					<div class="log-section">
						<h2>Mission Log</h2>
						<div class="log-card">
							<div class="log-dot"></div>
							<p>{mission.missionLog}</p>
						</div>
					</div>
				</div>

				<div class="detail-sidebar">
					<div class="info-card">
						<h3>Mission Details</h3>
						<div class="info-row">
							<span class="info-label">Destination</span>
							<span class="info-value">{mission.planet}</span>
						</div>
						<div class="info-row">
							<span class="info-label">Crew Size</span>
							<span class="info-value">{mission.crewSize} cats</span>
						</div>
						<div class="info-row">
							<span class="info-label">Launch Date</span>
							<span class="info-value">{mission.launchDate}</span>
						</div>
						<div class="info-row">
							<span class="info-label">Status</span>
							<span class="info-value">{mission.status}</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<Footer />
</Layout>

<style>
	.detail-page { position: relative; z-index: 1; padding: 60px 0 40px; }

	.back-link {
		font-size: 0.85rem;
		color: var(--text-muted);
		display: inline-block;
		margin-bottom: 2rem;
		transition: color 0.2s;
	}
	.back-link:hover { color: var(--accent); }

	.mission-hero {
		text-align: center;
		margin-bottom: 3rem;
	}

	.mission-icon {
		font-size: 3rem;
		margin-bottom: 1rem;
	}

	.mission-hero h1 {
		font-family: var(--font-title);
		font-size: 2.5rem;
		color: var(--accent);
		text-shadow: 2px 2px 0 #000, 0 0 20px var(--accent-glow);
		margin-bottom: 0.75rem;
	}

	.detail-grid {
		display: grid;
		grid-template-columns: 1fr 340px;
		gap: 2rem;
		align-items: start;
	}

	.detail-main h2 {
		font-family: var(--font-heading);
		font-size: 1.3rem;
		color: var(--accent);
		letter-spacing: 1px;
		text-shadow: 2px 2px 0 #000, 0 0 20px var(--accent-glow);
		margin-bottom: 1rem;
	}

	.description {
		color: var(--text-secondary);
		font-size: 1rem;
		line-height: 1.8;
		margin-bottom: 2.5rem;
	}

	.log-card {
		background: var(--bg-card);
		border: 1px solid var(--border-card);
		border-radius: 16px;
		padding: 1.25rem 1.5rem;
		display: flex;
		gap: 1rem;
		align-items: flex-start;
	}

	.log-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 8px var(--accent);
		flex-shrink: 0;
		margin-top: 0.4rem;
	}

	.log-card p {
		color: var(--text-secondary);
		font-size: 0.9rem;
		line-height: 1.7;
		font-family: var(--font-body);
	}

	.info-card {
		background: var(--bg-card);
		border: 1px solid var(--border-card);
		border-radius: 16px;
		padding: 1.5rem;
	}

	.info-card h3 {
		font-family: var(--font-heading);
		font-size: 1rem;
		margin-bottom: 1rem;
		color: var(--accent-yellow);
		letter-spacing: 1px;
	}

	.info-row {
		display: flex;
		justify-content: space-between;
		padding: 0.6rem 0;
		border-bottom: 1px solid var(--border-card);
	}

	.info-label { color: var(--text-muted); font-size: 0.85rem; }
	.info-value { color: var(--accent); font-family: var(--font-title); font-size: 0.8rem; }

	@media (max-width: 768px) {
		.detail-grid { grid-template-columns: 1fr; }
		.mission-hero h1 { font-size: 2rem; }
	}
</style>
