---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { items } from '@wix/data';
import { getImageUrl } from '../../utils/image';
import { i18n } from '@wix/essentials';
const t = i18n.getTranslationFunction();

const result = await items.query('Missions').include('planetRef', 'crew').find();
const missions = result.items;

function getStatusBadge(status: string) {
	const map: Record<string, string> = {
		'In Progress': 'badge-blue', 'Launching Soon': 'badge-gold',
		'Planning': 'badge-purple', 'Planned': 'badge-purple', 'Completed': 'badge-green',
	};
	return map[status] || 'badge-blue';
}

function getStatusIcon(status: string) {
	const map: Record<string, string> = {
		'In Progress': '🛸', 'Launching Soon': '🚀',
		'Planning': '📋', 'Planned': '🗺️', 'Completed': '✅',
	};
	return map[status] || '🛸';
}

const statusOrder = ['In Progress', 'Launching Soon', 'Planned', 'Planning', 'Completed'];
const sorted = [...missions].sort((a, b) =>
	statusOrder.indexOf(a.status) - statusOrder.indexOf(b.status)
);
---

<Layout title={`${t('missions.pageTitle')} - Cats In Space`}>
	<Nav />
	<section class="page-header">
		<div class="container">
			<h1 class="section-title">{t('missions.pageTitle')}</h1>
			<p class="section-subtitle">{t('missions.pageSubtitle')}</p>
		</div>
	</section>

	<section class="content">
		<div class="container">
			<div class="missions-list">
				{sorted.map((mission) => (
					<div class="mission-card" data-href={`/missions/${mission.slug}`} data-status={mission.status}>
						<div class="card-accent" data-status={mission.status}></div>
						<div class="card-inner">
							<div class="card-top">
								<div class="planet-circle">
									{mission.planetRef && getImageUrl(mission.planetRef.image, 100, 100) ? (
										<a href={`/planets/${mission.planetRef.slug}`} class="planet-img-link">
											<img src={getImageUrl(mission.planetRef.image, 100, 100)!} alt={mission.planetRef.title} />
										</a>
									) : (
										<span class="planet-fallback">{getStatusIcon(mission.status)}</span>
									)}
								</div>
								<div class="card-info">
									<div class="title-row">
										<h2>{mission.title}</h2>
										<span class={`badge ${getStatusBadge(mission.status)}`}>{mission.status}</span>
									</div>
									{mission.planetRef && (
										<a href={`/planets/${mission.planetRef.slug}`} class="dest-link">→ {mission.planetRef.title}</a>
									)}
									<p class="mission-desc">{mission.description}</p>
								</div>
							</div>

							<div class="card-bottom">
								{mission.crew && mission.crew.length > 0 && (
									<div class="crew-section">
										<span class="meta-label">{t('missions.crew')}</span>
										<div class="crew-stack">
											{mission.crew.map((cat: any, i: number) => (
												<a
													href={`/crew/${cat.slug}`}
													class="crew-pip"
													style={`z-index: ${10 - i}`}
													title={cat.name}
												>
													{getImageUrl(cat.image, 36, 36) ? (
														<img src={getImageUrl(cat.image, 36, 36)!} alt={cat.name} />
													) : (
														<span class="pip-fallback">🐱</span>
													)}
												</a>
											))}
										</div>
									</div>
								)}
								<div class="launch-section">
									<span class="meta-label">{t('missions.launch')}</span>
									<span class="launch-val">{mission.launchDate}</span>
								</div>
							</div>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>
	<Footer />
</Layout>

<script is:inline>
	document.addEventListener('click', function(e) {
		var target = e.target;
		if (target.closest('a')) return;
		var card = target.closest('.mission-card[data-href]');
		if (card) window.location.href = card.dataset.href;
	});
</script>

<style>
	.page-header {
		padding: 60px 0 40px;
		position: relative;
		z-index: 1;
	}

	.content { position: relative; z-index: 1; padding-bottom: 40px; }

	.missions-list {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		max-width: 800px;
		margin: 0 auto;
	}

	.mission-card {
		display: flex;
		background: var(--bg-card);
		border: 1px solid var(--border-card);
		border-radius: 16px;
		overflow: hidden;
		transition: all 0.3s;
		cursor: pointer;
	}

	.mission-card:hover {
		border-color: var(--accent);
		transform: translateY(-4px);
		box-shadow: 0 8px 40px var(--accent-glow);
	}

	.card-accent {
		width: 4px;
		flex-shrink: 0;
		background: var(--border-card);
	}

	.card-accent[data-status="In Progress"] {
		background: var(--accent);
		box-shadow: 0 0 8px var(--accent-glow);
	}

	.card-accent[data-status="Launching Soon"] {
		background: var(--accent-yellow);
		box-shadow: 0 0 8px rgba(255, 204, 0, 0.3);
	}

	.card-accent[data-status="Planned"],
	.card-accent[data-status="Planning"] {
		background: #9b59b6;
	}

	.card-inner {
		flex: 1;
		padding: 1.25rem 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		min-width: 0;
	}

	.card-top {
		display: flex;
		gap: 1.25rem;
		align-items: flex-start;
	}

	.planet-circle {
		width: 64px;
		height: 64px;
		border-radius: 50%;
		flex-shrink: 0;
		overflow: hidden;
		border: 2px solid rgba(255, 102, 0, 0.25);
		box-shadow: 0 0 16px var(--accent-glow);
	}

	.planet-img-link {
		display: block;
		width: 100%;
		height: 100%;
	}

	.planet-circle img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.planet-fallback {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		font-size: 1.5rem;
		background: linear-gradient(135deg, var(--accent), var(--accent-yellow));
	}

	.card-info {
		flex: 1;
		min-width: 0;
	}

	.title-row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-bottom: 0.2rem;
	}

	h2 {
		font-family: var(--font-heading);
		font-size: 1.3rem;
		color: var(--accent-yellow);
		letter-spacing: 1px;
	}

	.dest-link {
		display: inline-block;
		font-size: 0.78rem;
		color: var(--accent);
		opacity: 0.75;
		transition: opacity 0.2s;
	}

	.dest-link:hover { opacity: 1; text-decoration: underline; }

	.mission-desc {
		color: var(--text-secondary);
		font-size: 0.85rem;
		line-height: 1.65;
		margin-top: 0.4rem;
	}

	.card-bottom {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		padding-top: 0.75rem;
		border-top: 1px solid var(--border-card);
		gap: 1rem;
	}

	.meta-label {
		display: block;
		font-size: 0.6rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--text-muted);
		margin-bottom: 0.3rem;
	}

	.crew-stack {
		display: flex;
	}

	.crew-pip {
		display: block;
		width: 30px;
		height: 30px;
		border-radius: 50%;
		overflow: hidden;
		border: 2px solid var(--bg-card);
		margin-right: -6px;
		transition: transform 0.2s;
		flex-shrink: 0;
	}

	.crew-pip:last-child { margin-right: 0; }

	.crew-pip:hover {
		transform: scale(1.3) translateY(-3px);
		border-color: var(--accent);
		z-index: 99;
	}

	.crew-pip img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.pip-fallback {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		font-size: 0.7rem;
		background: rgba(255, 102, 0, 0.15);
	}

	.launch-section { text-align: right; flex-shrink: 0; }

	.launch-val {
		font-family: var(--font-title);
		font-size: 0.8rem;
		color: var(--accent);
	}

	@media (max-width: 600px) {
		.card-top { flex-direction: column; align-items: center; text-align: center; }
		.title-row { justify-content: center; }
		.card-bottom { flex-direction: column; align-items: flex-start; }
		.launch-section { text-align: left; }
	}
</style>
