---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { services, staffMembers } from '@wix/bookings';
import { getImageUrl } from '../../utils/image';
import { i18n } from '@wix/essentials';
const t = i18n.getTranslationFunction();

const servicesResult = await services.queryServices({}) as any;
const allServices = ((servicesResult.services || servicesResult.items || []) as any[]).filter((s: any) => s.onlineBooking?.enabled && !s.hidden);

const staffResult = await staffMembers.queryStaffMembers({}) as any;
const allStaff = (staffResult.staffMembers || staffResult.items || []) as any[];
const staffMap = new Map(allStaff.map((s: any) => [s.resourceId, s]));

const serviceIcons: Record<string, string> = {
	'General Wellness Check': '🩺',
	'Space Sickness Consultation': '🤢',
	'Vaccination & Immunization': '💉',
	'Emergency & Trauma Care': '🚑',
	'Sleep & Anxiety Therapy': '😴',
	'Premium Full-Body Diagnostic': '🔬',
	'Holistic Wellness Program': '🧘',
};

const roleEmojis: Record<string, string> = {
	'Dr. Whiskerstein': '👨‍⚕️',
	'Nurse Mittens': '👩‍⚕️',
	'Nurse Pawsworth': '👩‍⚕️',
	'Dr. Luna Clawdia': '👩‍⚕️',
};
---

<Layout title={`${t('bookings.pageTitle')} - Cats In Space`}>
	<Nav />
	<section class="page-header">
		<div class="container">
			<h1 class="section-title">{t('bookings.pageTitle')}</h1>
			<p class="section-subtitle">{t('bookings.pageSubtitle')}</p>
		</div>
	</section>

	<section class="content">
		<div class="container">
			<div class="staff-section">
				<h2 class="subsection-title">{t('bookings.ourMedicalStaff')}</h2>
				<div class="staff-grid">
					{allStaff.map((staff: any) => {
						const staffImg = getImageUrl(typeof staff.mainMedia?.image === 'string' ? staff.mainMedia.image : (staff.mainMedia?.image?.id || staff.mainMedia?.image?.url), 200, 200);
						return (
						<div class="staff-card">
							<div class="staff-avatar">
								{staffImg ? <img src={staffImg} alt={staff.name} class="staff-photo" /> : <span>{roleEmojis[staff.name || ''] || '🐱'}</span>}
							</div>
							<div class="staff-info">
								<h3 class="staff-name">{staff.name}</h3>
								<p class="staff-desc">{staff.description}</p>
							</div>
						</div>
						);
					})}
				</div>
			</div>

			<h2 class="subsection-title">{t('bookings.availableServices')}</h2>
			<div class="services-grid">
				{allServices.map((service: any) => {
					const duration = service.schedule?.availabilityConstraints?.sessionDurations?.[0];
					const staffIds = service.staffMemberIds || [];
					const serviceStaff = staffIds.map((id: string) => staffMap.get(id)).filter(Boolean);
					const slug = service.mainSlug?.name || service._id;
					const icon = serviceIcons[service.name || ''] || '🏥';
					const svcMediaImg = service.media?.mainMedia?.image;
					const serviceImg = getImageUrl(typeof svcMediaImg === 'string' ? svcMediaImg : (svcMediaImg?.id || svcMediaImg?.url), 700, 400);

					return (
						<a href={`/bookings/${slug}`} class="service-card">
							{serviceImg ? (
								<div class="service-image">
									<img src={serviceImg} alt={service.name} />
								</div>
							) : (
								<div class="service-icon">{icon}</div>
							)}
							<div class="service-body">
								<h3 class="service-name">{service.name}</h3>
								{service.tagLine && <p class="service-tagline">{service.tagLine}</p>}
								<p class="service-desc">{service.description}</p>
								<div class="service-meta">
									{duration && (
										<span class="service-duration">
											<span class="meta-icon">⏱</span> {duration} {t('bookings.min')}
										</span>
									)}
									{service.payment?.rateType === 'FIXED' ? (
										<span class="service-price service-price-paid">
											<span class="meta-icon">💰</span> {service.payment.fixed?.price?.currency} {service.payment.fixed?.price?.value}
										</span>
									) : service.payment?.options?.pricingPlan ? (
										<span class="service-price service-price-plan">
											<span class="meta-icon">⭐</span> {t('bookings.membersOnly')}
										</span>
									) : (
										<span class="service-price">
											<span class="meta-icon">💰</span> {t('bookings.free')}
										</span>
									)}
								</div>
								<div class="service-staff">
									{serviceStaff.map((s: any) => (
										<span class="staff-tag">{roleEmojis[s!.name || ''] || '🐱'} {s!.name}</span>
									))}
								</div>
							</div>
							<div class="service-cta">{t('bookings.bookNow')} →</div>
						</a>
					);
				})}
			</div>

			<div class="policy-note">
				<h3>{t('bookings.bookingPolicy')}</h3>
				<p>{t('bookings.bookingPolicyText')}</p>
			</div>
		</div>
	</section>
	<Footer />
</Layout>

<style>
	.page-header {
		padding: 60px 0 40px;
		text-align: center;
	}

	.content {
		padding-bottom: 80px;
	}

	.subsection-title {
		font-family: var(--font-heading);
		font-size: 1.8rem;
		color: var(--accent-yellow);
		letter-spacing: 2px;
		margin-bottom: 24px;
	}

	/* Staff section */
	.staff-section {
		margin-bottom: 48px;
	}

	.staff-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 16px;
		margin-bottom: 16px;
	}

	.staff-card {
		background: var(--bg-card);
		border: 1px solid var(--border-card);
		border-radius: 12px;
		padding: 20px;
		display: flex;
		gap: 16px;
		align-items: flex-start;
	}

	.staff-avatar {
		font-size: 2.5rem;
		flex-shrink: 0;
		width: 64px;
		height: 64px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 102, 0, 0.1);
		border-radius: 50%;
		overflow: hidden;
	}

	.staff-photo {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.staff-name {
		font-family: var(--font-heading);
		font-size: 1rem;
		color: var(--accent);
		letter-spacing: 1px;
		margin-bottom: 4px;
	}

	.staff-desc {
		font-size: 0.75rem;
		color: var(--text-muted);
		line-height: 1.5;
	}

	/* Services grid */
	.services-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
		gap: 20px;
		margin-bottom: 40px;
	}

	.service-card {
		background: var(--bg-card);
		border: 1px solid var(--border-card);
		border-radius: 12px;
		padding: 24px;
		text-decoration: none;
		transition: all 0.3s;
		display: flex;
		flex-direction: column;
	}

	.service-card:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
		box-shadow: 0 8px 30px rgba(255, 102, 0, 0.15);
	}

	.service-image {
		width: 100%;
		height: 180px;
		border-radius: 8px;
		overflow: hidden;
		margin-bottom: 12px;
	}

	.service-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.service-icon {
		font-size: 2.5rem;
		margin-bottom: 12px;
	}

	.service-body {
		flex: 1;
	}

	.service-name {
		font-family: var(--font-heading);
		font-size: 1.3rem;
		color: var(--accent-yellow);
		letter-spacing: 1px;
		margin-bottom: 4px;
	}

	.service-tagline {
		font-size: 0.8rem;
		color: var(--accent);
		font-style: italic;
		margin-bottom: 8px;
	}

	.service-desc {
		font-size: 0.8rem;
		color: var(--text-muted);
		line-height: 1.5;
		margin-bottom: 16px;
	}

	.service-meta {
		display: flex;
		gap: 16px;
		margin-bottom: 12px;
	}

	.service-price-paid {
		color: var(--accent) !important;
		font-weight: 700;
	}

	.service-price-plan {
		color: #9c27b0 !important;
		font-weight: 700;
	}

	.service-duration,
	.service-price {
		font-size: 0.75rem;
		color: var(--text-secondary);
		display: flex;
		align-items: center;
		gap: 4px;
	}

	.meta-icon {
		font-size: 0.9rem;
	}

	.service-staff {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.staff-tag {
		font-size: 0.65rem;
		padding: 3px 8px;
		background: rgba(255, 204, 0, 0.1);
		border: 1px solid rgba(255, 204, 0, 0.2);
		border-radius: 12px;
		color: var(--accent-yellow);
		white-space: nowrap;
	}

	.service-cta {
		margin-top: 16px;
		padding-top: 12px;
		border-top: 1px solid #222;
		font-family: var(--font-heading);
		font-size: 0.9rem;
		color: var(--accent);
		letter-spacing: 1px;
		text-align: right;
	}

	.service-card:hover .service-cta {
		color: var(--accent-yellow);
	}

	/* Policy note */
	.policy-note {
		background: rgba(255, 102, 0, 0.05);
		border: 1px solid rgba(255, 102, 0, 0.2);
		border-radius: 12px;
		padding: 20px 24px;
	}

	.policy-note h3 {
		font-family: var(--font-heading);
		font-size: 1rem;
		color: var(--accent);
		letter-spacing: 1px;
		margin-bottom: 8px;
	}

	.policy-note p {
		font-size: 0.8rem;
		color: var(--text-muted);
		line-height: 1.5;
	}

	@media (max-width: 640px) {
		.services-grid {
			grid-template-columns: 1fr;
		}

		.staff-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
