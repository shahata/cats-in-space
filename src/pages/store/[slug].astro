---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ProductActions from '../../components/ProductActions';
import { products, collections } from '@wix/stores';
import type { products as productsTypes } from '@wix/stores';
import { i18n } from '@wix/essentials';
import { getImageUrl } from '../../utils/image';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/store');

const locale = await i18n.getLocale();

function formatPrice(p: productsTypes.Product): string {
	const { priceData, priceRange } = p;
	const currency = priceData?.currency || 'USD';
	const fmt = (n: number) => new Intl.NumberFormat(locale, { style: 'currency', currency }).format(n);
	if (priceRange && priceRange.minValue !== priceRange.maxValue) {
		return `${fmt(priceRange.minValue ?? 0)} – ${fmt(priceRange.maxValue ?? 0)}`;
	}
	return fmt(priceData?.price || 0);
}

// First find the product by slug to get its ID
const queryResult = await products.queryProducts().eq('slug', slug).limit(1).find();
const productStub = queryResult.items?.[0];
if (!productStub) return Astro.redirect('/store');

// Then use getProduct which returns full data including variants
let product: productsTypes.Product = productStub;
try {
	const full = await products.getProduct(productStub._id!);
	if (full.product) product = full.product;
} catch {}

const variantData = product.variants || [];

const collResult = await collections.queryCollections().limit(100).find();
const collectionMap = new Map<string, string>();
for (const c of (collResult.items || [])) {
	collectionMap.set(c._id!, c.name!);
}

const productCollections = (product.collectionIds || [])
	.map(id => collectionMap.get(id))
	.filter((x): x is string => !!x);

const images = (product.media?.items || [])
	.filter(m => m.mediaType === 'image' || m.image)
	.map(m => getImageUrl(m.image?.url, 600, 600))
	.filter((x): x is string => !!x);

const productData: ProductActionsProps = {
	_id: product._id!,
	name: product.name!,
	productOptions: product.productOptions || [],
	variants: variantData.length > 0 ? variantData : (product.variants || []),
	stock: product.stock,
	manageVariants: product.manageVariants,
	priceData: product.priceData,
};

type ProductActionsProps = import('../../components/ProductActions').ProductData;
---

<Layout title={`${product.name} - Cats In Space Store`}>
	<Nav />
	<section class="product-page">
		<div class="container">
			<a href="/store" class="back-link">&larr; Back to Store</a>

			<div class="product-layout">
				<div class="product-gallery">
					{images.length > 0 ? (
						<>
							<div class="gallery-main">
								<img id="main-image" src={images[0]} alt={product.name} />
							</div>
							{images.length > 1 && (
								<div class="gallery-thumbs">
									{images.map((img: string, i: number) => (
										<button class:list={['thumb', { active: i === 0 }]} data-src={img} data-index={i}>
											<img src={img} alt={`${product.name} ${i + 1}`} />
										</button>
									))}
								</div>
							)}
						</>
					) : (
						<div class="gallery-placeholder">
							<span>&#128049;</span>
						</div>
					)}
				</div>

				<div class="product-details">
					{productCollections.length > 0 && (
						<div class="product-collections">
							{productCollections.map((name: string) => (
								<span class="collection-tag">{name}</span>
							))}
						</div>
					)}

					<h1 class="product-title">{product.name}</h1>

					<div class="product-price-display">{formatPrice(product)}</div>

					{product.description && (
						<div class="product-description" set:html={product.description} />
					)}

					<ProductActions product={productData} client:load />
				</div>
			</div>
		</div>
	</section>
	<Footer />
</Layout>

<script>
	document.querySelectorAll('.thumb').forEach(thumb => {
		thumb.addEventListener('click', () => {
			const src = (thumb as HTMLElement).dataset.src;
			const mainImg = document.getElementById('main-image') as HTMLImageElement;
			if (mainImg && src) mainImg.src = src;
			document.querySelectorAll('.thumb').forEach(t => t.classList.remove('active'));
			thumb.classList.add('active');
		});
	});
</script>

<style>
	.product-page {
		padding: 30px 0 60px;
	}

	.back-link {
		display: inline-block;
		margin-bottom: 24px;
		font-family: var(--font-heading);
		font-size: 0.85rem;
		letter-spacing: 1px;
		color: var(--text-muted);
	}

	.back-link:hover {
		color: var(--accent);
	}

	.product-layout {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 48px;
		align-items: start;
	}

	.gallery-main {
		border-radius: 12px;
		overflow: hidden;
		background: #111;
		aspect-ratio: 1;
	}

	.gallery-main img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.gallery-placeholder {
		border-radius: 12px;
		background: linear-gradient(135deg, #1a1a2e, #16213e);
		aspect-ratio: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 8rem;
		opacity: 0.7;
	}

	.gallery-thumbs {
		display: flex;
		gap: 8px;
		margin-top: 12px;
	}

	.thumb {
		width: 64px;
		height: 64px;
		border-radius: 8px;
		overflow: hidden;
		border: 2px solid transparent;
		cursor: pointer;
		padding: 0;
		background: #111;
	}

	.thumb.active {
		border-color: var(--accent);
	}

	.thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.product-collections {
		display: flex;
		gap: 6px;
		margin-bottom: 12px;
	}

	.collection-tag {
		background: var(--accent);
		color: #000;
		padding: 4px 10px;
		border-radius: 6px;
		font-family: var(--font-heading);
		font-size: 0.7rem;
		letter-spacing: 1px;
	}

	.product-title {
		font-family: var(--font-heading);
		font-size: clamp(1.5rem, 3vw, 2.2rem);
		color: var(--text-primary);
		letter-spacing: 1px;
		margin-bottom: 12px;
	}

	.product-price-display {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--accent-yellow);
		margin-bottom: 16px;
	}

	.product-description {
		color: var(--text-secondary);
		font-size: 0.95rem;
		line-height: 1.7;
		margin-bottom: 24px;
		padding-bottom: 24px;
		border-bottom: 1px solid #222;
	}

	@media (max-width: 768px) {
		.product-layout {
			grid-template-columns: 1fr;
			gap: 24px;
		}
	}

	/* ProductActions styles */
	:global(.pa-root) { margin-top: 4px; }
	:global(.pa-options) { display: flex; flex-direction: column; gap: 16px; margin-bottom: 20px; }
	:global(.pa-option-label) { display: block; font-family: var(--font-heading); font-size: 0.8rem; letter-spacing: 1px; color: #888; margin-bottom: 6px; text-transform: uppercase; }
	:global(.pa-choices) { display: flex; flex-wrap: wrap; gap: 6px; }
	:global(.pa-choice) { padding: 8px 16px; border-radius: 8px; border: 1px solid #333; background: #1a1a1a; color: #aaa; font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: all 0.2s; }
	:global(.pa-choice:hover) { border-color: #ff6600; color: #e0e0e0; }
	:global(.pa-choice-active) { border-color: #ff6600; background: rgba(255, 102, 0, 0.15); color: #ff6600; }
	:global(.pa-selected-price) { font-size: 1.3rem; font-weight: 700; color: #ffcc00; margin-bottom: 8px; }
	:global(.pa-stock-status) { margin-bottom: 16px; }
	:global(.pa-in-stock) { color: #4caf50; font-size: 0.85rem; font-weight: 600; }
	:global(.pa-oos) { color: #f44336; font-size: 0.85rem; font-weight: 600; }
	:global(.pa-quantity) { margin-bottom: 20px; }
	:global(.pa-qty-controls) { display: flex; align-items: center; gap: 0; width: fit-content; border: 1px solid #333; border-radius: 8px; overflow: hidden; }
	:global(.pa-qty-btn) { width: 36px; height: 36px; background: #1a1a1a; border: none; color: #aaa; font-size: 1.1rem; cursor: pointer; transition: background 0.2s; }
	:global(.pa-qty-btn:hover:not(:disabled)) { background: #222; color: #ff6600; }
	:global(.pa-qty-btn:disabled) { opacity: 0.3; cursor: default; }
	:global(.pa-qty-value) { width: 44px; text-align: center; font-weight: 700; font-size: 0.95rem; color: #e0e0e0; background: #141414; height: 36px; line-height: 36px; }
	:global(.pa-actions) { display: flex; gap: 10px; margin-bottom: 12px; }
	:global(.pa-btn) { padding: 12px 24px; border-radius: 8px; font-family: var(--font-heading); font-size: 1rem; letter-spacing: 1.5px; border: none; cursor: pointer; transition: all 0.2s; }
	:global(.pa-btn:disabled) { opacity: 0.5; cursor: default; }
	:global(.pa-btn-cart) { background: var(--accent); color: #000; flex: 1; }
	:global(.pa-btn-cart:hover:not(:disabled)) { background: #ff8533; }
	:global(.pa-btn-buy) { background: #ffcc00; color: #000; flex: 1; }
	:global(.pa-btn-buy:hover:not(:disabled)) { background: #ffd633; }
	:global(.pa-bis) { margin-top: 4px; }
	:global(.pa-bis-text) { color: #aaa; font-size: 0.85rem; margin-bottom: 8px; }
	:global(.pa-bis-form) { display: flex; gap: 8px; }
	:global(.pa-bis-input) { flex: 1; padding: 10px 14px; border-radius: 8px; border: 1px solid #333; background: #1a1a1a; color: #e0e0e0; font-size: 0.9rem; outline: none; }
	:global(.pa-bis-input:focus) { border-color: #ff6600; }
	:global(.pa-btn-bis) { padding: 10px 18px; background: #ff6600; color: #000; font-family: var(--font-heading); font-size: 0.85rem; letter-spacing: 1px; border: none; border-radius: 8px; cursor: pointer; }
	:global(.pa-bis-done) { color: #4caf50; font-size: 0.9rem; }
	:global(.pa-message) { margin-top: 12px; padding: 10px 14px; border-radius: 8px; font-size: 0.85rem; }
	:global(.pa-message-success) { background: rgba(76, 175, 80, 0.15); border: 1px solid #4caf50; color: #4caf50; }
	:global(.pa-message-error) { background: rgba(244, 67, 54, 0.15); border: 1px solid #f44336; color: #f44336; }
</style>
