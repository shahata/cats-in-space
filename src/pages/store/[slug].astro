---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ProductActions from '../../components/ProductActions';
import { products, collections } from '@wix/stores';
import type { products as productsTypes } from '@wix/stores';
import { i18n } from '@wix/essentials';
import { getImageUrl } from '../../utils/image';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/store');

const locale = await i18n.getLocale();

function formatPrice(p: productsTypes.Product) {
	const { priceData } = p;
	const currency = priceData?.currency || 'USD';
	const fmt = (n: number) => new Intl.NumberFormat(locale, { style: 'currency', currency }).format(n);
	const price = priceData?.price ?? 0;
	const discounted = priceData?.discountedPrice ?? price;
	const onSale = discounted < price;
	return { formatted: fmt(discounted), original: onSale ? fmt(price) : null };
}

// First find the product by slug to get its ID
const queryResult = await products.queryProducts().eq('slug', slug).limit(1).find();
const productStub = queryResult.items?.[0];
if (!productStub) return Astro.redirect('/store');

// Then use getProduct which returns full data including variants
let product: productsTypes.Product = productStub;
try {
	const full = await products.getProduct(productStub._id!);
	if (full.product) product = full.product;
} catch {}

const variantData = product.variants || [];

const collResult = await collections.queryCollections().limit(100).find();
const collectionMap = new Map<string, string>();
for (const c of (collResult.items || [])) {
	collectionMap.set(c._id!, c.name!);
}

const productCollections = (product.collectionIds || [])
	.map(id => collectionMap.get(id))
	.filter((x): x is string => !!x);

type MediaEntry = { type: 'image'; url: string } | { type: 'video'; url: string; thumbnail?: string };
const mediaItems: MediaEntry[] = (product.media?.items || [])
	.map(m => {
		if (m.mediaType === 'video' && m.video?.files?.length) {
			const best = m.video.files.reduce((a, b) => ((b.height ?? 0) > (a.height ?? 0) ? b : a));
			return { type: 'video' as const, url: best.url!, thumbnail: getImageUrl(m.thumbnail?.url, 600, 600) ?? undefined };
		}
		const url = getImageUrl(m.image?.url, 600, 600);
		return url ? { type: 'image' as const, url } : null;
	})
	.filter((x): x is MediaEntry => !!x);
const images = mediaItems.filter(m => m.type === 'image').map(m => m.url);

const productData: ProductActionsProps = {
	_id: product._id!,
	name: product.name!,
	productOptions: product.productOptions || [],
	variants: variantData.length > 0 ? variantData : (product.variants || []),
	stock: product.stock,
	manageVariants: product.manageVariants,
	priceData: product.priceData,
	customTextFields: product.customTextFields || [],
	ribbon: product.ribbon,
};

const infoSections = product.additionalInfoSections || [];
const ribbon = product.ribbon;

type ProductActionsProps = import('../../components/ProductActions').ProductData;
---

<Layout title={`${product.name} - Cats In Space Store`}>
	<Nav />
	<section class="product-page">
		<div class="container">
			<a href="/store" class="back-link">&larr; Back to Store</a>

			<div class="product-layout">
				<div class="product-gallery">
					{mediaItems.length > 0 ? (
						<>
							<div class="gallery-main">
								{mediaItems[0].type === 'video' ? (
									<video id="main-video" src={mediaItems[0].url} controls autoplay muted loop playsinline />
								) : (
									<img id="main-image" src={mediaItems[0].url} alt={product.name} />
								)}
							</div>
							{mediaItems.length > 1 && (
								<div class="gallery-thumbs">
									{mediaItems.map((m, i: number) => (
										<button
											class:list={['thumb', { active: i === 0 }]}
											data-src={m.url}
											data-type={m.type}
											data-index={i}
										>
											{m.type === 'video' ? (
												<div class="thumb-video">&#9654;</div>
											) : (
												<img src={m.url} alt={`${product.name} ${i + 1}`} />
											)}
										</button>
									))}
								</div>
							)}
						</>
					) : (
						<div class="gallery-placeholder">
							<span>&#128049;</span>
						</div>
					)}
				</div>

				<div class="product-details">
					<div class="product-top-badges">
						{productCollections.map((name: string) => (
							<span class="collection-tag">{name}</span>
						))}
						{ribbon && <span class="ribbon-tag">{ribbon}</span>}
					</div>

					<h1 class="product-title">{product.name}</h1>

					{(() => {
						const { formatted, original } = formatPrice(product);
						return (
							<div class="product-price-display">
								{original && <span class="price-original">{original}</span>}
								<span class={original ? 'price-sale' : ''}>{formatted}</span>
							</div>
						);
					})()}

					{product.description && (
						<div class="product-description" set:html={product.description} />
					)}

					<ProductActions product={productData} client:load />

					{infoSections.length > 0 && (
						<div class="info-sections">
							{infoSections.map((section) => (
								<details class="info-section">
									<summary class="info-section-title">{section.title}</summary>
									<div class="info-section-content" set:html={section.description} />
								</details>
							))}
						</div>
					)}
				</div>
			</div>
		</div>
	</section>
	<Footer />
</Layout>

<script>
	document.querySelectorAll('.thumb').forEach(thumb => {
		thumb.addEventListener('click', () => {
			const src = (thumb as HTMLElement).dataset.src;
			const type = (thumb as HTMLElement).dataset.type;
			const main = document.querySelector('.gallery-main')!;

			if (type === 'video') {
				main.innerHTML = `<video id="main-video" src="${src}" controls autoplay muted loop playsinline></video>`;
			} else {
				main.innerHTML = `<img id="main-image" src="${src}" alt="Product" />`;
			}

			document.querySelectorAll('.thumb').forEach(t => t.classList.remove('active'));
			thumb.classList.add('active');
		});
	});
</script>

<style>
	.product-page {
		padding: 30px 0 60px;
	}

	.back-link {
		display: inline-block;
		margin-bottom: 24px;
		font-family: var(--font-heading);
		font-size: 0.85rem;
		letter-spacing: 1px;
		color: var(--text-muted);
	}

	.back-link:hover {
		color: var(--accent);
	}

	.product-layout {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 48px;
		align-items: start;
	}

	.gallery-main {
		border-radius: 12px;
		background: #111;
		width: 100%;
		height: 0;
		padding-bottom: 100%; /* square via padding trick - unbreakable */
		position: relative;
		overflow: hidden;
	}

	.gallery-main img,
	.gallery-main video {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.gallery-placeholder {
		border-radius: 12px;
		background: linear-gradient(135deg, #1a1a2e, #16213e);
		aspect-ratio: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 8rem;
		opacity: 0.7;
	}

	.gallery-thumbs {
		display: flex;
		gap: 8px;
		margin-top: 12px;
	}

	.thumb {
		width: 64px;
		height: 64px;
		border-radius: 8px;
		overflow: hidden;
		border: 2px solid transparent;
		cursor: pointer;
		padding: 0;
		background: #111;
	}

	.thumb.active {
		border-color: var(--accent);
	}

	.thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.thumb-video {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #1a1a2e;
		color: var(--accent);
		font-size: 1.5rem;
	}

	.product-top-badges {
		display: flex;
		gap: 6px;
		margin-bottom: 12px;
		flex-wrap: wrap;
	}

	.collection-tag {
		background: var(--accent);
		color: #000;
		padding: 4px 10px;
		border-radius: 6px;
		font-family: var(--font-heading);
		font-size: 0.7rem;
		letter-spacing: 1px;
	}

	.ribbon-tag {
		background: #cc0000;
		color: #fff;
		padding: 4px 10px;
		border-radius: 6px;
		font-family: var(--font-heading);
		font-size: 0.7rem;
		letter-spacing: 1px;
	}

	.price-original {
		text-decoration: line-through;
		color: var(--text-muted);
		font-size: 1rem;
		font-weight: 400;
		margin-right: 8px;
	}

	.price-sale {
		color: #f44336;
	}

	.product-title {
		font-family: var(--font-heading);
		font-size: clamp(1.5rem, 3vw, 2.2rem);
		color: var(--text-primary);
		letter-spacing: 1px;
		margin-bottom: 12px;
	}

	.product-price-display {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--accent-yellow);
		margin-bottom: 16px;
	}

	.product-description {
		color: var(--text-secondary);
		font-size: 0.95rem;
		line-height: 1.7;
		margin-bottom: 24px;
		padding-bottom: 24px;
		border-bottom: 1px solid #222;
	}

	.info-sections {
		margin-top: 24px;
		border-top: 1px solid #222;
		padding-top: 16px;
	}

	.info-section {
		border-bottom: 1px solid #222;
	}

	.info-section-title {
		padding: 14px 0;
		font-family: var(--font-heading);
		font-size: 0.9rem;
		letter-spacing: 1px;
		color: var(--text-secondary);
		cursor: pointer;
		list-style: none;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.info-section-title::after {
		content: '+';
		font-size: 1.2rem;
		color: var(--text-muted);
		transition: transform 0.2s;
	}

	.info-section[open] .info-section-title::after {
		content: '-';
	}

	.info-section-content {
		padding: 0 0 14px;
		color: var(--text-muted);
		font-size: 0.85rem;
		line-height: 1.6;
	}

	@media (max-width: 768px) {
		.product-layout {
			grid-template-columns: 1fr;
			gap: 24px;
		}
	}

	/* ProductActions styles */
	:global(.pa-root) { margin-top: 4px; }
	:global(.pa-options) { display: flex; flex-direction: column; gap: 16px; margin-bottom: 20px; }
	:global(.pa-option-label) { display: block; font-family: var(--font-heading); font-size: 0.8rem; letter-spacing: 1px; color: #888; margin-bottom: 6px; text-transform: uppercase; }
	:global(.pa-choices) { display: flex; flex-wrap: wrap; gap: 6px; }
	:global(.pa-choice) { padding: 8px 16px; border-radius: 8px; border: 1px solid #333; background: #1a1a1a; color: #aaa; font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: all 0.2s; }
	:global(.pa-choice:hover) { border-color: #ff6600; color: #e0e0e0; }
	:global(.pa-choice-active) { border-color: #ff6600; background: rgba(255, 102, 0, 0.15); color: #ff6600; }
	:global(.pa-selected-price) { font-size: 1.3rem; font-weight: 700; color: #ffcc00; margin-bottom: 8px; }
	:global(.pa-stock-status) { margin-bottom: 16px; }
	:global(.pa-in-stock) { color: #4caf50; font-size: 0.85rem; font-weight: 600; }
	:global(.pa-oos) { color: #f44336; font-size: 0.85rem; font-weight: 600; }
	:global(.pa-quantity) { margin-bottom: 20px; }
	:global(.pa-qty-controls) { display: flex; align-items: center; gap: 0; width: fit-content; border: 1px solid #333; border-radius: 8px; overflow: hidden; }
	:global(.pa-qty-btn) { width: 36px; height: 36px; background: #1a1a1a; border: none; color: #aaa; font-size: 1.1rem; cursor: pointer; transition: background 0.2s; }
	:global(.pa-qty-btn:hover:not(:disabled)) { background: #222; color: #ff6600; }
	:global(.pa-qty-btn:disabled) { opacity: 0.3; cursor: default; }
	:global(.pa-qty-value) { width: 44px; text-align: center; font-weight: 700; font-size: 0.95rem; color: #e0e0e0; background: #141414; height: 36px; line-height: 36px; }
	:global(.pa-actions) { display: flex; gap: 10px; margin-bottom: 12px; }
	:global(.pa-btn) { padding: 12px 24px; border-radius: 8px; font-family: var(--font-heading); font-size: 1rem; letter-spacing: 1.5px; border: none; cursor: pointer; transition: all 0.2s; }
	:global(.pa-btn:disabled) { opacity: 0.5; cursor: default; }
	:global(.pa-btn-cart) { background: var(--accent); color: #000; flex: 1; }
	:global(.pa-btn-cart:hover:not(:disabled)) { background: #ff8533; }
	:global(.pa-btn-buy) { background: #ffcc00; color: #000; flex: 1; }
	:global(.pa-btn-buy:hover:not(:disabled)) { background: #ffd633; }
	:global(.pa-bis) { margin-top: 4px; }
	:global(.pa-bis-text) { color: #aaa; font-size: 0.85rem; margin-bottom: 8px; }
	:global(.pa-bis-form) { display: flex; gap: 8px; }
	:global(.pa-bis-input) { flex: 1; padding: 10px 14px; border-radius: 8px; border: 1px solid #333; background: #1a1a1a; color: #e0e0e0; font-size: 0.9rem; outline: none; }
	:global(.pa-bis-input:focus) { border-color: #ff6600; }
	:global(.pa-btn-bis) { padding: 10px 18px; background: #ff6600; color: #000; font-family: var(--font-heading); font-size: 0.85rem; letter-spacing: 1px; border: none; border-radius: 8px; cursor: pointer; }
	:global(.pa-bis-done) { color: #4caf50; font-size: 0.9rem; }
	:global(.pa-message) { margin-top: 12px; padding: 10px 14px; border-radius: 8px; font-size: 0.85rem; }
	:global(.pa-message-success) { background: rgba(76, 175, 80, 0.15); border: 1px solid #4caf50; color: #4caf50; }
	:global(.pa-message-error) { background: rgba(244, 67, 54, 0.15); border: 1px solid #f44336; color: #f44336; }
	:global(.pa-original-price) { text-decoration: line-through; color: var(--text-muted); font-size: 0.95rem; font-weight: 400; margin-right: 8px; }
	:global(.pa-sale-price) { color: #f44336; }
	:global(.pa-text-input) { width: 100%; padding: 10px 14px; border-radius: 8px; border: 1px solid #333; background: #1a1a1a; color: var(--text-primary); font-size: 0.9rem; outline: none; font-family: var(--font-body); }
	:global(.pa-text-input:focus) { border-color: var(--accent); }
	:global(.pa-required) { color: #f44336; margin-left: 2px; }
</style>
