---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ProductActions from '../../components/ProductActions';
import RichContentViewer from '../../components/RichContentViewer';
import { productsV3 } from '@wix/stores';
import { categories } from '@wix/categories';
import { seoTags as seoTagsApi } from '@wix/seo';
import { extractMediaUrl } from '../../utils/image';
import { i18n } from '@wix/essentials';
const t = i18n.getTranslationFunction();

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/store');

let product;
try {
	const result = await productsV3.getProductBySlug(slug, { fields: [productsV3.RequestedFields.MEDIA_ITEMS_INFO, productsV3.RequestedFields.CURRENCY, productsV3.RequestedFields.DESCRIPTION, productsV3.RequestedFields.INFO_SECTION, productsV3.RequestedFields.INFO_SECTION_DESCRIPTION, productsV3.RequestedFields.DIRECT_CATEGORIES_INFO, productsV3.RequestedFields.VARIANT_OPTION_CHOICE_NAMES] });
	product = result.product;
} catch {}
if (!product) return Astro.redirect('/store');

const variantData = product.variantsInfo?.variants || [];

const catResult = await categories.queryCategories({ cursorPaging: { limit: 100 } }, { treeReference: { appNamespace: '@wix/stores' } });
const allCategories = catResult.categories || [];
const categoryMap = new Map<string, string>();
for (const c of allCategories) categoryMap.set(c._id!, c.name!);
const categoryOrder = new Map(allCategories.map((c, i) => [c._id!, i]));

const productCollections = (product.directCategoriesInfo?.categories || [])
	.map(cat => cat._id ? { _id: cat._id, name: categoryMap.get(cat._id) } : undefined)
	.filter((x): x is { _id: string; name: string } => !!x && !!x.name)
	.sort((a, b) => (categoryOrder.get(a._id) ?? 999) - (categoryOrder.get(b._id) ?? 999));

const mediaItems = (product.media?.itemsInfo?.items || [])
	.map(m => extractMediaUrl(m, 600, 600))
	.filter((x): x is NonNullable<typeof x> => !!x);
function buildPriceValue(v: { amount?: string; formattedAmount?: string | null } | undefined) {
	if (!v) return undefined;
	const result: { amount?: string; formattedAmount?: string | null } = {};
	if (v.amount) result.amount = v.amount;
	if (v.formattedAmount !== undefined) result.formattedAmount = v.formattedAmount;
	return result;
}
function buildPriceRange(r: { minValue?: { amount?: string; formattedAmount?: string | null }; maxValue?: { amount?: string; formattedAmount?: string | null } } | undefined) {
	if (!r) return undefined;
	const result: { minValue?: { amount?: string; formattedAmount?: string | null }; maxValue?: { amount?: string; formattedAmount?: string | null } } = {};
	const min = buildPriceValue(r.minValue);
	const max = buildPriceValue(r.maxValue);
	if (min) result.minValue = min;
	if (max) result.maxValue = max;
	return result;
}
const productData: ProductActionsProps = {
	_id: product._id!,
	name: product.name!,
	options: product.options || [],
	variants: variantData.length > 0 ? variantData : [],
	inventory: product.inventory,
	...(product.actualPriceRange ? { priceRange: buildPriceRange(product.actualPriceRange)! } : {}),
	...(product.compareAtPriceRange ? { compareAtPriceRange: buildPriceRange(product.compareAtPriceRange)! } : {}),
	currency: product.currency ?? null,
	modifiers: product.modifiers || [],
	ribbon: product.ribbon?.name ?? null,
};

const infoSections = product.infoSections || [];
const ribbon = product.ribbon?.name;

const pageUrl = new URL(`/store/${slug}`, Astro.url).href;
const seoResult = await seoTagsApi.resolveItemSeoTags({ pageUrl, itemType: seoTagsApi.ItemType.STORES_PRODUCT, slug });
const seoTags = seoResult.seoTags?.tags || [];

type ProductActionsProps = import('../../components/ProductActions').ProductData;
---

<Layout title={`${product.name} - ${t('home.title')}`} seoTags={seoTags}>
	<Nav />
	<section class="product-page">
		<div class="container">
			<a href="/store" class="back-link"><span class="rtl-flip">←</span> {t('store.backToStore')}</a>

			<div class="product-layout">
				<div class="product-gallery">
					{mediaItems.length > 0 ? (
						<>
							<div class="gallery-main">
								{mediaItems[0]!.type === 'video' ? (
									<video id="main-video" src={mediaItems[0]!.url} poster={mediaItems[0]!.thumbnail || ''} controls autoplay muted loop playsinline />
								) : (
									<img id="main-image" src={mediaItems[0]!.url} alt={product.name} />
								)}
							</div>
							{mediaItems.length > 1 && (
								<div class="gallery-thumbs">
									{mediaItems.map((m, i: number) => (
										<button
											class:list={['thumb', { active: i === 0 }]}
											data-src={m.url}
											data-type={m.type}
											data-thumbnail={m.thumbnail || ''}
											data-index={i}
										>
											{m.type === 'video' ? (
												m.thumbnail ? (
													<img src={m.thumbnail} alt={`${product.name} video`} />
												) : (
													<div class="thumb-video">&#9654;</div>
												)
											) : (
												<img src={m.url} alt={`${product.name} ${i + 1}`} />
											)}
										</button>
									))}
								</div>
							)}
						</>
					) : (
						<div class="gallery-placeholder">
							<span>&#128049;</span>
						</div>
					)}
				</div>

				<div class="product-details">
					<div class="product-top-badges">
						{productCollections.map((col) => (
							<a href={`/store?cat=${col._id}`} class="collection-tag">{col.name}</a>
						))}
						{ribbon && <span class="ribbon-tag">{ribbon}</span>}
					</div>

					<h1 class="product-title">{product.name}</h1>

					<div class="product-price-display" id="product-price-slot"></div>

					{product.description && (
						<div class="product-description">
							<RichContentViewer content={product.description} client:load />
						</div>
					)}

					<ProductActions product={productData} client:load />

					{infoSections.length > 0 && (
						<div class="info-sections">
							{infoSections.map((section) => (
								<details class="info-section">
									<summary class="info-section-title">{section.title}</summary>
									<div class="info-section-content">
										{section.description ? (
											<RichContentViewer content={section.description} client:load />
										) : (
											<span>{section.plainDescription}</span>
										)}
									</div>
								</details>
							))}
						</div>
					)}
				</div>
			</div>
		</div>
	</section>
	<Footer />
</Layout>

<script>
	document.querySelectorAll('.thumb').forEach(thumb => {
		thumb.addEventListener('click', () => {
			const el = thumb as HTMLElement;
			const src = el.dataset.src;
			const type = el.dataset.type;
			const thumbnail = el.dataset.thumbnail;
			const main = document.querySelector('.gallery-main')!;

			if (type === 'video') {
				main.innerHTML = `<video id="main-video" src="${src}" poster="${thumbnail || ''}" controls autoplay muted loop playsinline></video>`;
			} else {
				main.innerHTML = `<img id="main-image" src="${src}" alt="Product" />`;
			}

			document.querySelectorAll('.thumb').forEach(t => t.classList.remove('active'));
			thumb.classList.add('active');
		});
	});
</script>

<style>
	.product-page {
		padding: 30px 0 60px;
	}

	.back-link {
		display: inline-block;
		margin-bottom: 24px;
		font-family: var(--font-heading);
		font-size: 0.85rem;
		letter-spacing: 1px;
		color: var(--text-muted);
	}

	.back-link:hover {
		color: var(--accent);
	}

	.product-layout {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 48px;
		align-items: start;
	}

	.product-gallery {
		min-width: 0;
		overflow: hidden;
	}

	.gallery-main {
		border-radius: 12px;
		background: #111;
		width: 100%;
		height: 0;
		padding-bottom: 100%; /* square via padding trick - unbreakable */
		position: relative;
		overflow: hidden;
	}

	.gallery-main img,
	.gallery-main video {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.gallery-placeholder {
		border-radius: 12px;
		background: linear-gradient(135deg, #1a1a2e, #16213e);
		aspect-ratio: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 8rem;
		opacity: 0.7;
	}

	.gallery-thumbs {
		display: flex;
		gap: 8px;
		margin-top: 12px;
	}

	.thumb {
		width: 64px;
		height: 64px;
		border-radius: 8px;
		overflow: hidden;
		border: 2px solid transparent;
		cursor: pointer;
		padding: 0;
		background: #111;
	}

	.thumb.active {
		border-color: var(--accent);
	}

	.thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.thumb-video {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #1a1a2e;
		color: var(--accent);
		font-size: 1.5rem;
	}

	.product-top-badges {
		display: flex;
		gap: 6px;
		margin-bottom: 12px;
		flex-wrap: wrap;
	}

	.collection-tag {
		background: var(--accent);
		color: #000;
		padding: 4px 10px;
		border-radius: 6px;
		font-family: var(--font-heading);
		font-size: 0.7rem;
		letter-spacing: 1px;
		transition: background 0.2s;
	}

	.collection-tag:hover {
		background: var(--accent-yellow);
		color: #000;
	}

	.ribbon-tag {
		background: #cc0000;
		color: #fff;
		padding: 4px 10px;
		border-radius: 6px;
		font-family: var(--font-heading);
		font-size: 0.7rem;
		letter-spacing: 1px;
	}

	.price-original {
		text-decoration: line-through;
		color: var(--text-muted);
		font-size: 1rem;
		font-weight: 400;
		margin-right: 8px;
	}

	.price-sale {
		color: #f44336;
	}

	.product-title {
		font-family: var(--font-heading);
		font-size: clamp(1.5rem, 3vw, 2.2rem);
		color: var(--text-primary);
		letter-spacing: 1px;
		margin-bottom: 12px;
	}

	.product-price-display {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--accent-yellow);
		margin-bottom: 16px;
	}

	.product-description {
		color: var(--text-secondary);
		font-size: 0.95rem;
		line-height: 1.7;
		margin-bottom: 24px;
		padding-bottom: 24px;
		border-bottom: 1px solid #222;
	}

	.info-sections {
		margin-top: 24px;
		border-top: 1px solid #222;
		padding-top: 16px;
	}

	.info-section {
		border-bottom: 1px solid #222;
	}

	.info-section-title {
		padding: 14px 0;
		font-family: var(--font-heading);
		font-size: 0.9rem;
		letter-spacing: 1px;
		color: var(--text-secondary);
		cursor: pointer;
		list-style: none;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.info-section-title::after {
		content: '+';
		font-size: 1.2rem;
		color: var(--text-muted);
		transition: transform 0.2s;
	}

	.info-section[open] .info-section-title::after {
		content: '-';
	}

	.info-section-content {
		padding: 0 0 14px;
		color: var(--text-muted);
		font-size: 0.85rem;
		line-height: 1.6;
	}

	@media (max-width: 768px) {
		.product-layout {
			grid-template-columns: 1fr;
			gap: 24px;
		}
	}

	/* ProductActions styles */
	:global(.pa-root) { margin-top: 4px; }
	:global(.pa-options) { display: flex; flex-direction: column; gap: 16px; margin-bottom: 20px; }
	:global(.pa-option-label) { display: block; font-family: var(--font-heading); font-size: 0.8rem; letter-spacing: 1px; color: #888; margin-bottom: 6px; text-transform: uppercase; }
	:global(.pa-choices) { display: flex; flex-wrap: wrap; gap: 6px; }
	:global(.pa-choice) { padding: 8px 16px; border-radius: 8px; border: 1px solid #333; background: #1a1a1a; color: #aaa; font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: all 0.2s; }
	:global(.pa-choice:hover) { border-color: #ff6600; color: #e0e0e0; }
	:global(.pa-choice-active) { border-color: #ff6600; background: rgba(255, 102, 0, 0.15); color: #ff6600; }
	:global(.pa-swatch) { width: 36px; height: 36px; border-radius: 50%; border: 2px solid #333; cursor: pointer; transition: all 0.2s; padding: 0; }
	:global(.pa-swatch:hover) { border-color: var(--text-secondary); transform: scale(1.1); }
	:global(.pa-swatch-active) { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent); }
	:global(.pa-selected-price) { font-size: 1.3rem; font-weight: 700; color: #ffcc00; margin-bottom: 8px; }
	:global(.pa-stock-status) { margin-bottom: 16px; }
	:global(.pa-in-stock) { color: #4caf50; font-size: 0.85rem; font-weight: 600; }
	:global(.pa-oos) { color: #f44336; font-size: 0.85rem; font-weight: 600; }
	:global(.pa-quantity) { margin-bottom: 20px; }
	:global(.pa-qty-controls) { display: flex; align-items: center; gap: 0; width: fit-content; border: 1px solid #333; border-radius: 8px; overflow: hidden; }
	:global(.pa-qty-btn) { width: 36px; height: 36px; background: #1a1a1a; border: none; color: #aaa; font-size: 1.1rem; cursor: pointer; transition: background 0.2s; }
	:global(.pa-qty-btn:hover:not(:disabled)) { background: #222; color: #ff6600; }
	:global(.pa-qty-btn:disabled) { opacity: 0.3; cursor: default; }
	:global(.pa-qty-value) { width: 44px; text-align: center; font-weight: 700; font-size: 0.95rem; color: #e0e0e0; background: #141414; height: 36px; line-height: 36px; }
	:global(.pa-actions) { display: flex; gap: 10px; margin-bottom: 12px; }
	:global(.pa-btn) { padding: 12px 24px; border-radius: 8px; font-family: var(--font-heading); font-size: 1rem; letter-spacing: 1.5px; border: none; cursor: pointer; transition: all 0.2s; }
	:global(.pa-btn:disabled) { opacity: 0.5; cursor: default; }
	:global(.pa-btn-cart) { background: var(--accent); color: #000; flex: 1; }
	:global(.pa-btn-cart:hover:not(:disabled)) { background: #ff8533; }
	:global(.pa-btn-buy) { background: #ffcc00; color: #000; flex: 1; }
	:global(.pa-btn-buy:hover:not(:disabled)) { background: #ffd633; }
	:global(.pa-bis) { margin-top: 4px; }
	:global(.pa-bis-text) { color: #aaa; font-size: 0.85rem; margin-bottom: 8px; }
	:global(.pa-bis-form) { display: flex; gap: 8px; }
	:global(.pa-bis-input) { flex: 1; padding: 10px 14px; border-radius: 8px; border: 1px solid #333; background: #1a1a1a; color: #e0e0e0; font-size: 0.9rem; outline: none; }
	:global(.pa-bis-input:focus) { border-color: #ff6600; }
	:global(.pa-btn-bis) { padding: 10px 18px; background: #ff6600; color: #000; font-family: var(--font-heading); font-size: 0.85rem; letter-spacing: 1px; border: none; border-radius: 8px; cursor: pointer; }
	:global(.pa-bis-done) { color: #4caf50; font-size: 0.9rem; }
	:global(.pa-message) { margin-top: 12px; padding: 10px 14px; border-radius: 8px; font-size: 0.85rem; }
	:global(.pa-message-success) { background: rgba(76, 175, 80, 0.15); border: 1px solid #4caf50; color: #4caf50; }
	:global(.pa-message-error) { background: rgba(244, 67, 54, 0.15); border: 1px solid #f44336; color: #f44336; }
	:global(.pa-original-price) { text-decoration: line-through; color: var(--text-muted); font-size: 0.95rem; font-weight: 400; margin-right: 8px; }
	:global(.pa-sale-price) { color: #f44336; }
	:global(.pa-text-input) { width: 100%; padding: 10px 14px; border-radius: 8px; border: 1px solid #333; background: #1a1a1a; color: var(--text-primary); font-size: 0.9rem; outline: none; font-family: var(--font-body); }
	:global(.pa-text-input:focus) { border-color: var(--accent); }
	:global(.pa-required) { color: #f44336; margin-left: 2px; }
	:global(.pa-char-count) { display: block; font-size: 0.7rem; color: var(--text-muted); margin-top: 4px; text-align: right; }
</style>
