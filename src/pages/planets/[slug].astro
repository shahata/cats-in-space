---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { items } from "@wix/data";
import { getImageUrl } from "../../utils/image";
import { i18n } from "@wix/essentials";
const t = i18n.getTranslationFunction();

const { slug } = Astro.params;
const result = await items.query("Planets").eq("slug", slug).find();

if (result.items.length === 0) {
  return Astro.redirect("/planets");
}

const planet = result.items[0]!;

// Find related missions
const missionsResult = await items
  .query("Missions")
  .eq("planet", planet.title)
  .find();
const missions = missionsResult.items;

function getStatusBadge(status: string) {
  const map: Record<string, string> = {
    "Top Candidate": "badge-green",
    Exploring: "badge-blue",
    Candidate: "badge-purple",
    Rejected: "badge-pink",
    "In Progress": "badge-blue",
    "Launching Soon": "badge-gold",
    Planning: "badge-purple",
    Planned: "badge-purple",
  };
  return map[status] || "badge-blue";
}
---

<Layout title={`${planet.title} - ${t("home.title")}`}>
  <Nav />
  <div class="detail-page">
    <div class="container">
      <a href="/planets" class="back-link"
        ><span class="rtl-flip">←</span> {t("planets.backToAll")}</a
      >

      <div class="detail-hero">
        {
          getImageUrl(planet.image, 300, 300) ? (
            <img
              src={getImageUrl(planet.image, 300, 300)!}
              alt={planet.title}
              class="planet-img-large"
            />
          ) : (
            <div class="planet-orb-large" />
          )
        }
        <h1>{planet.title}</h1>
        <p class="tagline">{planet.tagline}</p>
        <span class={`badge ${getStatusBadge(planet.status)}`}
          >{planet.status}</span
        >
      </div>

      <div class="detail-grid">
        <div class="detail-main">
          <h2>{t("planets.overview")}</h2>
          <p class="description">{planet.description}</p>

          {
            missions.length > 0 && (
              <div class="related-section">
                <h2>{t("planets.relatedMissions")}</h2>
                {missions.map((m) => (
                  <a href={`/missions/${m.slug}`} class="related-card">
                    <span class="related-title">{m.title}</span>
                    <span class={`badge ${getStatusBadge(m.status)}`}>
                      {m.status}
                    </span>
                  </a>
                ))}
              </div>
            )
          }
        </div>

        <div class="detail-sidebar">
          <div class="stat-card">
            <h3>{t("planets.planetStats")}</h3>
            <div class="stat-row">
              <span class="stat-label">{t("planets.habitability")}</span>
              <div class="score-bar">
                <div
                  class="score-fill"
                  style={`width: ${planet.habitabilityScore}%`}
                >
                </div>
              </div>
              <span class="stat-value">{planet.habitabilityScore}%</span>
            </div>
            <div class="stat-row">
              <span class="stat-label">{t("planets.distance")}</span>
              <span class="stat-value"
                >{planet.distance} {t("planets.lightYears")}</span
              >
            </div>
            <div class="stat-row">
              <span class="stat-label">{t("planets.gravity")}</span>
              <span class="stat-value">{planet.gravity}</span>
            </div>
            <div class="stat-row">
              <span class="stat-label">{t("planets.atmosphere")}</span>
              <span class="stat-value">{planet.atmosphere}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <Footer />
</Layout>

<style>
  .detail-page {
    position: relative;
    z-index: 1;
    padding: 60px 0 40px;
  }

  .back-link {
    font-size: 0.85rem;
    color: var(--text-muted);
    display: inline-block;
    margin-bottom: 2rem;
    transition: color 0.2s;
  }
  .back-link:hover {
    color: var(--accent);
  }

  .detail-hero {
    text-align: center;
    margin-bottom: 3rem;
  }

  .planet-orb-large {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent-yellow));
    box-shadow: 0 0 50px var(--accent-glow);
    margin: 0 auto 1.5rem;
    animation: float 6s ease-in-out infinite;
  }

  .planet-img-large {
    width: 200px;
    height: 200px;
    object-fit: cover;
    box-shadow: 0 0 50px var(--accent-glow);
    margin: 0 auto 1.5rem;
    animation: float 6s ease-in-out infinite;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .detail-hero h1 {
    font-family: var(--font-title);
    font-size: 2.5rem;
    color: var(--accent);
    text-shadow:
      2px 2px 0 #000,
      0 0 20px var(--accent-glow);
    margin-bottom: 0.5rem;
  }

  .tagline {
    color: var(--text-secondary);
    font-size: 1.1rem;
    font-style: italic;
    margin-bottom: 1rem;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 2rem;
    align-items: start;
  }

  .detail-main h2 {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    color: var(--accent);
    letter-spacing: 1px;
    text-shadow:
      2px 2px 0 #000,
      0 0 20px var(--accent-glow);
    margin-bottom: 1rem;
  }

  .description {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.8;
    margin-bottom: 2rem;
  }

  .stat-card {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 16px;
    padding: 1.5rem;
  }

  .stat-card h3 {
    font-family: var(--font-heading);
    font-size: 1rem;
    margin-bottom: 1.25rem;
    color: var(--accent-yellow);
    letter-spacing: 1px;
  }

  .stat-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border-card);
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .stat-label {
    color: var(--text-muted);
    font-size: 0.85rem;
  }
  .stat-value {
    color: var(--accent);
    font-family: var(--font-title);
    font-size: 0.8rem;
  }

  .score-bar {
    flex: 1;
    max-width: 100px;
    height: 8px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 999px;
    overflow: hidden;
  }

  .score-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--accent-yellow));
    border-radius: 999px;
  }

  .related-section {
    margin-top: 2rem;
  }

  .related-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 16px;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
    transition: all 0.2s;
  }

  .related-card:hover {
    border-color: var(--accent);
    box-shadow: 0 0 40px var(--accent-glow);
    color: var(--text-primary);
  }

  .related-title {
    font-weight: 500;
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    .detail-grid {
      grid-template-columns: 1fr;
    }
    .detail-hero h1 {
      font-size: 2rem;
    }
  }
</style>
