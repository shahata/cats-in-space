---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import MemberProfile from '../../components/MemberProfile';
import CancelSubscription from '../../components/CancelSubscription';
import { members, membersAbout } from '@wix/members';
import type { members as membersTypes } from '@wix/members';
import { orders } from '@wix/pricing-plans';
import { orders as ecomOrders } from '@wix/ecom';
import { getImageUrl } from '../../utils/image';

let member: membersTypes.Member | null = null;
try {
	const res = await members.getCurrentMember({ fieldsets: ['FULL'] });
	member = res.member ?? null;
} catch {}

if (!member) return Astro.redirect(`/api/auth/login?returnToUrl=${encodeURIComponent('/member')}`);

let myOrders: Record<string, any>[] = [];
try {
	const result = await orders.memberListOrders() as { orders?: Record<string, any>[] };
	const today = new Date().toISOString().split('T')[0];
	myOrders = (result.orders || []).filter(o => o.status !== 'DRAFT' && !(o.endDate && new Date(o.endDate as string).toISOString().split('T')[0] < today));
} catch {}

// Fetch member about
let aboutData: { id: string | null; revision: string | null; text: string } = { id: null, revision: null, text: "" };
try {
	const res = await membersAbout.getMyMemberAbout();
	const ma = res.memberAbout;
	if (ma) {
		aboutData.id = ma._id || null;
		aboutData.revision = ma.revision || null;
		const texts: string[] = [];
		for (const node of (ma.content?.nodes || [])) {
			if (node.type === "PARAGRAPH") {
				for (const child of ((node as any).nodes || [])) {
					if (child.type === "TEXT" && child.textData?.text) texts.push(child.textData.text);
				}
			}
		}
		aboutData.text = texts.join("\n");
	}
} catch {}

let storeOrders: Record<string, any>[] = [];
try {
	const result = await ecomOrders.searchOrders({ cursorPaging: { limit: 50 } }) as { orders?: Record<string, any>[] };
	storeOrders = (result.orders || []).filter(o => o.status !== 'INITIALIZED');
} catch {}

const fmtDate = (d: string | Date | null | undefined) => d ? new Date(d as string).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : null;
const statusColors = { APPROVED: '#4caf50', FULFILLED: '#4caf50', CANCELED: '#f44336', PARTIALLY_FULFILLED: '#ff9800', PENDING: '#2196f3' } as const;
type StatusKey = keyof typeof statusColors;

const tabs = [
	{ id: 'profile', label: 'Profile', icon: '&#9734;' },
	{ id: 'personal', label: 'Personal Info', icon: '&#9998;' },
	{ id: 'orders', label: 'Orders', icon: '&#9733;' },
	{ id: 'subscriptions', label: 'Subscriptions', icon: '&#9830;' },
	{ id: 'account', label: 'Account', icon: '&#9881;' },
];
---

<Layout title="My Profile - Cats In Space">
	<Nav />
	<section class="page-header">
		<div class="container">
			<h1 class="section-title">Crew Profile</h1>
			<p class="section-subtitle">Manage your identity aboard the SS Scratching Post</p>
		</div>
	</section>

	<section class="content">
		<div class="container member-layout">
			<nav class="tab-nav">
				{tabs.map((tab) => (
					<a href={`#${tab.id}`} class="tab" data-tab={tab.id}>
						<span class="tab-icon" set:html={tab.icon} />
						<span class="tab-label">{tab.label}</span>
					</a>
				))}
			</nav>

			<div class="tab-panels">
				<div class="tab-panel" id="panel-profile">
					<MemberProfile member={member} aboutData={aboutData} tab="profile" client:load />
				</div>

				<div class="tab-panel" id="panel-personal" style="display:none">
					<MemberProfile member={member} aboutData={aboutData} tab="personal" client:load />
				</div>

				<div class="tab-panel" id="panel-orders" style="display:none">
				{storeOrders.length === 0 ? (
					<div class="empty-subs">
						<p>You haven't placed any orders yet.</p>
						<a href="/store">Browse Store</a>
					</div>
				) : (
					<div class="subs-list">
						{storeOrders.map((sOrder) => {
							const sCurr = sOrder.currency || '';
							const sColor = statusColors[sOrder.fulfillmentStatus as StatusKey] || statusColors[sOrder.status as StatusKey] || '#888';

							return (
								<div class="sub-card">
									<div class="sub-header">
										<div>
											<div class="sub-plan-name">Order #{sOrder.number || sOrder._id?.slice(-8)}</div>
											<div class="sub-plan-desc">{fmtDate(sOrder._createdDate || sOrder.createdDate)}</div>
										</div>
										<div class="sub-badges">
											{sOrder.paymentStatus && (
												<span class="sub-badge" style={`background: ${sOrder.paymentStatus === 'PAID' ? '#4caf50' : '#ff9800'}`}>
													{sOrder.paymentStatus}
												</span>
											)}
											<span class="sub-badge" style={`background: ${sColor}`}>
												{sOrder.fulfillmentStatus || sOrder.status || 'PROCESSING'}
											</span>
										</div>
									</div>

									<div class="order-items">
										{(sOrder.lineItems || []).map((li: any) => (
											<div class="order-item">
												<div class="order-item-img">
													{getImageUrl(li.image?.url, 80, 80) ? (
														<img src={getImageUrl(li.image?.url, 80, 80)!} alt={li.productName?.translated || li.productName?.original} />
													) : (
														<span class="order-item-emoji">&#128049;</span>
													)}
												</div>
												<div class="order-item-info">
													<span class="order-item-name">{li.productName?.translated || li.productName?.original || 'Item'}</span>
													<span class="order-item-qty">x{li.quantity}</span>
												</div>
												<div class="order-item-price">{li.totalPriceAfterTax?.formattedAmount || li.price?.formattedAmount || ''}</div>
											</div>
										))}
									</div>

									<div class="sub-details">
										{sOrder.priceSummary?.total && (
											<div class="sub-detail">
												<span class="sub-detail-label">Total</span>
												<span class="sub-detail-value">{sOrder.priceSummary.total.formattedAmount || `${sCurr}${sOrder.priceSummary.total.amount}`}</span>
											</div>
										)}
										{sOrder.shippingInfo?.logistics?.deliveryTime && (
											<div class="sub-detail">
												<span class="sub-detail-label">Delivery</span>
												<span class="sub-detail-value">{sOrder.shippingInfo.logistics.deliveryTime}</span>
											</div>
										)}
									</div>
								</div>
							);
						})}
					</div>
				)}
			</div>

			<div class="tab-panel" id="panel-subscriptions" style="display:none">
					{myOrders.length === 0 ? (
						<div class="empty-subs">
							<p>You don't have any subscriptions yet.</p>
							<a href="/plans">Browse Plans</a>
						</div>
					) : (
						<div class="subs-list">
							{(myOrders || []).map((order) => {
								const fmt = fmtDate;
								const isFree = parseFloat(order.priceDetails?.planPrice || "0") === 0;
								const curr = order.priceDetails?.currency === 'USD' ? '$' : (order.priceDetails?.currency || '$');
								const planPrice = order.priceDetails?.planPrice || "0";
								const discount = order.priceDetails?.discount && parseFloat(order.priceDetails.discount) > 0 ? order.priceDetails.discount : null;
								const couponCode = order.priceDetails?.coupon?.code;
								const total = order.priceDetails?.total || planPrice;
								const startDate = fmt(order.startDate);
								const endDate = fmt(order.endDate);
								const cancellable = order.status === 'ACTIVE' && !order.autoRenewCanceled;
								const inTrial = order.freeTrialDays && order.currentCycle?.index === 0;
								const nextBilling = fmt(order.currentCycle?.endedDate);
								const sub = order.priceDetails?.subscription;
								const cycleDuration = sub?.cycleDuration;
								const cycleLabel = cycleDuration ? `Every ${cycleDuration.count > 1 ? cycleDuration.count + ' ' : ''}${(cycleDuration.unit || '').toLowerCase()}${cycleDuration.count > 1 ? 's' : ''}` : null;
								const paymentStatus = order.lastPaymentStatus;
								const cancellation = order.cancellation;

								return (
									<div class="sub-card">
										<div class="sub-header">
											<div>
												<div class="sub-plan-name">{order.planName || 'Unknown Plan'}</div>
												{order.planDescription && <div class="sub-plan-desc">{order.planDescription}</div>}
											</div>
											<div class="sub-badges">
												{inTrial && <span class="sub-badge sub-badge-trial">Free Trial</span>}
												<span class:list={['sub-badge', `sub-badge-${order.autoRenewCanceled ? 'canceling' : (order.status || 'unknown').toLowerCase()}`]}>
													{order.autoRenewCanceled ? 'Canceling' : order.status}
												</span>
											</div>
										</div>

										<div class="sub-details">
											<div class="sub-detail">
												<span class="sub-detail-label">Price</span>
												<span class="sub-detail-value">
													{isFree ? 'Free' : `${curr}${planPrice}`}
													{cycleLabel && !isFree && <span class="sub-cycle"> / {cycleLabel.replace('Every ', '')}</span>}
												</span>
											</div>
											{discount && (
												<div class="sub-detail">
													<span class="sub-detail-label">Discount</span>
													<span class="sub-detail-value sub-discount">-{curr}{discount}{couponCode && ` (${couponCode})`}</span>
												</div>
											)}
											{discount && (
												<div class="sub-detail">
													<span class="sub-detail-label">Total Paid</span>
													<span class="sub-detail-value">{curr}{total}</span>
												</div>
											)}
											{inTrial && order.freeTrialDays && (
												<div class="sub-detail">
													<span class="sub-detail-label">Trial</span>
													<span class="sub-detail-value">{order.freeTrialDays} days</span>
												</div>
											)}
											<div class="sub-detail">
												<span class="sub-detail-label">Started</span>
												<span class="sub-detail-value">{startDate || '—'}</span>
											</div>
											{nextBilling && order.status === 'ACTIVE' && !order.autoRenewCanceled && (
												<div class="sub-detail">
													<span class="sub-detail-label">Next Billing</span>
													<span class="sub-detail-value">{nextBilling}</span>
												</div>
											)}
											{endDate && (
												<div class="sub-detail">
													<span class="sub-detail-label">{order.status === 'CANCELED' || order.autoRenewCanceled ? 'Expires' : 'Ends'}</span>
													<span class="sub-detail-value">{endDate}</span>
												</div>
											)}
											{order.currentCycle && order.currentCycle.index > 0 && (
												<div class="sub-detail">
													<span class="sub-detail-label">Billing Cycle</span>
													<span class="sub-detail-value">#{order.currentCycle.index}</span>
												</div>
											)}
											{paymentStatus && (
												<div class="sub-detail">
													<span class="sub-detail-label">Last Payment</span>
													<span class:list={['sub-detail-value', { 'sub-payment-paid': paymentStatus === 'PAID', 'sub-payment-unpaid': paymentStatus === 'UNPAID' || paymentStatus === 'FAILED' }]}>
														{paymentStatus === 'PAID' ? 'Paid' : paymentStatus === 'NOT_APPLICABLE' ? 'N/A' : paymentStatus}
													</span>
												</div>
											)}
										</div>

										{cancellation && (
											<div class="sub-cancellation">
												<span class="sub-detail-label">Cancellation</span>
												<span class="sub-detail-value">
													{cancellation.cause === 'OWNER_ACTION' ? 'Canceled by you' : cancellation.cause === 'UNDEFINED' ? 'Canceled' : cancellation.cause}
													{cancellation.requestedDate && ` on ${fmt(cancellation.requestedDate)}`}
													{cancellation.effectiveAt === 'NEXT_PAYMENT_DATE' && ' — active until next billing date'}
													{cancellation.effectiveAt === 'IMMEDIATELY' && ' — effective immediately'}
												</span>
											</div>
										)}

										{order.pausePeriods?.length > 0 && (
											<div class="sub-pauses">
												<span class="sub-detail-label">Pause History</span>
												{order.pausePeriods.map((p: any) => (
													<span class="sub-detail-value">
														{fmt(String(p.pauseDate))} — {p.resumeDate ? fmt(String(p.resumeDate)) : 'ongoing'}
													</span>
												))}
											</div>
										)}

										{cancellable && (
											<div class="sub-footer">
												<CancelSubscription orderId={order._id!} client:load />
											</div>
										)}
									</div>
								);
							})}
						</div>
					)}
				</div>

				<div class="tab-panel" id="panel-account" style="display:none">
					<MemberProfile member={member} aboutData={aboutData} tab="account" client:load />
				</div>
			</div>
		</div>
	</section>
	<Footer />
</Layout>

<script>
	function activateTab(tabId: string) {
		document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
		document.querySelectorAll('.tab-panel').forEach(p => (p as HTMLElement).style.display = 'none');

		const tab = document.querySelector(`.tab[data-tab="${tabId}"]`);
		const panel = document.getElementById(`panel-${tabId}`);
		if (tab) tab.classList.add('active');
		if (panel) panel.style.display = 'block';
	}

	function onHashChange() {
		const hash = window.location.hash.replace('#', '') || 'profile';
		activateTab(hash);
	}

	document.querySelectorAll('.tab').forEach(tab => {
		tab.addEventListener('click', (e) => {
			e.preventDefault();
			const tabId = (tab as HTMLElement).dataset.tab!;
			window.location.hash = tabId;
		});
	});

	window.addEventListener('hashchange', onHashChange);
	onHashChange();
</script>

<style>
	.page-header {
		padding: 60px 0 40px;
	}

	.content {
		padding-bottom: 60px;
	}


	/* Tab navigation */
	.tab-nav {
		display: flex;
		gap: 2px;
		margin-bottom: 32px;
		background: var(--bg-card);
		border: 1px solid var(--border-card);
		border-radius: 12px;
		padding: 6px;
	}

	.tab {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		padding: 10px 12px;
		font-family: var(--font-heading);
		font-size: 0.8rem;
		letter-spacing: 1px;
		color: var(--text-muted);
		text-decoration: none;
		border-radius: 8px;
		transition: all 0.2s;
		cursor: pointer;
	}

	.tab:hover {
		color: var(--text-secondary);
		background: rgba(255, 255, 255, 0.03);
	}

	.tab.active {
		color: #000;
		background: var(--accent);
	}

	.tab-icon {
		font-size: 1rem;
	}

	/* Subscriptions */
	.empty-subs {
		padding: 30px;
		background: var(--bg-card);
		border: 1px solid var(--border-card);
		border-radius: 12px;
		text-align: center;
	}

	.empty-subs p {
		color: var(--text-muted);
		margin-bottom: 12px;
	}

	.empty-subs a {
		color: var(--accent);
		font-family: var(--font-heading);
		font-size: 0.9rem;
		letter-spacing: 1px;
	}

	.sub-card {
		background: var(--bg-card);
		border: 1px solid var(--border-card);
		border-radius: 12px;
		padding: 24px;
		margin-bottom: 16px;
	}

	.sub-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 16px;
		gap: 12px;
	}

	.sub-plan-name {
		font-family: var(--font-heading);
		font-size: 1.2rem;
		color: var(--accent-yellow);
		letter-spacing: 1px;
	}

	.sub-plan-desc {
		font-size: 0.8rem;
		color: var(--text-muted);
		margin-top: 4px;
		line-height: 1.4;
	}

	.sub-badge {
		font-size: 0.7rem;
		font-family: var(--font-heading);
		letter-spacing: 1px;
		padding: 4px 12px;
		border-radius: 12px;
		color: #000;
		white-space: nowrap;
		flex-shrink: 0;
	}

	.sub-badge-active { background: #4caf50; }
	.sub-badge-canceled { background: #f44336; }
	.sub-badge-ended { background: #888; }
	.sub-badge-paused, .sub-badge-canceling { background: #ff9800; }
	.sub-badge-pending { background: #2196f3; }

	.sub-details {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		padding-top: 12px;
		border-top: 1px solid #222;
	}

	.sub-detail {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.sub-detail-label {
		font-size: 0.65rem;
		color: #666;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	.sub-detail-value {
		font-size: 0.85rem;
		color: var(--text-secondary);
	}

	.sub-badges {
		display: flex;
		gap: 6px;
		flex-shrink: 0;
	}

	.sub-badge-trial {
		background: #9c27b0;
	}

	.sub-cycle {
		font-size: 0.7rem;
		color: var(--text-muted);
	}

	.sub-discount {
		color: #4caf50;
	}

	.sub-payment-paid {
		color: #4caf50;
	}

	.sub-payment-unpaid {
		color: #f44336;
	}

	.sub-cancellation,
	.sub-pauses {
		margin-top: 12px;
		padding-top: 12px;
		border-top: 1px solid #222;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.sub-footer {
		margin-top: 16px;
		padding-top: 12px;
		border-top: 1px solid #222;
	}

	/* Order items */
	.order-items {
		display: flex;
		flex-direction: column;
		gap: 8px;
		margin-bottom: 12px;
	}

	.order-item {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 8px 0;
	}

	.order-item-img {
		width: 40px;
		height: 40px;
		border-radius: 6px;
		overflow: hidden;
		background: #1a1a2e;
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.order-item-img img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.order-item-emoji {
		font-size: 1.2rem;
	}

	.order-item-info {
		flex: 1;
		min-width: 0;
	}

	.order-item-name {
		display: block;
		font-size: 0.8rem;
		color: var(--text-primary);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.order-item-qty {
		font-size: 0.7rem;
		color: var(--text-muted);
	}

	.order-item-price {
		font-size: 0.8rem;
		color: var(--accent-yellow);
		font-weight: 600;
		flex-shrink: 0;
	}

	@media (max-width: 640px) {
		.tab-nav {
			flex-wrap: wrap;
		}

		.tab {
			font-size: 0.7rem;
			padding: 8px 6px;
		}

		.tab-label {
			display: none;
		}

		.tab-icon {
			font-size: 1.2rem;
		}
	}
</style>
