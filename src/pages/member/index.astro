---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import MemberProfile from '../../components/MemberProfile';
import CancelSubscription from '../../components/CancelSubscription';
import { members, membersAbout } from '@wix/members';
import { orders } from '@wix/pricing-plans';

let member: any = null;
try {
	const res = await members.getCurrentMember({ fieldsets: ['FULL'] });
	member = res.member;
} catch {}

if (!member) return Astro.redirect(`/api/auth/login?returnToUrl=${encodeURIComponent('/member')}`);

let myOrders: any[] = [];
try {
	const result = await orders.memberListOrders();
	myOrders = result.orders || [];
} catch {}

// Fetch member about
let aboutData: { id: string | null; revision: string | null; text: string } = { id: null, revision: null, text: "" };
try {
	const res = await membersAbout.getMyMemberAbout();
	const ma = res.memberAbout;
	if (ma) {
		aboutData.id = ma._id || null;
		aboutData.revision = ma.revision || null;
		const texts: string[] = [];
		for (const node of (ma.content?.nodes || [])) {
			if (node.type === "PARAGRAPH") {
				for (const child of ((node as any).nodes || [])) {
					if (child.type === "TEXT" && child.textData?.text) texts.push(child.textData.text);
				}
			}
		}
		aboutData.text = texts.join("\n");
	}
} catch {}

const tabs = [
	{ id: 'profile', label: 'Profile', icon: '&#9734;' },
	{ id: 'personal', label: 'Personal Info', icon: '&#9998;' },
	{ id: 'subscriptions', label: 'Subscriptions', icon: '&#9830;' },
	{ id: 'account', label: 'Account', icon: '&#9881;' },
];
---

<Layout title="My Profile - Cats In Space">
	<Nav />
	<section class="page-header">
		<div class="container">
			<h1 class="section-title">Crew Profile</h1>
			<p class="section-subtitle">Manage your identity aboard the SS Scratching Post</p>
		</div>
	</section>

	<section class="content">
		<div class="container member-layout">
			<nav class="tab-nav">
				{tabs.map((tab) => (
					<a href={`#${tab.id}`} class="tab" data-tab={tab.id}>
						<span class="tab-icon" set:html={tab.icon} />
						<span class="tab-label">{tab.label}</span>
					</a>
				))}
			</nav>

			<div class="tab-panels">
				<div class="tab-panel" id="panel-profile">
					<MemberProfile member={member} aboutData={aboutData} tab="profile" client:load />
				</div>

				<div class="tab-panel" id="panel-personal" style="display:none">
					<MemberProfile member={member} aboutData={aboutData} tab="personal" client:load />
				</div>

				<div class="tab-panel" id="panel-subscriptions" style="display:none">
					{myOrders.length === 0 ? (
						<div class="empty-subs">
							<p>You don't have any subscriptions yet.</p>
							<a href="/plans">Browse Plans</a>
						</div>
					) : (
						<div class="subs-list">
							{myOrders.map((order: any) => {
								const isFree = parseFloat(order.priceDetails?.planPrice || "0") === 0;
								const currency = order.priceDetails?.currency || "USD";
								const planPrice = order.priceDetails?.planPrice || "0";
								const startDate = order.startDate ? new Date(order.startDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : '—';
								const endDate = order.endDate ? new Date(order.endDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : null;
								const cancellable = order.status === 'ACTIVE' && !order.autoRenewCanceled;

								return (
									<div class="sub-card">
										<div class="sub-header">
											<div>
												<div class="sub-plan-name">{order.planName || 'Unknown Plan'}</div>
												{order.planDescription && <div class="sub-plan-desc">{order.planDescription}</div>}
											</div>
											<span class:list={['sub-badge', `sub-badge-${order.autoRenewCanceled ? 'canceling' : (order.status || 'unknown').toLowerCase()}`]}>
												{order.autoRenewCanceled ? 'Canceling' : order.status}
											</span>
										</div>
										<div class="sub-details">
											<div class="sub-detail">
												<span class="sub-detail-label">Price</span>
												<span class="sub-detail-value">{isFree ? 'Free' : `${currency === 'USD' ? '$' : currency}${planPrice}`}</span>
											</div>
											<div class="sub-detail">
												<span class="sub-detail-label">Started</span>
												<span class="sub-detail-value">{startDate}</span>
											</div>
											{endDate && (
												<div class="sub-detail">
													<span class="sub-detail-label">Ends</span>
													<span class="sub-detail-value">{endDate}</span>
												</div>
											)}
											{order.currentCycle && (
												<div class="sub-detail">
													<span class="sub-detail-label">Cycle</span>
													<span class="sub-detail-value">#{order.currentCycle.index}</span>
												</div>
											)}
											<div class="sub-detail">
												<span class="sub-detail-label">Type</span>
												<span class="sub-detail-value">{order.type === 'ONLINE' ? 'Online' : order.type === 'OFFLINE' ? 'Offline' : order.type}</span>
											</div>
										</div>
										{cancellable && (
											<div class="sub-footer">
												<CancelSubscription orderId={order._id} client:load />
											</div>
										)}
									</div>
								);
							})}
						</div>
					)}
				</div>

				<div class="tab-panel" id="panel-account" style="display:none">
					<MemberProfile member={member} aboutData={aboutData} tab="account" client:load />
				</div>
			</div>
		</div>
	</section>
	<Footer />
</Layout>

<script>
	function activateTab(tabId: string) {
		document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
		document.querySelectorAll('.tab-panel').forEach(p => (p as HTMLElement).style.display = 'none');

		const tab = document.querySelector(`.tab[data-tab="${tabId}"]`);
		const panel = document.getElementById(`panel-${tabId}`);
		if (tab) tab.classList.add('active');
		if (panel) panel.style.display = 'block';
	}

	function onHashChange() {
		const hash = window.location.hash.replace('#', '') || 'profile';
		activateTab(hash);
	}

	document.querySelectorAll('.tab').forEach(tab => {
		tab.addEventListener('click', (e) => {
			e.preventDefault();
			const tabId = (tab as HTMLElement).dataset.tab!;
			window.location.hash = tabId;
		});
	});

	window.addEventListener('hashchange', onHashChange);
	onHashChange();
</script>

<style>
	.page-header {
		padding: 60px 0 40px;
	}

	.content {
		padding-bottom: 60px;
	}

	/* Tab navigation */
	.tab-nav {
		display: flex;
		gap: 2px;
		margin-bottom: 32px;
		background: var(--bg-card);
		border: 1px solid var(--border-card);
		border-radius: 12px;
		padding: 6px;
		max-width: 600px;
	}

	.tab {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		padding: 10px 12px;
		font-family: var(--font-heading);
		font-size: 0.8rem;
		letter-spacing: 1px;
		color: var(--text-muted);
		text-decoration: none;
		border-radius: 8px;
		transition: all 0.2s;
		cursor: pointer;
	}

	.tab:hover {
		color: var(--text-secondary);
		background: rgba(255, 255, 255, 0.03);
	}

	.tab.active {
		color: #000;
		background: var(--accent);
	}

	.tab-icon {
		font-size: 1rem;
	}

	.tab-panels {
		max-width: 600px;
	}

	/* Subscriptions */
	.empty-subs {
		padding: 30px;
		background: var(--bg-card);
		border: 1px solid var(--border-card);
		border-radius: 12px;
		text-align: center;
	}

	.empty-subs p {
		color: var(--text-muted);
		margin-bottom: 12px;
	}

	.empty-subs a {
		color: var(--accent);
		font-family: var(--font-heading);
		font-size: 0.9rem;
		letter-spacing: 1px;
	}

	.sub-card {
		background: var(--bg-card);
		border: 1px solid var(--border-card);
		border-radius: 12px;
		padding: 24px;
		margin-bottom: 16px;
	}

	.sub-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 16px;
		gap: 12px;
	}

	.sub-plan-name {
		font-family: var(--font-heading);
		font-size: 1.2rem;
		color: var(--accent-yellow);
		letter-spacing: 1px;
	}

	.sub-plan-desc {
		font-size: 0.8rem;
		color: var(--text-muted);
		margin-top: 4px;
		line-height: 1.4;
	}

	.sub-badge {
		font-size: 0.7rem;
		font-family: var(--font-heading);
		letter-spacing: 1px;
		padding: 4px 12px;
		border-radius: 12px;
		color: #000;
		white-space: nowrap;
		flex-shrink: 0;
	}

	.sub-badge-active { background: #4caf50; }
	.sub-badge-canceled { background: #f44336; }
	.sub-badge-ended { background: #888; }
	.sub-badge-paused, .sub-badge-canceling { background: #ff9800; }
	.sub-badge-pending { background: #2196f3; }

	.sub-details {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		padding-top: 12px;
		border-top: 1px solid #222;
	}

	.sub-detail {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.sub-detail-label {
		font-size: 0.65rem;
		color: #666;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	.sub-detail-value {
		font-size: 0.85rem;
		color: var(--text-secondary);
	}

	.sub-footer {
		margin-top: 16px;
		padding-top: 12px;
		border-top: 1px solid #222;
	}

	@media (max-width: 640px) {
		.tab-nav {
			flex-wrap: wrap;
		}

		.tab {
			font-size: 0.7rem;
			padding: 8px 6px;
		}

		.tab-label {
			display: none;
		}

		.tab-icon {
			font-size: 1.2rem;
		}
	}
</style>
