---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import MemberProfile from '../../components/MemberProfile';
import MemberSubscriptions from '../../components/MemberSubscriptions';
import { members } from '@wix/members';

let member: any = null;
try {
	const res = await members.getCurrentMember({ fieldsets: ['FULL'] });
	member = res.member;
} catch {}

if (!member) return Astro.redirect('/api/auth/login');
---

<Layout title="My Profile - Cats In Space">
	<Nav />
	<section class="page-header">
		<div class="container">
			<h1 class="section-title">Crew Profile</h1>
			<p class="section-subtitle">Manage your identity aboard the SS Scratching Post</p>
		</div>
	</section>

	<section class="content">
		<div class="container">
			<MemberProfile member={member} client:load />

			<div class="subscriptions-section">
				<h2 class="section-title subscriptions-title">My Subscriptions</h2>
				<p class="section-subtitle">Your active plans and membership history</p>
				<MemberSubscriptions client:load />
			</div>
		</div>
	</section>
	<Footer />
</Layout>

<style>
	.page-header {
		padding: 60px 0 40px;
	}

	.content {
		padding-bottom: 60px;
	}

	.subscriptions-section {
		margin-top: 48px;
		max-width: 600px;
	}

	.subscriptions-title {
		font-size: 1.5rem !important;
		margin-bottom: 4px;
	}
</style>
