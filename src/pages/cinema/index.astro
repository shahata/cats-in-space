---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { wixEventsV2 } from '@wix/events';
import { auth, i18n } from '@wix/essentials';
import { getImageUrl } from '../../utils/image';

const t = i18n.getTranslationFunction();

const elevatedQuery = auth.elevate(wixEventsV2.queryEvents);
const eventsResult = await elevatedQuery().ne('status', 'CANCELED').limit(20).find();
const events = eventsResult.items || [];

const now = new Date();

function getSlug(event: Record<string, any>): string {
	return event.slug || event.title?.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') || event._id;
}

function getEventImage(event: Record<string, any>): string | null {
	return getImageUrl(event.mainImage?.url || event.mainImage, 480, 680);
}

function isComingSoon(event: Record<string, any>): boolean {
	const start = event.scheduling?.startDate || event.dateAndTimeSettings?.startDate;
	if (!start) return false;
	return new Date(start) > now;
}

function getNextShowtime(event: Record<string, any>): string | null {
	const start = event.scheduling?.startDate || event.dateAndTimeSettings?.startDate;
	if (!start) return null;
	return new Date(start).toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
}

function extractGenres(event: Record<string, any>): string[] {
	const cats = event.categories?.map((c: any) => c.name || c) || [];
	if (cats.length > 0) return cats;
	const desc: string = event.description || '';
	const genreMap = ['Action', 'Comedy', 'Drama', 'Horror', 'Sci-Fi', 'Fantasy', 'Thriller', 'Romance', 'Animation', 'Documentary'];
	return genreMap.filter(g => desc.toLowerCase().includes(g.toLowerCase()));
}

function genreBadgeClass(genre: string): string {
	const map: Record<string, string> = {
		'action': 'genre-action', 'comedy': 'genre-comedy', 'drama': 'genre-drama',
		'horror': 'genre-horror', 'sci-fi': 'genre-scifi', 'fantasy': 'genre-fantasy',
	};
	return map[genre.toLowerCase()] || 'genre-default';
}

---

<Layout title={`${t('cinema.pageTitle')} - ${t('home.title')}`}>
	<Nav />

	<section class="cinema-hero">
		<div class="hero-glow"></div>
		<div class="container hero-content">
			<h1 class="section-title">{t('cinema.pageTitle')}</h1>
			<p class="section-subtitle">{t('cinema.pageSubtitle')}</p>
		</div>
	</section>

	<section class="cinema-content">
		<div class="container">
			<div class="filter-tabs" id="filter-tabs">
				<button class="filter-tab active" data-filter="all">{t('cinema.allMovies')}</button>
				<button class="filter-tab" data-filter="now">{t('cinema.nowShowing')}</button>
				<button class="filter-tab" data-filter="soon">{t('cinema.comingSoon')}</button>
			</div>

			{events.length === 0 && (
				<p class="no-movies">{t('cinema.noMovies')}</p>
			)}

			<div class="movies-grid" id="movies-grid">
				{events.map((event) => {
					const slug = getSlug(event);
					const img = getEventImage(event);
					const genres = extractGenres(event);
					const showtime = getNextShowtime(event);
					const coming = isComingSoon(event);
					return (
						<a href={`/cinema/${slug}`} class="movie-card" data-category={coming ? 'soon' : 'now'}>
							<div class="movie-poster">
								{img ? (
									<img src={img} alt={event.title} loading="lazy" />
								) : (
									<div class="poster-placeholder">
										<span class="poster-icon">&#9733;</span>
									</div>
								)}
								{coming && <span class="coming-badge">{t('cinema.comingSoon')}</span>}
								<div class="poster-overlay">
									<span class="play-icon">&#9654;</span>
								</div>
							</div>
							<div class="movie-info">
								<h3 class="movie-title">{event.title}</h3>
								<div class="movie-genres">
									{genres.slice(0, 3).map(g => (
										<span class={`genre-badge ${genreBadgeClass(g)}`}>{g}</span>
									))}
								</div>
								{showtime && (
									<div class="movie-showtime">
										<span class="showtime-label">{t('cinema.showtime')}:</span> {showtime}
									</div>
								)}
							</div>
						</a>
					);
				})}
			</div>
		</div>
	</section>

	<Footer />
</Layout>

<script>
	const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
	const cards = document.querySelectorAll<HTMLElement>('.movie-card');

	tabs.forEach(tab => {
		tab.addEventListener('click', () => {
			tabs.forEach(t => t.classList.remove('active'));
			tab.classList.add('active');
			const filter = tab.dataset.filter;
			cards.forEach(card => {
				if (filter === 'all') {
					card.style.display = '';
				} else {
					card.style.display = card.dataset.category === filter ? '' : 'none';
				}
			});
		});
	});
</script>

<style>
	.cinema-hero {
		position: relative;
		padding: 100px 20px 60px;
		text-align: center;
		background: linear-gradient(180deg, #1a0a00 0%, var(--bg-primary) 100%);
		overflow: hidden;
	}

	.hero-glow {
		position: absolute;
		top: -100px;
		left: 50%;
		transform: translateX(-50%);
		width: 600px;
		height: 400px;
		background: radial-gradient(ellipse, rgba(255, 102, 0, 0.15) 0%, transparent 70%);
		pointer-events: none;
	}

	.hero-content {
		position: relative;
		z-index: 1;
	}

	.cinema-content {
		padding: 0 20px 80px;
	}

	.filter-tabs {
		display: flex;
		gap: 8px;
		margin-bottom: 40px;
		justify-content: center;
	}

	.filter-tab {
		padding: 10px 24px;
		border-radius: 8px;
		border: 1px solid var(--border-card);
		background: var(--bg-card);
		color: var(--text-secondary);
		font-family: var(--font-heading);
		font-size: 0.95rem;
		letter-spacing: 1px;
		cursor: pointer;
		transition: all 0.2s;
	}

	.filter-tab:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.filter-tab.active {
		background: var(--accent);
		color: #000;
		border-color: var(--accent);
	}

	.no-movies {
		text-align: center;
		color: var(--text-muted);
		font-size: 1.1rem;
		padding: 60px 0;
	}

	.movies-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 28px;
	}

	.movie-card {
		display: block;
		background: var(--bg-card);
		border: 1px solid var(--border-card);
		border-radius: 12px;
		overflow: hidden;
		transition: all 0.3s;
		color: var(--text-primary);
	}

	.movie-card:hover {
		transform: translateY(-6px);
		border-color: var(--accent);
		box-shadow: 0 8px 40px rgba(255, 102, 0, 0.2), 0 0 80px rgba(255, 102, 0, 0.08);
		color: var(--text-primary);
	}

	.movie-poster {
		position: relative;
		aspect-ratio: 2 / 3;
		overflow: hidden;
		background: #111;
	}

	.movie-poster img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s;
	}

	.movie-card:hover .movie-poster img {
		transform: scale(1.05);
	}

	.poster-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, #1a1a2e 0%, #0a0a0a 100%);
	}

	.poster-icon {
		font-size: 3rem;
		color: var(--accent);
		opacity: 0.4;
	}

	.poster-overlay {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.6);
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		transition: opacity 0.3s;
	}

	.movie-card:hover .poster-overlay {
		opacity: 1;
	}

	.play-icon {
		font-size: 2.5rem;
		color: var(--accent);
		filter: drop-shadow(0 0 20px rgba(255, 102, 0, 0.6));
	}

	.coming-badge {
		position: absolute;
		top: 12px;
		left: 12px;
		background: var(--accent-yellow);
		color: #000;
		font-family: var(--font-heading);
		font-size: 0.7rem;
		letter-spacing: 1px;
		padding: 4px 10px;
		border-radius: 4px;
	}

	.movie-info {
		padding: 16px;
	}

	.movie-title {
		font-family: var(--font-heading);
		font-size: 1.2rem;
		color: var(--accent-yellow);
		letter-spacing: 1px;
		margin-bottom: 8px;
		line-height: 1.3;
	}

	.movie-genres {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-bottom: 10px;
	}

	.genre-badge {
		padding: 2px 8px;
		border-radius: 4px;
		font-size: 0.65rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.genre-action { background: #cc0000; color: #fff; }
	.genre-comedy { background: #2e7d32; color: #fff; }
	.genre-drama { background: #1565c0; color: #fff; }
	.genre-horror { background: #6a1b9a; color: #fff; }
	.genre-scifi { background: #00838f; color: #fff; }
	.genre-fantasy { background: #c6a700; color: #000; }
	.genre-default { background: #444; color: #e0e0e0; }

	.movie-showtime {
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	.showtime-label {
		color: var(--accent);
		font-weight: 600;
	}

	@media (max-width: 600px) {
		.movies-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 16px;
		}

		.filter-tabs {
			flex-wrap: wrap;
		}
	}
</style>
