---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { i18n } from '@wix/essentials';

const t = i18n.getTranslationFunction();
---

<Layout title={`${t('cinema.thankYouTitle')} - ${t('home.title')}`}>
	<Nav />
	<section class="thank-you">
		<div class="container">
			<div class="ty-hero">
				<div class="ty-projector">
					<div class="ty-beam"></div>
					<div class="ty-screen-icon">&#9733;</div>
				</div>
				<h1 class="section-title">{t('cinema.thankYouTitle')}</h1>
				<p class="ty-subtitle">{t('cinema.thankYouSubtitle')}</p>
			</div>
			<div class="ty-actions">
				<a href="/cinema" class="ty-btn ty-btn-primary">{t('cinema.backToMovies').replace('← ', '')}</a>
			</div>
		</div>
	</section>
	<Footer />
</Layout>

<style>
	.thank-you {
		padding: 80px 0;
		min-height: 60vh;
		display: flex;
		align-items: center;
	}

	.ty-hero {
		text-align: center;
		margin-bottom: 40px;
	}

	.ty-projector {
		position: relative;
		margin: 0 auto 32px;
		width: 120px;
		height: 120px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.ty-beam {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(255, 102, 0, 0.2) 0%, transparent 70%);
		animation: pulse-glow 2s ease-in-out infinite;
	}

	.ty-screen-icon {
		position: relative;
		z-index: 1;
		font-size: 3.5rem;
		color: var(--accent-yellow);
		filter: drop-shadow(0 0 20px rgba(255, 204, 0, 0.5));
	}

	@keyframes pulse-glow {
		0%, 100% { transform: scale(1); opacity: 1; }
		50% { transform: scale(1.3); opacity: 0.6; }
	}

	.ty-subtitle {
		color: var(--text-secondary);
		font-size: 1.1rem;
		margin-top: 12px;
		max-width: 500px;
		margin-left: auto;
		margin-right: auto;
	}

	.ty-actions {
		display: flex;
		gap: 12px;
		justify-content: center;
	}

	.ty-btn {
		padding: 12px 32px;
		border-radius: 8px;
		font-family: var(--font-heading);
		font-size: 1rem;
		letter-spacing: 1.5px;
		text-decoration: none;
		transition: all 0.2s;
	}

	.ty-btn-primary {
		background: var(--accent);
		color: #000;
	}

	.ty-btn-primary:hover {
		background: #ff8533;
		color: #000;
		transform: translateY(-2px);
		box-shadow: 0 0 20px var(--accent-glow);
	}
</style>
