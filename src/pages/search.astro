---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { siteSearch } from "@wix/search";
import { i18n } from "@wix/essentials";
import { getImageUrl } from "../utils/image";

const t = i18n.getTranslationFunction();
const language = i18n.getLanguage();
const rawQuery = Astro.url.searchParams.get("q") ?? "";
const q = rawQuery.trim();

interface SearchResult {
  title: string;
  description: string;
  href: string;
  image: string | null;
}

interface SearchGroup {
  label: string;
  type: string;
  badgeClass: string;
  results: SearchResult[];
}

// Map document type strings returned by federatedSearch to UI metadata,
// plus a rewriter that converts the Wix-rendered URL the search index
// stores (e.g. /product-page/<slug>) to this Astro project's routes.
interface TypeMeta {
  label: string;
  badgeClass: string;
  rewriteUrl: (url: string) => string | null;
}

function lastSlug(url: string): string {
  const parts = url.split("/").filter(Boolean);
  return parts[parts.length - 1] ?? "";
}

const typeMeta: Record<string, TypeMeta> = {
  "public/stores/products": {
    label: t("nav.store"),
    badgeClass: "badge-green",
    rewriteUrl: (u) => `/store/${lastSlug(u)}`,
  },
  "public/blog/posts": {
    label: t("nav.blog"),
    badgeClass: "badge-pink",
    rewriteUrl: (u) => `/blog/${lastSlug(u)}`,
  },
  "public/bookings/services": {
    label: t("nav.bookings"),
    badgeClass: "badge-blue",
    rewriteUrl: (u) => `/bookings/${lastSlug(u)}`,
  },
  "public/events/events": {
    label: t("nav.cinema"),
    badgeClass: "badge-gold",
    // Strip Wix's recurring-showtime datetime suffix from the slug so all
    // showtimes for a movie collapse to one Astro /cinema/<series-slug>.
    rewriteUrl: (u) =>
      `/cinema/${lastSlug(u).replace(/-\d{4}-\d{2}-\d{2}-\d{2}-\d{2}(-\d+)?$/, "")}`,
  },
};

type DocData = Record<string, unknown>;

function pickStr(doc: DocData, ...keys: string[]): string {
  for (const k of keys) {
    const v = doc[k];
    if (typeof v === "string" && v) return v;
  }
  return "";
}

function docImage(doc: DocData): string | null {
  const di = doc.documentImage as { name?: string } | undefined;
  if (!di?.name) return null;
  // documentImage.name is either a wix media id ("4975b6_xxx~mv2.png") or
  // a full https URL (blog posts ship the latter); pass through accordingly.
  if (di.name.startsWith("http")) return di.name;
  return getImageUrl(`wix:image://v1/${di.name}/file.jpg`, 200, 200);
}

function toResults(
  documentType: string,
  docs: Record<string, unknown>[],
): SearchResult[] {
  const meta = typeMeta[documentType];
  if (!meta) return []; // skip doc types this Astro project has no routes for
  const out: SearchResult[] = [];
  const seenHrefs = new Set<string>();
  for (const d of docs) {
    const title = pickStr(d, "title", "name");
    if (!title) continue;
    const sourceUrl = pickStr(d, "url");
    if (!sourceUrl) continue;
    const href = meta.rewriteUrl(sourceUrl);
    if (!href) continue;
    if (seenHrefs.has(href)) continue;
    seenHrefs.add(href);
    out.push({
      title,
      description: pickStr(
        d,
        "description",
        "excerpt",
        "shortDescription",
        "tagLine",
      ).slice(0, 200),
      href,
      image: docImage(d),
    });
  }
  return out;
}

const groups: SearchGroup[] = [];
if (q) {
  try {
    const res = await siteSearch.federatedSearch({
      query: q,
      language,
      limit: 20,
      fuzzy: true,
    });
    for (const bucket of res.results ?? []) {
      const docType = bucket.documentType ?? "";
      const meta = typeMeta[docType];
      if (!meta) continue;
      const results = toResults(docType, bucket.documents ?? []);
      if (results.length === 0) continue;
      groups.push({
        type: docType,
        label: meta.label,
        badgeClass: meta.badgeClass,
        results,
      });
    }
  } catch (err) {
    console.error("[search] federatedSearch failed:", err);
  }
}

const totalResults = groups.reduce((sum, g) => sum + g.results.length, 0);
---

<Layout
  title={q
    ? `${t("search.resultsFor", { query: q })} - ${t("home.title")}`
    : `${t("search.pageTitle")} - ${t("home.title")}`}
>
  <Nav />

  <section class="page-header">
    <div class="container">
      <h1 class="section-title">{t("search.pageTitle")}</h1>
      <form class="search-form" method="GET" action="/search" role="search">
        <input
          type="search"
          name="q"
          value={q}
          placeholder={t("search.placeholder")}
          aria-label={t("search.placeholder")}
          class="search-input"
          autofocus
        />
        <button type="submit" class="search-submit">{t("search.go")}</button>
      </form>
    </div>
  </section>

  <section class="content">
    <div class="container">
      {!q && <p class="empty-message">{t("search.enterTerm")}</p>}

      {
        q && totalResults === 0 && (
          <p class="empty-message">{t("search.noResults", { query: q })}</p>
        )
      }

      {
        q && totalResults > 0 && (
          <p class="results-summary">
            {t("search.resultsCount", {
              count: String(totalResults),
              query: q,
            })}
          </p>
        )
      }

      {
        q &&
          groups
            .filter((g) => g.results.length > 0)
            .map((g) => (
              <div class="result-group">
                <h2 class="group-title">{g.label}</h2>
                <div class="result-list">
                  {g.results.map((r) => (
                    <a href={r.href} class="result-card">
                      {r.image ? (
                        <img src={r.image} alt={r.title} class="result-img" />
                      ) : (
                        <div class="result-placeholder">★</div>
                      )}
                      <div class="result-body">
                        <span class={`badge ${g.badgeClass}`}>{g.label}</span>
                        <h3 class="result-title">{r.title}</h3>
                        {r.description && (
                          <p class="result-desc">{r.description}</p>
                        )}
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            ))
      }
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .page-header {
    padding: 60px 20px 40px;
    background: linear-gradient(135deg, #1a0a00 0%, #0a0a0a 50%, #000a1a 100%);
    text-align: center;
  }

  .search-form {
    display: flex;
    gap: 12px;
    max-width: 600px;
    margin: 24px auto 0;
    flex-wrap: wrap;
  }

  .search-input {
    flex: 1;
    min-width: 0;
    padding: 14px 18px;
    border-radius: 8px;
    border: 1px solid var(--border-card);
    background: rgba(0, 0, 0, 0.4);
    color: var(--text-primary);
    font-size: 1rem;
    font-family: var(--font-body);
  }

  .search-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 12px var(--accent-glow);
  }

  .search-submit {
    padding: 14px 28px;
    background: var(--accent);
    color: #000;
    border: 2px solid var(--accent);
    border-radius: 8px;
    font-family: var(--font-heading);
    font-size: 1rem;
    letter-spacing: 2px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .search-submit:hover {
    background: var(--accent-yellow);
    border-color: var(--accent-yellow);
    box-shadow: 0 0 16px var(--accent-glow);
  }

  .content {
    padding: 40px 20px 80px;
  }

  .empty-message {
    text-align: center;
    color: var(--text-muted);
    font-size: 1.1rem;
    padding: 60px 20px;
  }

  .results-summary {
    color: var(--text-muted);
    font-family: var(--font-heading);
    letter-spacing: 1px;
    margin-bottom: 32px;
    text-align: center;
  }

  .result-group {
    margin-bottom: 48px;
  }

  .group-title {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    letter-spacing: 2px;
    color: var(--accent-yellow);
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border-card);
  }

  .result-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
  }

  .result-card {
    display: flex;
    gap: 16px;
    padding: 16px;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 12px;
    color: var(--text-primary);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .result-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 20px var(--accent-glow);
    color: var(--text-primary);
  }

  .result-img,
  .result-placeholder {
    width: 80px;
    height: 80px;
    border-radius: 8px;
    object-fit: cover;
    flex-shrink: 0;
    background: #1a1a1a;
  }

  .result-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    color: var(--text-dark);
  }

  .result-body {
    flex: 1;
    min-width: 0;
  }

  .result-title {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    color: var(--accent-yellow);
    letter-spacing: 1px;
    margin: 8px 0 4px;
  }

  .result-desc {
    color: var(--text-secondary);
    font-size: 0.85rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
