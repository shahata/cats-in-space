---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import MenuOrderView from '../../components/MenuOrderView';
import {
	sections as sectionsApi,
	items as itemsApi,
	itemLabels,
	itemVariants,
	itemModifiers,
	itemModifierGroups,
	menus as menusApi,
	menuOrderingSettings as menuOrderingSettingsApi,
} from '@wix/restaurants';
import { i18n, auth } from '@wix/essentials';
import { getImageUrl, getShapeUrl } from '../../utils/image';

const t = i18n.getTranslationFunction();

// Fetch all menus
const elevatedQueryMenus = auth.elevate(menusApi.queryMenus);
const menusResult = await elevatedQueryMenus().find();
const allMenus = (menusResult.items || []).filter(m => m.visible !== false);

// Fetch menu ordering settings — decides which menus are online-orderable
const elevatedQueryMos = auth.elevate(menuOrderingSettingsApi.queryMenuOrderingSettings);
const mosResult = await elevatedQueryMos({});
const mosList = mosResult.menuOrderingSettings || [];
const operationByMenuId = new Map<string, string>();
for (const s of mosList) {
	if (s.onlineOrderingEnabled && s.menuId && s.operationId) {
		operationByMenuId.set(s.menuId, s.operationId);
	}
}
const orderableMenus = allMenus.filter(m => m._id && operationByMenuId.has(m._id));

const elevatedQuerySections = auth.elevate(sectionsApi.querySections);
const sectionsResult = await elevatedQuerySections().find();
const allSections = sectionsResult.items || [];
const sectionById = new Map(allSections.map(s => [s._id!, s]));

const elevatedQueryItems = auth.elevate(itemsApi.queryItems);
const itemsResult = await elevatedQueryItems().limit(200).find();
const allItems = itemsResult.items || [];
const itemById = new Map(allItems.map(i => [i._id!, i]));

interface LabelInfo { name: string; icon: string | null }
const elevatedListLabels = auth.elevate(itemLabels.listLabels);
const labelMap = new Map<string, LabelInfo>();
try {
	const labelsResult = await elevatedListLabels();
	for (const label of (labelsResult as { labels?: Array<{ _id?: string; name?: string; icon?: unknown }> })?.labels || []) {
		if (label._id && label.name) {
			labelMap.set(label._id, { name: label.name, icon: getShapeUrl(label.icon) });
		}
	}
} catch {}

// Load modifier groups + modifiers to enrich items (items only have ID references)
interface RawModifier {
	_id?: string | null;
	name?: string | null;
}
interface RawModifierGroup {
	_id?: string | null;
	name?: string | null;
	rule?: { required?: boolean | null; minSelections?: number | null; maxSelections?: number | null } | null;
	modifiers?: Array<{ _id?: string | null; additionalChargeInfo?: { additionalCharge?: string | null } | null; additionalCharge?: string | null; preSelected?: boolean | null }> | null;
}

const modifierMap = new Map<string, string>();
try {
	const elevatedQueryModifiers = auth.elevate(itemModifiers.queryModifiers);
	const modsResult = await elevatedQueryModifiers().limit(200).find();
	for (const m of (modsResult.items || []) as RawModifier[]) {
		if (m._id && m.name) modifierMap.set(m._id, m.name);
	}
} catch {}

const modifierGroupById = new Map<string, RawModifierGroup>();
try {
	const elevatedQueryMG = auth.elevate(itemModifierGroups.queryModifierGroups);
	const mgResult = await elevatedQueryMG().limit(100).find();
	for (const g of (mgResult.items || []) as RawModifierGroup[]) {
		if (g._id) modifierGroupById.set(g._id, g);
	}
} catch {}

const variantMap = new Map<string, string>();
try {
	const elevatedListVariants = auth.elevate(itemVariants.listVariants);
	const variantsResult = await elevatedListVariants();
	for (const v of (variantsResult as { variants?: Array<{ _id?: string; name?: string }> })?.variants || []) {
		if (v._id && v.name) variantMap.set(v._id, v.name);
	}
} catch {}

interface ItemImg { url?: string | null; id?: string | null }
function getItemImage(item: { image?: string | ItemImg | null }): string | null {
	const img = item.image;
	if (!img) return null;
	if (typeof img === 'string') return getImageUrl(img, 400, 400);
	return getImageUrl(img.url || img.id || undefined, 400, 400);
}

interface RawItem {
	_id?: string | null;
	name?: string | null;
	description?: string | null;
	image?: string | ItemImg | null;
	priceInfo?: { price?: string | null } | null;
	priceVariants?: { variants?: Array<{ variantId?: string | null; _id?: string | null; name?: string | null; price?: string | null }> | null } | null;
	labels?: Array<{ id?: string | null; _id?: string | null }> | null;
	modifierGroups?: Array<{ _id?: string | null; id?: string | null }> | null;
}

function buildItemDto(item: RawItem, ctx: { menuId: string; sectionId: string; operationId: string }) {
	const modifierGroups = (item.modifierGroups || [])
		.map(ref => {
			const groupId = ref._id || ref.id;
			if (!groupId) return null;
			const g = modifierGroupById.get(groupId);
			if (!g) return null;
			const minSel = g.rule?.minSelections ?? 0;
			const maxSel = g.rule?.maxSelections ?? 0;
			const required = !!g.rule?.required;
			return {
				_id: g._id || '',
				name: g.name || '',
				required,
				minChoices: required ? Math.max(1, minSel) : minSel,
				maxChoices: maxSel,
				modifiers: (g.modifiers || []).map(m => {
					const modId = m._id || '';
					const price = m.additionalChargeInfo?.additionalCharge ?? m.additionalCharge ?? '0';
					return {
						_id: modId,
						name: modifierMap.get(modId) || '',
						additionalPrice: price && parseFloat(price) > 0 ? { amount: price } : null,
						preSelected: !!m.preSelected,
					};
				}),
			};
		})
		.filter((g): g is NonNullable<typeof g> => g !== null);

	return {
		_id: item._id || '',
		name: item.name || '',
		description: item.description || '',
		image: getItemImage(item),
		price: item.priceInfo?.price ? { amount: item.priceInfo.price, currency: 'USD' } : null,
		priceVariants: (item.priceVariants?.variants || []).map(v => ({
			_id: v.variantId || v._id || '',
			name: variantMap.get(v.variantId || v._id || '') || v.name || '',
			price: { amount: v.price || '0', currency: 'USD' },
		})),
		labels: (item.labels || [])
			.map(l => {
				const id = l?.id || l?._id;
				return (id && labelMap.get(id)) || null;
			})
			.filter((l): l is LabelInfo => !!l),
		modifierGroups,
		menuId: ctx.menuId,
		sectionId: ctx.sectionId,
		operationId: ctx.operationId,
	};
}

// Build menu → sections → items structure, flatten across menus
// but preserve section order per menu; dedupe sections that appear in multiple menus.
const seenSections = new Set<string>();
const menuData = orderableMenus.flatMap(menu => {
	const operationId = operationByMenuId.get(menu._id!)!;
	return (menu.sectionIds || [])
		.map(id => sectionById.get(id))
		.filter((s): s is NonNullable<typeof s> => !!s && s.visible !== false)
		.filter(s => {
			if (!s._id || seenSections.has(s._id)) return false;
			seenSections.add(s._id);
			return true;
		})
		.map(section => {
			const sectionItems = (section.itemIds || [])
				.map(id => itemById.get(id))
				.filter((i): i is NonNullable<typeof i> => !!i && i.visible !== false)
				.map(i => buildItemDto(i as RawItem, { menuId: menu._id!, sectionId: section._id!, operationId }));
			return {
				_id: section._id!,
				name: section.name || '',
				items: sectionItems,
			};
		})
		.filter(s => s.items.length > 0);
});
---

<Layout title={`${t('restaurant.order')} - ${t('home.title')}`}>
	<Nav />
	<section class="page-header">
		<div class="container">
			<h1 class="section-title">{t('restaurant.order')}</h1>
			<p class="section-subtitle">{t('restaurant.orderSubtitle')}</p>
		</div>
	</section>

	<section class="order-content">
		<div class="container">
			{menuData.length === 0 ? (
				<div class="empty-order">
					<p>{t('restaurant.noOrderableItems')}</p>
				</div>
			) : (
				<MenuOrderView sections={menuData} client:load />
			)}
		</div>
	</section>
	<Footer />
</Layout>

<style>
	.page-header {
		padding: 60px 0 30px;
		text-align: center;
	}

	.order-content {
		padding-bottom: 120px;
	}

	.empty-order {
		text-align: center;
		padding: 60px 20px;
		color: var(--text-muted);
	}
</style>

<style is:global>
	.mov-layout {
		display: grid;
		grid-template-columns: 200px 1fr;
		gap: 40px;
		align-items: start;
	}

	.mov-side {
		position: sticky;
		top: 80px;
	}

	.mov-nav {
		display: flex;
		flex-direction: column;
		gap: 2px;
		background: var(--bg-card);
		border: 1px solid var(--border-card);
		border-radius: 12px;
		padding: 8px;
	}

	.mov-nav-item {
		padding: 10px 14px;
		font-family: var(--font-heading);
		font-size: 0.8rem;
		letter-spacing: 1px;
		color: var(--text-muted);
		background: none;
		border: none;
		border-radius: 8px;
		cursor: pointer;
		text-align: start;
		transition: all 0.15s;
	}

	.mov-nav-item:hover {
		color: var(--text-secondary);
		background: rgba(255, 255, 255, 0.03);
	}

	.mov-nav-item.active {
		color: #000;
		background: var(--accent);
	}

	.mov-main {
		min-width: 0;
	}

	.mov-section {
		margin-bottom: 48px;
		scroll-margin-top: 80px;
	}

	.mov-section-title {
		font-family: var(--font-heading);
		font-size: 1.4rem;
		color: var(--accent-yellow);
		letter-spacing: 2px;
		text-transform: uppercase;
		margin-bottom: 16px;
		padding-bottom: 8px;
		border-bottom: 1px solid #222;
	}

	.mov-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
		gap: 16px;
	}

	.mov-card {
		display: flex;
		align-items: stretch;
		gap: 16px;
		padding: 16px;
		background: var(--bg-card);
		border: 1px solid var(--border-card);
		border-radius: 12px;
		cursor: pointer;
		text-align: start;
		font-family: inherit;
		color: inherit;
		transition: all 0.15s;
	}

	.mov-card:hover {
		border-color: var(--accent);
		transform: translateY(-1px);
	}

	.mov-card-body {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.mov-card-name {
		font-family: var(--font-heading);
		font-size: 1rem;
		color: var(--text-primary);
		letter-spacing: 0.5px;
	}

	.mov-card-desc {
		font-size: 0.8rem;
		color: var(--text-muted);
		line-height: 1.4;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.mov-card-labels {
		display: flex;
		gap: 4px;
		flex-wrap: wrap;
	}

	.mov-label {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-family: var(--font-heading);
		font-size: 0.6rem;
		padding: 2px 6px;
		background: rgba(255, 102, 0, 0.15);
		color: var(--accent);
		border-radius: 4px;
		letter-spacing: 0.5px;
	}

	.mov-label-icon {
		display: inline-block;
		width: 12px;
		height: 12px;
		background-color: var(--accent);
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
		-webkit-mask-size: contain;
		mask-size: contain;
		-webkit-mask-position: center;
		mask-position: center;
	}

	.mov-card-price {
		margin-top: auto;
		font-family: var(--font-heading);
		font-size: 1rem;
		color: var(--accent-yellow);
	}

	.mov-card-image {
		position: relative;
		width: 110px;
		height: 110px;
		flex-shrink: 0;
		border-radius: 10px;
		overflow: hidden;
		background: #111;
	}

	.mov-card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.mov-card-ph {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 2.5rem;
		background: linear-gradient(135deg, #1a1a2e, #16213e);
		opacity: 0.7;
	}

	.mov-card-badge {
		position: absolute;
		top: 6px;
		inset-inline-end: 6px;
		min-width: 28px;
		height: 28px;
		padding: 0 8px;
		border-radius: 14px;
		background: var(--accent);
		color: #000;
		font-size: 0.9rem;
		font-weight: 700;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
	}

	.mov-card-badge.has-qty {
		background: #2196f3;
		color: #fff;
	}

	.mov-card:hover .mov-card-badge {
		transform: scale(1.08);
	}

	.mov-card-summary {
		margin-top: 8px;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.mov-card-summary-line {
		font-size: 0.72rem;
		color: var(--accent);
		background: rgba(33, 150, 243, 0.1);
		padding: 4px 8px;
		border-radius: 6px;
		border: 1px solid rgba(33, 150, 243, 0.2);
	}

	.mov-cart-bar {
		position: fixed;
		bottom: 16px;
		left: 50%;
		transform: translateX(-50%);
		z-index: 100;
	}

	.mov-cart-btn {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 12px 20px;
		background: var(--accent);
		color: #000;
		border: none;
		border-radius: 999px;
		font-family: var(--font-heading);
		font-size: 0.9rem;
		letter-spacing: 1px;
		cursor: pointer;
		font-weight: 700;
		box-shadow: 0 8px 24px rgba(255, 102, 0, 0.3);
		transition: all 0.2s;
	}

	.mov-cart-btn:hover {
		background: var(--accent-yellow);
		transform: translateY(-1px);
	}

	.mov-cart-count {
		background: #000;
		color: var(--accent);
		width: 24px;
		height: 24px;
		border-radius: 50%;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 0.8rem;
	}

	.mov-cart-total {
		padding-inline-start: 10px;
		border-inline-start: 1px solid rgba(0, 0, 0, 0.3);
	}

	/* Modal */
	.mov-modal-overlay {
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.7);
		backdrop-filter: blur(4px);
		z-index: 1000;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 20px;
		animation: movFade 0.2s;
	}

	@keyframes movFade {
		from { opacity: 0; }
		to { opacity: 1; }
	}

	.mov-modal {
		background: var(--bg-card);
		border: 1px solid var(--border-card);
		border-radius: 16px;
		width: 100%;
		max-width: 560px;
		max-height: 90vh;
		overflow-y: auto;
		position: relative;
		animation: movScale 0.2s ease-out;
	}

	@keyframes movScale {
		from { transform: scale(0.96); opacity: 0; }
		to { transform: scale(1); opacity: 1; }
	}

	.mov-modal-hero {
		height: 200px;
		background: #111;
		overflow: hidden;
	}

	.mov-modal-hero img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.mov-modal-close {
		position: absolute;
		top: 12px;
		right: 12px;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background: rgba(0, 0, 0, 0.5);
		color: #fff;
		border: none;
		font-size: 1.5rem;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		line-height: 1;
	}

	.mov-modal-body {
		padding: 24px;
	}

	.mov-modal-title {
		font-family: var(--font-heading);
		font-size: 1.3rem;
		color: var(--text-primary);
		letter-spacing: 1px;
		margin-bottom: 8px;
	}

	.mov-modal-desc {
		color: var(--text-secondary);
		font-size: 0.9rem;
		line-height: 1.5;
		margin-bottom: 20px;
	}

	.mov-group {
		margin-bottom: 20px;
	}

	.mov-group-label {
		font-family: var(--font-heading);
		font-size: 0.75rem;
		letter-spacing: 1px;
		color: var(--text-muted);
		text-transform: uppercase;
		margin-bottom: 8px;
	}

	.mov-req {
		color: #f44336;
	}

	.mov-group-hint {
		color: var(--text-muted);
		font-weight: normal;
		text-transform: none;
		letter-spacing: 0;
		font-family: inherit;
	}

	.mov-group-invalid {
		color: #f44336;
	}

	.mov-variant-list {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.mov-variant-btn, .mov-mod-btn {
		display: flex;
		justify-content: space-between;
		align-items: center;
		width: 100%;
		padding: 10px 14px;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid #333;
		border-radius: 8px;
		color: var(--text-secondary);
		font-size: 0.85rem;
		cursor: pointer;
		text-align: start;
		font-family: inherit;
		margin-bottom: 4px;
		transition: all 0.15s;
	}

	.mov-variant-btn:hover, .mov-mod-btn:hover {
		border-color: var(--accent);
	}

	.mov-variant-btn.active, .mov-mod-btn.active {
		border-color: var(--accent);
		background: rgba(255, 102, 0, 0.08);
		color: var(--text-primary);
	}

	.mov-mod-price {
		color: var(--accent);
	}

	.mov-qty-row {
		display: inline-flex;
		align-items: center;
		border: 1px solid #333;
		border-radius: 8px;
		overflow: hidden;
	}

	.mov-qty-btn {
		width: 36px;
		height: 36px;
		background: rgba(255, 255, 255, 0.03);
		border: none;
		color: var(--text-secondary);
		font-size: 1rem;
		cursor: pointer;
	}

	.mov-qty-btn:hover {
		color: var(--accent);
	}

	.mov-qty-val {
		width: 44px;
		text-align: center;
		color: var(--text-primary);
		font-weight: 700;
	}

	.mov-confirm {
		flex: 1;
		padding: 14px;
		background: var(--accent);
		color: #000;
		border: none;
		border-radius: 10px;
		font-family: var(--font-heading);
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 1px;
		cursor: pointer;
		transition: all 0.15s;
	}

	.mov-confirm:hover:not(:disabled) {
		background: var(--accent-yellow);
	}

	.mov-confirm:disabled {
		opacity: 0.5;
		cursor: not-allowed;
	}

	.mov-actions-row {
		display: flex;
		gap: 10px;
		margin-top: 12px;
	}

	.mov-secondary-btn {
		padding: 14px 20px;
		background: rgba(255, 255, 255, 0.05);
		color: var(--text-secondary);
		border: 1px solid var(--border-card);
		border-radius: 10px;
		font-family: var(--font-heading);
		font-size: 0.9rem;
		letter-spacing: 1px;
		cursor: pointer;
	}

	.mov-secondary-btn:hover:not(:disabled) {
		color: var(--text-primary);
		border-color: var(--accent);
	}

	.mov-edit-banner {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 6px;
		padding: 14px 16px;
		background: rgba(33, 150, 243, 0.08);
		border: 1px solid rgba(33, 150, 243, 0.2);
		border-radius: 10px;
		margin-bottom: 20px;
	}

	.mov-edit-banner-text {
		font-size: 0.85rem;
		color: var(--text-primary);
	}

	.mov-edit-banner-link {
		background: none;
		border: none;
		color: #2196f3;
		font-family: var(--font-heading);
		font-size: 0.8rem;
		letter-spacing: 0.5px;
		cursor: pointer;
		padding: 0;
	}

	.mov-edit-banner-link:hover {
		text-decoration: underline;
	}

	.mov-remove-btn {
		padding: 14px 18px;
		font-size: 1.1rem;
		flex: 0 0 auto;
	}

	.mov-remove-btn:hover:not(:disabled) {
		color: #f44336;
		border-color: #f44336;
	}

	.mov-line-list {
		list-style: none;
		padding: 0;
		margin: 0 0 16px;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.mov-line {
		padding: 12px;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid var(--border-card);
		border-radius: 10px;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.mov-line-body {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 8px;
	}

	.mov-line-summary {
		flex: 1;
		font-size: 0.85rem;
		color: var(--text-primary);
		line-height: 1.4;
	}

	.mov-line-edit {
		background: none;
		border: none;
