---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { i18n } from "@wix/essentials";

const t = i18n.getTranslationFunction();
---

<Layout title={`${t("restaurant.thankYouTitle")} - ${t("home.title")}`}>
  <Nav />
  <section class="thank-you">
    <div class="container">
      <div class="ty-hero">
        <div class="ty-icon">&#128640;</div>
        <h1 class="section-title">{t("restaurant.thankYouTitle")}</h1>
        <p class="ty-subtitle">{t("restaurant.thankYouSubtitle")}</p>
      </div>

      <div class="ty-actions">
        <a href="/restaurant" class="ty-btn ty-btn-primary"
          ><span class="rtl-flip">←</span> {t("restaurant.backToMenu")}</a
        >
        <a href="/restaurant/reserve" class="ty-btn ty-btn-secondary"
          >{t("restaurant.reserveTable")}</a
        >
      </div>
    </div>
  </section>
  <Footer />
</Layout>

<style>
  .thank-you {
    padding: 60px 0;
    min-height: 60vh;
  }

  .ty-hero {
    text-align: center;
    margin-bottom: 40px;
  }

  .ty-icon {
    font-size: 4rem;
    margin-bottom: 16px;
  }

  .ty-subtitle {
    color: var(--text-secondary);
    font-size: 1.1rem;
    margin-top: 8px;
  }

  .ty-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .ty-btn {
    padding: 12px 28px;
    border-radius: 8px;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    letter-spacing: 1.5px;
    text-decoration: none;
    transition: all 0.2s;
  }

  .ty-btn-primary {
    background: var(--accent);
    color: #000;
  }

  .ty-btn-primary:hover {
    background: #ff8533;
    color: #000;
  }

  .ty-btn-secondary {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    color: var(--text-secondary);
  }

  .ty-btn-secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
