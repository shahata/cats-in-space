---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ReservationFlow from '../../components/ReservationFlow';
import { reservationLocations } from '@wix/table-reservations';
import { members } from '@wix/members';
import { i18n, auth } from '@wix/essentials';

type ReservationLocation = reservationLocations.ReservationLocation;
type TimePeriod = NonNullable<NonNullable<NonNullable<ReservationLocation['configuration']>['onlineReservations']>['businessSchedule']>['periods'] extends (infer P)[] | null | undefined ? P : never;

const t = i18n.getTranslationFunction();

let locationId = '';
let businessSchedule: TimePeriod[] = [];
let timeSlotInterval = 15;
try {
	const elevatedList = auth.elevate(reservationLocations.listReservationLocations);
	const list = await elevatedList();
	const first = (list.reservationLocations || [])[0];
	if (first?._id) {
		locationId = first._id;
		const elevatedGet = auth.elevate(reservationLocations.getReservationLocation);
		const location = await elevatedGet(first._id);
		const onlineRes = location.configuration?.onlineReservations;
		businessSchedule = onlineRes?.businessSchedule?.periods || [];
		timeSlotInterval = onlineRes?.timeSlotInterval || 15;
	}
} catch {}

let memberName = '';
let memberEmail = '';
let memberPhone = '';
try {
	const res = await members.getCurrentMember({ fieldsets: [members.Set.FULL] });
	if (res.member) {
		const c = res.member.contact;
		const p = res.member.profile;
		memberName = [c?.firstName, c?.lastName].filter(Boolean).join(' ') || p?.nickname || '';
		memberEmail = c?.emails?.[0] || res.member.loginEmail || '';
		memberPhone = c?.phones?.[0] || '';
	}
} catch {}
---

<Layout title={`${t('restaurant.reserveTitle')} - ${t('home.title')}`}>
	<Nav />
	<section class="page-header">
		<div class="container">
			<h1 class="section-title">{t('restaurant.reserveTitle')}</h1>
			<p class="section-subtitle">{t('restaurant.reserveSubtitle')}</p>
		</div>
	</section>

	<section class="reserve-content">
		<div class="container">
			<div class="reserve-wrapper">
				<ReservationFlow
					reservationLocationId={locationId}
					businessSchedule={businessSchedule}
					timeSlotInterval={timeSlotInterval}
					{...(memberName ? { defaultName: memberName } : {})}
					{...(memberEmail ? { defaultEmail: memberEmail } : {})}
					{...(memberPhone ? { defaultPhone: memberPhone } : {})}
					client:load
				/>
			</div>
		</div>
	</section>
	<Footer />
</Layout>

<style>
	.page-header {
		padding: 60px 0 30px;
		text-align: center;
	}

	.reserve-content {
		padding-bottom: 60px;
	}

	.reserve-wrapper {
		max-width: 600px;
		margin: 0 auto;
	}
</style>
