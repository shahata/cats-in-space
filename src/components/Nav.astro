---
import { members } from '@wix/members';

const currentPath = Astro.url.pathname;

let loggedInMember: string | null = null;
try {
	const res = await members.getCurrentMember({ fieldsets: ['FULL'] });
	if (res.member) {
		loggedInMember = res.member.profile?.nickname || res.member.contact?.firstName || 'Member';
	}
} catch {}

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/planets', label: 'Planets' },
	{ href: '/crew', label: 'Crew' },
	{ href: '/missions', label: 'Missions' },
	{ href: '/blog', label: "Ship's Log" },
];
---

<nav class="nav">
	<div class="nav-inner container">
		<a href="/" class="nav-logo">CATS IN SPACE</a>
		<div class="nav-links">
			{links.map(link => (
				<a
					href={link.href}
					class:list={['nav-link', { active: currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) }]}
				>
					{link.label}
				</a>
			))}
			{loggedInMember ? (
				<div class="auth-section">
					<span class="member-name">{loggedInMember}</span>
					<form action="/api/auth/logout" method="POST" style="display:inline">
						<button type="submit" class="auth-btn">Logout</button>
					</form>
				</div>
			) : (
				<a href="/api/auth/login" class="auth-btn login-btn">Login</a>
			)}
		</div>
	</div>
</nav>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(10, 10, 10, 0.95);
		border-bottom: 1px solid #222;
		backdrop-filter: blur(10px);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 60px;
	}

	.nav-logo {
		font-family: var(--font-title);
		font-size: 1.2rem;
		color: var(--accent);
		letter-spacing: 2px;
		text-shadow: 0 0 15px var(--accent-glow);
	}

	.nav-logo:hover {
		color: var(--accent-yellow);
	}

	.nav-links {
		display: flex;
		gap: 4px;
	}

	.nav-link {
		padding: 8px 16px;
		border-radius: 8px;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--text-secondary);
		transition: all 0.2s;
		font-family: var(--font-heading);
		letter-spacing: 1px;
	}

	.nav-link:hover {
		color: var(--accent);
		background: rgba(255, 102, 0, 0.1);
	}

	.nav-link.active {
		color: #000;
		background: var(--accent);
	}

	.auth-section {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-left: 8px;
		padding-left: 12px;
		border-left: 1px solid #333;
	}

	.member-name {
		font-family: var(--font-heading);
		font-size: 0.85rem;
		color: var(--accent-yellow);
		letter-spacing: 1px;
	}

	.auth-btn {
		padding: 6px 14px;
		border-radius: 8px;
		font-size: 0.8rem;
		font-weight: 600;
		font-family: var(--font-heading);
		letter-spacing: 1px;
		color: var(--text-secondary);
		transition: all 0.2s;
		background: none;
		border: none;
		cursor: pointer;
		text-decoration: none;
	}

	.auth-btn:hover {
		color: var(--accent);
		background: rgba(255, 102, 0, 0.1);
	}

	.login-btn {
		background: var(--accent);
		color: #000;
		margin-left: 8px;
	}

	.login-btn:hover {
		background: var(--accent-yellow);
		color: #000;
	}

	@media (max-width: 640px) {
		.nav-link {
			padding: 8px 10px;
			font-size: 0.8rem;
		}
		.nav-logo {
			font-size: 0.9rem;
		}
	}
</style>
