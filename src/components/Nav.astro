---
import { members } from '@wix/members';
import { i18n } from '@wix/essentials';
import { multilingual } from '@wix/site';
import { getRelativeLocaleUrl } from 'wix:astro:i18n';

const currentPath = Astro.url.pathname;
const currentLanguage = i18n.getLanguage();
const t = i18n.getTranslationFunction();

// Get supported languages for language switcher
const supportedLanguages = (() => {
	try {
		return multilingual.listSupportedLanguages();
	} catch {
		return [
			{ id: 'en', displayName: 'English', primary: true },
			{ id: 'ja', displayName: 'Japanese', primary: false },
		];
	}
})();

// Get the page path without locale prefix using getRelativeLocaleUrl
const localePrefix = getRelativeLocaleUrl('/').replace(/\/$/, '');
const pagePath = localePrefix ? currentPath.replace(localePrefix, '') || '/' : currentPath;

const languageFlags: Record<string, string> = {
	en: 'EN',
	ja: 'JA',
};

let loggedInMember: string | null = null;
let memberPhoto: string | null = null;
try {
	const res = await members.getCurrentMember({ fieldsets: ['FULL'] });
	if (res.member) {
		loggedInMember = res.member.profile?.nickname || res.member.contact?.firstName || 'Member';
		memberPhoto = res.member.profile?.photo?.url || null;
	}
} catch {}

const links = [
	{ href: getRelativeLocaleUrl('/'), label: t('nav.home'), matchPath: '/' },
	{ href: getRelativeLocaleUrl('/planets'), label: t('nav.planets'), matchPath: '/planets' },
	{ href: getRelativeLocaleUrl('/crew'), label: t('nav.crew'), matchPath: '/crew' },
	{ href: getRelativeLocaleUrl('/missions'), label: t('nav.missions'), matchPath: '/missions' },
	{ href: getRelativeLocaleUrl('/blog'), label: t('nav.blog'), matchPath: '/blog' },
	{ href: getRelativeLocaleUrl('/store'), label: t('nav.store'), matchPath: '/store' },
	{ href: getRelativeLocaleUrl('/bookings'), label: t('nav.bookings'), matchPath: '/bookings' },
	{ href: getRelativeLocaleUrl('/plans'), label: t('nav.plans'), matchPath: '/plans' },
];

const strippedPath = pagePath;
---

<nav class="nav">
	<div class="nav-inner container">
		<a href={getRelativeLocaleUrl('/')} class="nav-logo">CATS IN SPACE</a>
		<button class="nav-toggle" aria-label="Toggle menu">
			<span class="nav-toggle-bar"></span>
			<span class="nav-toggle-bar"></span>
			<span class="nav-toggle-bar"></span>
		</button>
		<div class="nav-links">
			{links.map(link => (
				<a
					href={link.href}
					class:list={['nav-link', { active: strippedPath === link.matchPath || (link.matchPath !== '/' && strippedPath.startsWith(link.matchPath)) }]}
				>
					{link.label}
				</a>
			))}
			<div class="auth-section">
				{loggedInMember ? (
					<div class="member-menu">
						<button class="member-link" type="button">
							{memberPhoto && <img src={memberPhoto} alt={loggedInMember} class="member-avatar" referrerpolicy="no-referrer" />}
							<span class="member-name">{loggedInMember}</span>
							<span class="member-caret">&#9662;</span>
						</button>
						<div class="member-dropdown">
							<a href={getRelativeLocaleUrl('/member')} class="dropdown-item">{t('nav.myProfile')}</a>
							<div class="dropdown-item dropdown-lang-trigger">
								<span>{t('nav.language')}</span>
								<span class="lang-current-flag">{languageFlags[currentLanguage] || currentLanguage.toUpperCase()}</span>
								<span class="lang-caret">&#9656;</span>
								<div class="lang-submenu">
									{supportedLanguages.map(lang => (
										<a
											href={lang.primary ? pagePath : `/${lang.id}${pagePath === '/' ? '' : pagePath}`}
											class:list={['lang-option', { 'lang-active': lang.id === currentLanguage }]}
										>
											<span class="lang-flag">{languageFlags[lang.id || ''] || (lang.id || '').toUpperCase()}</span>
											<span class="lang-name">{lang.displayName}</span>
											{lang.id === currentLanguage && <span class="lang-check">&#10003;</span>}
										</a>
									))}
								</div>
							</div>
							<form action={`/api/auth/logout?returnToUrl=${encodeURIComponent(currentPath)}`} method="POST">
								<button type="submit" class="dropdown-item dropdown-logout">{t('nav.logout')}</button>
							</form>
						</div>
						</div>
				) : (
					<>
						<div class="lang-standalone">
							<button class="lang-standalone-btn" type="button">
								<span class="lang-standalone-flag">{languageFlags[currentLanguage] || currentLanguage.toUpperCase()}</span>
								<span class="lang-standalone-caret">&#9662;</span>
							</button>
							<div class="lang-standalone-dropdown">
								{supportedLanguages.map(lang => (
									<a
										href={lang.primary ? pagePath : `/${lang.id}${pagePath === '/' ? '' : pagePath}`}
										class:list={['lang-option', { 'lang-active': lang.id === currentLanguage }]}
									>
										<span class="lang-flag">{languageFlags[lang.id || ''] || (lang.id || '').toUpperCase()}</span>
										<span class="lang-name">{lang.displayName}</span>
										{lang.id === currentLanguage && <span class="lang-check">&#10003;</span>}
									</a>
								))}
							</div>
						</div>
						<a href={`/api/auth/login?returnToUrl=${encodeURIComponent(currentPath)}`} class="auth-link">{t('nav.login')}</a>
					</>
				)}
			</div>
		</div>
	</div>
</nav>

<script>
	const toggle = document.querySelector('.nav-toggle');
	const links = document.querySelector('.nav-links');
	toggle?.addEventListener('click', () => {
		links?.classList.toggle('nav-links-open');
		toggle.classList.toggle('nav-toggle-active');
	});

	const menuBtn = document.querySelector('.member-menu .member-link');
	const dropdown = document.querySelector('.member-dropdown');
	menuBtn?.addEventListener('click', (e) => {
		e.stopPropagation();
		dropdown?.classList.toggle('member-dropdown-open');
	});

	// Standalone language switcher for logged-out users
	const langStandaloneBtn = document.querySelector('.lang-standalone-btn');
	const langStandaloneDropdown = document.querySelector('.lang-standalone-dropdown');
	langStandaloneBtn?.addEventListener('click', (e) => {
		e.stopPropagation();
		langStandaloneDropdown?.classList.toggle('lang-standalone-dropdown-open');
	});

	document.addEventListener('click', () => {
		dropdown?.classList.remove('member-dropdown-open');
		langStandaloneDropdown?.classList.remove('lang-standalone-dropdown-open');
	});
</script>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(10, 10, 10, 0.95);
		border-bottom: 1px solid #222;
		backdrop-filter: blur(10px);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 60px;
	}

	.nav-logo {
		font-family: var(--font-title);
		font-size: 1.2rem;
		color: var(--accent);
		letter-spacing: 2px;
		text-shadow: 0 0 15px var(--accent-glow);
		flex-shrink: 0;
	}

	.nav-logo:hover {
		color: var(--accent-yellow);
	}

	.nav-toggle {
		display: none;
		flex-direction: column;
		gap: 5px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 4px;
	}

	.nav-toggle-bar {
		display: block;
		width: 24px;
		height: 2px;
		background: var(--text-secondary);
		border-radius: 2px;
		transition: all 0.3s;
	}

	.nav-toggle-active .nav-toggle-bar:nth-child(1) {
		transform: rotate(45deg) translate(5px, 5px);
	}
	.nav-toggle-active .nav-toggle-bar:nth-child(2) {
		opacity: 0;
	}
	.nav-toggle-active .nav-toggle-bar:nth-child(3) {
		transform: rotate(-45deg) translate(5px, -5px);
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 4px;
	}

	.nav-link {
		padding: 8px 16px;
		border-radius: 8px;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--text-secondary);
		transition: all 0.2s;
		font-family: var(--font-heading);
		letter-spacing: 1px;
	}

	.nav-link:hover {
		color: var(--accent);
		background: rgba(255, 102, 0, 0.1);
	}

	.nav-link.active {
		color: #000;
		background: var(--accent);
	}

	.member-menu {
		position: relative;
	}

	.member-link {
		display: flex;
		align-items: center;
		gap: 8px;
		text-decoration: none;
		transition: opacity 0.2s;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0;
	}

	.member-link:hover {
		opacity: 0.8;
	}

	.member-caret {
		font-size: 0.6rem;
		color: var(--text-muted);
		transition: transform 0.2s;
	}

	.member-dropdown {
		display: none;
		position: absolute;
		top: calc(100% + 8px);
		right: 0;
		background: rgba(20, 20, 20, 0.98);
		border: 1px solid #333;
		border-radius: 8px;
		min-width: 160px;
		padding: 6px 0;
		z-index: 200;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
	}

	.member-dropdown-open {
		display: block;
	}

	.dropdown-item {
		display: block;
		width: 100%;
		padding: 10px 16px;
		font-size: 0.85rem;
		font-family: var(--font-heading);
		letter-spacing: 1px;
		color: var(--text-secondary);
		text-decoration: none;
		background: none;
		border: none;
		cursor: pointer;
		text-align: left;
		transition: all 0.15s;
		box-sizing: border-box;
	}

	.dropdown-item:hover {
		color: var(--accent);
		background: rgba(255, 102, 0, 0.08);
	}

	.dropdown-logout {
		color: var(--text-muted);
		border-top: 1px solid #222;
		margin-top: 2px;
		padding-top: 10px;
	}

	.dropdown-logout:hover {
		color: #f44336;
		background: rgba(244, 67, 54, 0.08);
	}

	.member-avatar {
		width: 28px;
		height: 28px;
		border-radius: 50%;
		object-fit: cover;
		border: 2px solid var(--accent);
	}

	.auth-section {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-left: 8px;
		padding-left: 12px;
		border-left: 1px solid #333;
	}

	.member-name {
		font-family: var(--font-heading);
		font-size: 0.85rem;
		color: var(--accent-yellow);
		letter-spacing: 1px;
	}

	.auth-link {
		padding: 8px 16px;
		border-radius: 8px;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--text-secondary);
		transition: all 0.2s;
		font-family: var(--font-heading);
		letter-spacing: 1px;
		background: none;
		border: none;
		cursor: pointer;
		text-decoration: none;
	}

	.auth-link:hover {
		color: var(--accent);
		background: rgba(255, 102, 0, 0.1);
	}

	/* Language sub-menu inside member dropdown */
	.dropdown-lang-trigger {
		position: relative;
		display: flex;
		align-items: center;
		gap: 6px;
		cursor: pointer;
	}

	.lang-current-flag {
		font-size: 0.7rem;
		font-weight: 700;
		color: var(--accent);
		margin-left: auto;
	}

	.lang-caret {
		font-size: 0.55rem;
		color: var(--text-muted);
	}

	.lang-submenu {
		display: none;
		position: absolute;
		left: 100%;
		top: -6px;
		background: rgba(20, 20, 20, 0.98);
		border: 1px solid #333;
		border-radius: 8px;
		min-width: 150px;
		padding: 6px 0;
		z-index: 210;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
	}

	.dropdown-lang-trigger:hover .lang-submenu {
		display: block;
	}

	.lang-option {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 8px 14px;
		font-size: 0.8rem;
		font-family: var(--font-heading);
		letter-spacing: 1px;
		color: var(--text-secondary);
		text-decoration: none;
		transition: all 0.15s;
	}

	.lang-option:hover {
		color: var(--accent);
		background: rgba(255, 102, 0, 0.08);
	}

	.lang-active {
		color: var(--accent-yellow);
	}

	.lang-flag {
		font-size: 0.7rem;
		font-weight: 700;
		min-width: 24px;
	}

	.lang-name {
		flex: 1;
	}

	.lang-check {
		font-size: 0.7rem;
		color: var(--accent);
	}

	/* Standalone language switcher for logged-out users */
	.lang-standalone {
		position: relative;
	}

	.lang-standalone-btn {
		display: flex;
		align-items: center;
		gap: 4px;
		padding: 6px 10px;
		background: none;
		border: 1px solid #333;
		border-radius: 6px;
		cursor: pointer;
		transition: all 0.2s;
	}

	.lang-standalone-btn:hover {
		border-color: var(--accent);
	}

	.lang-standalone-flag {
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--accent);
	}

	.lang-standalone-caret {
		font-size: 0.5rem;
		color: var(--text-muted);
	}

	.lang-standalone-dropdown {
		display: none;
		position: absolute;
		top: calc(100% + 6px);
		right: 0;
		background: rgba(20, 20, 20, 0.98);
		border: 1px solid #333;
		border-radius: 8px;
		min-width: 150px;
		padding: 6px 0;
		z-index: 200;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
	}

	.lang-standalone-dropdown-open {
		display: block;
	}

	@media (max-width: 960px) {
		.nav-toggle {
			display: flex;
		}

		.nav-links {
			display: none;
			position: absolute;
			top: 60px;
			left: 0;
			right: 0;
			background: rgba(10, 10, 10, 0.98);
			flex-direction: column;
			padding: 12px 20px 20px;
			gap: 2px;
			border-bottom: 1px solid #222;
		}

		.nav-links-open {
			display: flex;
		}

		.nav-link {
			width: 100%;
			padding: 12px 16px;
		}

		.auth-section {
			margin-left: 0;
			padding-left: 0;
			border-left: none;
			padding-top: 12px;
			margin-top: 8px;
			border-top: 1px solid #333;
			width: 100%;
			justify-content: center;
		}

		.member-dropdown {
			right: auto;
			left: 50%;
			transform: translateX(-50%);
		}

		.lang-submenu {
			left: auto;
			right: 0;
			top: 100%;
		}

		.lang-standalone-dropdown {
			left: auto;
			right: 0;
		}
	}
</style>
