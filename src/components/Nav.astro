---
const currentPath = Astro.url.pathname;

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/planets', label: 'Planets' },
	{ href: '/crew', label: 'Crew' },
	{ href: '/missions', label: 'Missions' },
];
---

<nav class="nav">
	<div class="nav-inner container">
		<a href="/" class="nav-logo">CATS IN SPACE</a>
		<div class="nav-links">
			{links.map(link => (
				<a
					href={link.href}
					class:list={['nav-link', { active: currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) }]}
				>
					{link.label}
				</a>
			))}
		</div>
	</div>
</nav>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(10, 10, 10, 0.95);
		border-bottom: 1px solid #222;
		backdrop-filter: blur(10px);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 60px;
	}

	.nav-logo {
		font-family: var(--font-title);
		font-size: 1.2rem;
		color: var(--accent);
		letter-spacing: 2px;
		text-shadow: 0 0 15px var(--accent-glow);
	}

	.nav-logo:hover {
		color: var(--accent-yellow);
	}

	.nav-links {
		display: flex;
		gap: 4px;
	}

	.nav-link {
		padding: 8px 16px;
		border-radius: 8px;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--text-secondary);
		transition: all 0.2s;
		font-family: var(--font-heading);
		letter-spacing: 1px;
	}

	.nav-link:hover {
		color: var(--accent);
		background: rgba(255, 102, 0, 0.1);
	}

	.nav-link.active {
		color: #000;
		background: var(--accent);
	}

	@media (max-width: 640px) {
		.nav-link {
			padding: 8px 10px;
			font-size: 0.8rem;
		}
		.nav-logo {
			font-size: 0.9rem;
		}
	}
</style>
