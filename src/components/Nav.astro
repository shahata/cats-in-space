---
import { members } from '@wix/members';

const currentPath = Astro.url.pathname;

let loggedInMember: string | null = null;
let memberPhoto: string | null = null;
try {
	const res = await members.getCurrentMember({ fieldsets: ['FULL'] });
	if (res.member) {
		loggedInMember = res.member.profile?.nickname || res.member.contact?.firstName || 'Member';
		memberPhoto = res.member.profile?.photo?.url || null;
	}
} catch {}

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/planets', label: 'Planets' },
	{ href: '/crew', label: 'Crew' },
	{ href: '/missions', label: 'Missions' },
	{ href: '/blog', label: "Ship's Log" },
	{ href: '/store', label: 'Store' },
	{ href: '/plans', label: 'Plans' },
];
---

<nav class="nav">
	<div class="nav-inner container">
		<a href="/" class="nav-logo">CATS IN SPACE</a>
		<button class="nav-toggle" aria-label="Toggle menu">
			<span class="nav-toggle-bar"></span>
			<span class="nav-toggle-bar"></span>
			<span class="nav-toggle-bar"></span>
		</button>
		<div class="nav-links">
			{links.map(link => (
				<a
					href={link.href}
					class:list={['nav-link', { active: currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) }]}
				>
					{link.label}
				</a>
			))}
			<div class="auth-section">
				{loggedInMember ? (
					<>
						<a href="/member" class="member-link">
							{memberPhoto && <img src={memberPhoto} alt={loggedInMember} class="member-avatar" referrerpolicy="no-referrer" />}
							<span class="member-name">{loggedInMember}</span>
						</a>
						<form action={`/api/auth/logout?returnToUrl=${encodeURIComponent(currentPath)}`} method="POST" style="display:inline">
							<button type="submit" class="auth-link">Logout</button>
						</form>
					</>
				) : (
					<a href={`/api/auth/login?returnToUrl=${encodeURIComponent(currentPath)}`} class="auth-link">Login</a>
				)}
			</div>
		</div>
	</div>
</nav>

<script>
	const toggle = document.querySelector('.nav-toggle');
	const links = document.querySelector('.nav-links');
	toggle?.addEventListener('click', () => {
		links?.classList.toggle('nav-links-open');
		toggle.classList.toggle('nav-toggle-active');
	});
</script>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(10, 10, 10, 0.95);
		border-bottom: 1px solid #222;
		backdrop-filter: blur(10px);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 60px;
	}

	.nav-logo {
		font-family: var(--font-title);
		font-size: 1.2rem;
		color: var(--accent);
		letter-spacing: 2px;
		text-shadow: 0 0 15px var(--accent-glow);
		flex-shrink: 0;
	}

	.nav-logo:hover {
		color: var(--accent-yellow);
	}

	.nav-toggle {
		display: none;
		flex-direction: column;
		gap: 5px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 4px;
	}

	.nav-toggle-bar {
		display: block;
		width: 24px;
		height: 2px;
		background: var(--text-secondary);
		border-radius: 2px;
		transition: all 0.3s;
	}

	.nav-toggle-active .nav-toggle-bar:nth-child(1) {
		transform: rotate(45deg) translate(5px, 5px);
	}
	.nav-toggle-active .nav-toggle-bar:nth-child(2) {
		opacity: 0;
	}
	.nav-toggle-active .nav-toggle-bar:nth-child(3) {
		transform: rotate(-45deg) translate(5px, -5px);
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 4px;
	}

	.nav-link {
		padding: 8px 16px;
		border-radius: 8px;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--text-secondary);
		transition: all 0.2s;
		font-family: var(--font-heading);
		letter-spacing: 1px;
	}

	.nav-link:hover {
		color: var(--accent);
		background: rgba(255, 102, 0, 0.1);
	}

	.nav-link.active {
		color: #000;
		background: var(--accent);
	}

	.member-link {
		display: flex;
		align-items: center;
		gap: 8px;
		text-decoration: none;
		transition: opacity 0.2s;
	}

	.member-link:hover {
		opacity: 0.8;
	}

	.member-avatar {
		width: 28px;
		height: 28px;
		border-radius: 50%;
		object-fit: cover;
		border: 2px solid var(--accent);
	}

	.auth-section {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-left: 8px;
		padding-left: 12px;
		border-left: 1px solid #333;
	}

	.member-name {
		font-family: var(--font-heading);
		font-size: 0.85rem;
		color: var(--accent-yellow);
		letter-spacing: 1px;
	}

	.auth-link {
		padding: 8px 16px;
		border-radius: 8px;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--text-secondary);
		transition: all 0.2s;
		font-family: var(--font-heading);
		letter-spacing: 1px;
		background: none;
		border: none;
		cursor: pointer;
		text-decoration: none;
	}

	.auth-link:hover {
		color: var(--accent);
		background: rgba(255, 102, 0, 0.1);
	}

	@media (max-width: 960px) {
		.nav-toggle {
			display: flex;
		}

		.nav-links {
			display: none;
			position: absolute;
			top: 60px;
			left: 0;
			right: 0;
			background: rgba(10, 10, 10, 0.98);
			flex-direction: column;
			padding: 12px 20px 20px;
			gap: 2px;
			border-bottom: 1px solid #222;
		}

		.nav-links-open {
			display: flex;
		}

		.nav-link {
			width: 100%;
			padding: 12px 16px;
		}

		.auth-section {
			margin-left: 0;
			padding-left: 0;
			border-left: none;
			padding-top: 12px;
			margin-top: 8px;
			border-top: 1px solid #333;
			width: 100%;
			justify-content: center;
		}
	}
</style>
