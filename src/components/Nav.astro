---
import { members } from '@wix/members';
import { i18n } from '@wix/essentials';
import { getRelativeLocaleUrl } from 'wix:astro:i18n';
import LanguageSwitcher from './LanguageSwitcher';

const currentPath = Astro.url.pathname;
const t = i18n.getTranslationFunction();

let loggedInMember: string | null = null;
let memberPhoto: string | null = null;
try {
	const res = await members.getCurrentMember({ fieldsets: ['FULL'] });
	if (res.member) {
		loggedInMember = res.member.profile?.nickname || res.member.contact?.firstName || 'Member';
		memberPhoto = res.member.profile?.photo?.url || null;
	}
} catch {}

const exploreLinks = [
	{ href: getRelativeLocaleUrl('/aboard'), path: '/aboard', label: t('nav.aboard') },
	{ href: getRelativeLocaleUrl('/planets'), path: '/planets', label: t('nav.planets') },
	{ href: getRelativeLocaleUrl('/crew'), path: '/crew', label: t('nav.crew') },
	{ href: getRelativeLocaleUrl('/missions'), path: '/missions', label: t('nav.missions') },
];

const isPathActive = (path: string) => currentPath === path || currentPath.startsWith(path + '/');

const isRestaurantOrder = isPathActive('/restaurant/order');
const isRestaurantReserve = isPathActive('/restaurant/reserve');
const isRestaurantThankYou = isPathActive('/restaurant/thank-you');
const isRestaurantMenuActive = (currentPath === '/restaurant' || currentPath.startsWith('/restaurant/'))
	&& !isRestaurantOrder && !isRestaurantReserve && !isRestaurantThankYou;

type NavItem =
	| { kind: 'link'; href: string; path: string; label: string }
	| { kind: 'group'; label: string; href?: string; active: boolean; children: { href: string; label: string; active: boolean }[] };

const facilitiesItems: NavItem[] = [
	{ kind: 'link', href: getRelativeLocaleUrl('/store'), path: '/store', label: t('nav.store') },
	{ kind: 'link', href: getRelativeLocaleUrl('/bookings'), path: '/bookings', label: t('nav.bookings') },
	{
		kind: 'group',
		label: t('nav.restaurant'),
		href: getRelativeLocaleUrl('/restaurant'),
		active: isRestaurantMenuActive || isRestaurantReserve || isRestaurantOrder,
		children: [
			{ href: getRelativeLocaleUrl('/restaurant'), label: t('restaurant.menu'), active: isRestaurantMenuActive },
			{ href: getRelativeLocaleUrl('/restaurant/reserve'), label: t('restaurant.reserve'), active: isRestaurantReserve },
			{ href: getRelativeLocaleUrl('/restaurant/order'), label: t('restaurant.order'), active: isRestaurantOrder },
		],
	},
	{ kind: 'link', href: getRelativeLocaleUrl('/cinema'), path: '/cinema', label: t('nav.cinema') },
];

const isExploreActive = exploreLinks.some(l => isPathActive(l.path));
const isFacilitiesActive = facilitiesItems.some(item =>
	item.kind === 'link' ? isPathActive(item.path) : item.active
);
---

<nav class="nav">
	<div class="nav-inner container">
		<a href={getRelativeLocaleUrl('/')} class="nav-logo">{t('home.title')}</a>
		<button class="nav-toggle" aria-label="Toggle menu">
			<span class="nav-toggle-bar"></span>
			<span class="nav-toggle-bar"></span>
			<span class="nav-toggle-bar"></span>
		</button>
		<div class="nav-links">
			<a
				href={getRelativeLocaleUrl('/')}
				class:list={['nav-link', { active: currentPath === '/' }]}
			>
				{t('nav.home')}
			</a>
			<div class="nav-dropdown">
				<button class:list={['nav-link nav-dropdown-trigger', { active: isExploreActive }]} type="button">
					{t('nav.explore')} <span class="nav-caret">&#9662;</span>
				</button>
				<div class="nav-dropdown-menu">
					<div class="nav-dropdown-menu-inner">
						{exploreLinks.map(link => (
							<a
								href={link.href}
								class:list={['dropdown-item', { active: isPathActive(link.path) }]}
							>
								{link.label}
							</a>
						))}
					</div>
				</div>
			</div>
			<div class="nav-dropdown">
				<button class:list={['nav-link nav-dropdown-trigger', { active: isFacilitiesActive }]} type="button">
					{t('nav.facilities')} <span class="nav-caret">&#9662;</span>
				</button>
				<div class="nav-dropdown-menu">
					<div class="nav-dropdown-menu-inner">
						{facilitiesItems.map(item => (
							item.kind === 'link' ? (
								<a
									href={item.href}
									class:list={['dropdown-item', { active: isPathActive(item.path) }]}
								>
									{item.label}
								</a>
							) : (
								<div class="nav-subdropdown">
									{item.href ? (
										<a href={item.href} class:list={['dropdown-item dropdown-subtrigger', { active: item.active }]}>
											<span>{item.label}</span>
											<span class="submenu-caret" aria-hidden="true"></span>
										</a>
									) : (
										<button class:list={['dropdown-item dropdown-subtrigger', { active: item.active }]} type="button">
											<span>{item.label}</span>
											<span class="submenu-caret" aria-hidden="true"></span>
										</button>
									)}
									<div class="nav-subdropdown-menu">
										<div class="nav-subdropdown-menu-inner">
											{item.children.map(child => (
												<a
													href={child.href}
													class:list={['dropdown-item', { active: child.active }]}
												>
													{child.label}
												</a>
											))}
										</div>
									</div>
								</div>
							)
						))}
					</div>
				</div>
			</div>
			<a
				href={getRelativeLocaleUrl('/blog')}
				class:list={['nav-link', { active: isPathActive('/blog') }]}
			>
				{t('nav.blog')}
			</a>
			<a
				href={getRelativeLocaleUrl('/research')}
				class:list={['nav-link', { active: isPathActive('/research') }]}
			>
				{t('nav.research')}
			</a>
			<a
				href={getRelativeLocaleUrl('/plans')}
				class:list={['nav-link', { active: isPathActive('/plans') }]}
			>
				{t('nav.plans')}
			</a>
			<div class="auth-section">
				{loggedInMember ? (
					<div class="member-menu">
						<button class="member-link" type="button">
							{memberPhoto && <img src={memberPhoto} alt={loggedInMember} class="member-avatar" referrerpolicy="no-referrer" />}
							<span class="member-name">{loggedInMember}</span>
							<span class="member-caret">&#9662;</span>
						</button>
						<div class="member-dropdown">
							<a href={getRelativeLocaleUrl('/member')} class="dropdown-item">{t('nav.myProfile')}</a>
							<LanguageSwitcher variant="dropdown" client:only="react" />
							<form action={`/api/auth/logout?returnToUrl=${encodeURIComponent(currentPath)}`} method="POST">
								<button type="submit" class="dropdown-item dropdown-logout">{t('nav.logout')}</button>
							</form>
						</div>
						</div>
				) : (
					<>
						<LanguageSwitcher variant="standalone" client:only="react" />
						<a href={`/api/auth/login?returnToUrl=${encodeURIComponent(currentPath)}`} class="auth-link">{t('nav.login')}</a>
					</>
				)}
			</div>
		</div>
	</div>
</nav>

<script>
	const toggle = document.querySelector('.nav-toggle');
	const links = document.querySelector('.nav-links');
	toggle?.addEventListener('click', () => {
		links?.classList.toggle('nav-links-open');
		toggle.classList.toggle('nav-toggle-active');
	});

	const menuBtn = document.querySelector('.member-menu .member-link');
	const dropdown = document.querySelector('.member-dropdown');
	menuBtn?.addEventListener('click', (e) => {
		e.stopPropagation();
		dropdown?.classList.toggle('member-dropdown-open');
	});

	const navDropdowns = document.querySelectorAll('.nav-dropdown');
	const closeAllNavMenus = () => {
		navDropdowns.forEach(d => d.querySelector('.nav-dropdown-menu')?.classList.remove('nav-dropdown-open'));
		document.querySelectorAll('.nav-subdropdown-menu').forEach(m => m.classList.remove('nav-subdropdown-open'));
	};
	navDropdowns.forEach(d => {
		const menu = d.querySelector('.nav-dropdown-menu');
		let closeTimer: ReturnType<typeof setTimeout>;
		d.addEventListener('mouseenter', () => { clearTimeout(closeTimer); closeAllNavMenus(); menu?.classList.add('nav-dropdown-open'); });
		d.addEventListener('mouseleave', () => { closeTimer = setTimeout(() => menu?.classList.remove('nav-dropdown-open'), 150); });
		d.querySelector('.nav-dropdown-trigger')?.addEventListener('click', (e) => {
			e.stopPropagation();
			const wasOpen = menu?.classList.contains('nav-dropdown-open');
			closeAllNavMenus();
			if (!wasOpen) menu?.classList.add('nav-dropdown-open');
		});
	});

	document.querySelectorAll('.nav-subdropdown').forEach(s => {
		const submenu = s.querySelector('.nav-subdropdown-menu');
		let subCloseTimer: ReturnType<typeof setTimeout>;
		s.addEventListener('mouseenter', () => { clearTimeout(subCloseTimer); submenu?.classList.add('nav-subdropdown-open'); });
		s.addEventListener('mouseleave', () => { subCloseTimer = setTimeout(() => submenu?.classList.remove('nav-subdropdown-open'), 150); });
		const subtrigger = s.querySelector('.dropdown-subtrigger');
		// Anchor subtriggers should navigate on click — don't hijack with a toggle.
		// Only <button> subtriggers get the open/close behaviour.
		if (subtrigger instanceof HTMLButtonElement) {
			subtrigger.addEventListener('click', (e) => {
				e.stopPropagation();
				submenu?.classList.toggle('nav-subdropdown-open');
			});
		}
	});

	document.addEventListener('click', () => {
		dropdown?.classList.remove('member-dropdown-open');
		closeAllNavMenus();
	});
</script>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(10, 10, 10, 0.95);
		border-bottom: 1px solid #222;
		backdrop-filter: blur(10px);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 60px;
	}

	.nav-logo {
		font-family: var(--font-title);
		font-size: 1.2rem;
		color: var(--accent);
		letter-spacing: 2px;
		text-shadow: 0 0 15px var(--accent-glow);
		flex-shrink: 0;
	}

	.nav-logo:hover {
		color: var(--accent-yellow);
	}

	.nav-toggle {
		display: none;
		flex-direction: column;
		gap: 5px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 4px;
	}

	.nav-toggle-bar {
		display: block;
		width: 24px;
		height: 2px;
		background: var(--text-secondary);
		border-radius: 2px;
		transition: all 0.3s;
	}

	.nav-toggle-active .nav-toggle-bar:nth-child(1) {
		transform: rotate(45deg) translate(5px, 5px);
	}
	.nav-toggle-active .nav-toggle-bar:nth-child(2) {
		opacity: 0;
	}
	.nav-toggle-active .nav-toggle-bar:nth-child(3) {
		transform: rotate(-45deg) translate(5px, -5px);
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 4px;
	}

	.nav-link {
		padding: 8px 16px;
		border-radius: 8px;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--text-secondary);
		transition: all 0.2s;
		font-family: var(--font-heading);
		letter-spacing: 1px;
	}

	.nav-link:hover {
		color: var(--accent);
		background: rgba(255, 102, 0, 0.1);
	}

	.nav-link.active {
		color: #000;
		background: var(--accent);
	}

	.nav-dropdown {
		position: relative;
	}

	.nav-dropdown-trigger {
		background: none;
		border: none;
		cursor: pointer;
		display: flex;
		align-items: center;
		gap: 4px;
	}

	.nav-caret {
		font-size: 0.5rem;
		color: var(--text-muted);
		transition: transform 0.2s;
	}

	.nav-dropdown-menu {
		display: none;
		position: absolute;
		top: 100%;
		left: 50%;
		transform: translateX(-50%);
		padding-top: 8px;
		min-width: 160px;
		z-index: 200;
	}

	.nav-dropdown-menu-inner {
		background: rgba(20, 20, 20, 0.98);
		border: 1px solid #333;
		border-radius: 8px;
		padding: 6px 0;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
	}

	.nav-dropdown-open {
		display: block;
	}

	.nav-dropdown-menu .dropdown-item.active {
		color: var(--accent);
	}

	.nav-subdropdown {
		position: relative;
	}

	.dropdown-subtrigger {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		gap: 8px;
		background: none;
		border: none;
		font-family: var(--font-heading);
		cursor: pointer;
	}

	.dropdown-subtrigger .submenu-caret {
		font-size: 0.6rem;
		color: var(--text-muted);
	}

	.dropdown-subtrigger .submenu-caret::before {
		content: "\25B8"; /* ▸ right-pointing small triangle */
	}

	:global(html[dir="rtl"]) .dropdown-subtrigger .submenu-caret::before {
		content: "\25C2"; /* ◂ left-pointing small triangle */
	}

	.nav-subdropdown-menu {
		display: none;
		position: absolute;
		top: -6px;
		inset-inline-start: 100%;
		padding-inline-start: 4px;
		min-width: 180px;
		z-index: 210;
	}

	.nav-subdropdown-menu-inner {
		background: rgba(20, 20, 20, 0.98);
		border: 1px solid #333;
		border-radius: 8px;
		padding: 6px 0;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
	}

	.nav-subdropdown-open {
		display: block;
	}

	.member-menu {
		position: relative;
	}

	.member-link {
		display: flex;
		align-items: center;
		gap: 8px;
		text-decoration: none;
		transition: opacity 0.2s;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0;
	}

	.member-link:hover {
		opacity: 0.8;
	}

	.member-caret {
		font-size: 0.6rem;
		color: var(--text-muted);
		transition: transform 0.2s;
	}

	.member-dropdown {
		display: none;
		position: absolute;
		top: calc(100% + 8px);
		inset-inline-end: 0;
		background: rgba(20, 20, 20, 0.98);
		border: 1px solid #333;
		border-radius: 8px;
		min-width: 160px;
		padding: 6px 0;
		z-index: 200;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
	}

	.member-dropdown-open {
		display: block;
	}

	.dropdown-item {
		display: block;
		width: 100%;
		padding: 10px 16px;
		font-size: 0.85rem;
		font-family: var(--font-heading);
		letter-spacing: 1px;
		color: var(--text-secondary);
		text-decoration: none;
		background: none;
		border: none;
		cursor: pointer;
		text-align: start;
		transition: all 0.15s;
		box-sizing: border-box;
	}

	.dropdown-item:hover {
		color: var(--accent);
		background: rgba(255, 102, 0, 0.08);
	}

	.dropdown-logout {
		color: var(--text-muted);
		border-top: 1px solid #222;
		margin-top: 2px;
		padding-top: 10px;
	}

	.dropdown-logout:hover {
		color: #f44336;
		background: rgba(244, 67, 54, 0.08);
	}

	.member-avatar {
		width: 28px;
		height: 28px;
		border-radius: 50%;
		object-fit: cover;
		border: 2px solid var(--accent);
	}

	.auth-section {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-inline-start: 8px;
		padding-inline-start: 12px;
		border-inline-start: 1px solid #333;
	}

	.member-name {
		font-family: var(--font-heading);
		font-size: 0.85rem;
		color: var(--accent-yellow);
		letter-spacing: 1px;
	}

	.auth-link {
		padding: 8px 16px;
		border-radius: 8px;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--text-secondary);
		transition: all 0.2s;
		font-family: var(--font-heading);
		letter-spacing: 1px;
		background: none;
		border: none;
		cursor: pointer;
		text-decoration: none;
	}

	.auth-link:hover {
		color: var(--accent);
		background: rgba(255, 102, 0, 0.1);
	}


	@media (max-width: 960px) {
		.nav-toggle {
			display: flex;
		}

		.nav-links {
			display: none;
			position: absolute;
			top: 60px;
			left: 0;
			right: 0;
			background: rgba(10, 10, 10, 0.98);
			flex-direction: column;
			align-items: stretch;
			padding: 12px 12px 20px;
			gap: 2px;
			border-bottom: 1px solid #222;
		}

		.nav-links-open {
			display: flex;
		}

		.nav-link {
			width: 100%;
			padding: 12px 16px;
			text-align: start;
			border-radius: 6px;
		}

		.nav-link.active {
			background: rgba(255, 102, 0, 0.1);
			color: var(--accent);
			border-inline-start: 3px solid var(--accent);
			padding-inline-start: 13px;
		}

		.nav-dropdown {
			width: 100%;
		}

		.nav-dropdown-trigger {
			width: 100%;
			justify-content: space-between;
			cursor: default;
		}

		.nav-dropdown-trigger.active {
			background: transparent;
			color: var(--text-secondary);
			border-inline-start: none;
			padding-inline-start: 16px;
		}

		.nav-caret {
			display: none;
		}

		.nav-dropdown-menu {
			display: block;
			position: static;
			transform: none;
			padding-top: 0;
			min-width: 0;
		}

		.nav-dropdown-menu-inner {
			background: transparent;
			border: none;
			padding: 0;
			box-shadow: none;
		}

		.nav-dropdown-menu .dropdown-item {
			padding: 10px 16px 10px 32px;
			font-size: 0.8rem;
		}

		.nav-dropdown-menu .dropdown-item.active {
			color: var(--accent);
			background: rgba(255, 102, 0, 0.08);
		}

		.nav-subdropdown-menu {
			display: block;
			position: static;
			padding-inline-start: 0;
			min-width: 0;
		}

		.nav-subdropdown-menu-inner {
			background: transparent;
			border: none;
			padding: 0;
			box-shadow: none;
		}

		.nav-subdropdown-menu .dropdown-item {
			padding-inline-start: 48px;
		}

		.dropdown-subtrigger .submenu-caret {
			display: none;
		}

		.dropdown-subtrigger {
			cursor: default;
		}

		.auth-section {
			margin-inline-start: 0;
			padding-inline-start: 0;
			border-inline-start: none;
			padding-top: 12px;
			margin-top: 8px;
			border-top: 1px solid #333;
			width: 100%;
			justify-content: center;
		}

		.member-dropdown {
			inset-inline-end: auto;
			left: 50%;
			transform: translateX(-50%);
		}


		.lang-standalone-dropdown {
			left: auto;
			right: 0;
		}
	}
</style>
